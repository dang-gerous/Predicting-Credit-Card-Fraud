tasets/goodpjw2008/s6e11-compact-lm-seed7/lm7_oof_f0.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7/lm7_test_5fold.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7/lm7_test_f0.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7/megalm_oof_sha181c.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7/megalm_test_sha3168.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7/megalm_test_v_nov08.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-target-first-gpt2-seed-2026/README.md\n/kaggle/input/datasets/goodpjw2008/s6e11-target-first-gpt2-seed-2026/gpt2_s2026_oof_5fold.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-target-first-gpt2-seed-2026/gpt2_s2026_test_5fold.npy\n/kaggle/input/datasets/goodpjw2008/s6e11-target-first-gpt2-seed-2026/gpt2_s2026_test_f0.npy\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# Step 1: load the tables and look at what is inside\nSKIP_SUPERSEDED = True  # Skip 0-weight superseded early models to save >90 mins of GPU quota\n\nif \"train\" not in globals():\n    d = \"/kaggle/input/competitions/playground-series-s6e11/\"\n    train = pd.read_csv(d + \"train.csv\")\n    test = pd.read_csv(d + \"test.csv\")\n    print(\"rows, columns:\", train.shape, test.shape)\n    print(\"share of fraud rows:\", train[\"is_fraud\"].mean())\n\nimport shutil, glob\nfor _npz in [\"preds_backup.npz\", \"preds_opt2.npz\", \"preds_exp3.npz\", \"preds_exp4.npz\", \"preds_exp5.npz\", \"preds_exp6_meta.npz\", \"preds_exp7_glmboost.npz\", \"preds_exp9.npz\"]:\n    _p = \"/kaggle/working/\" + _npz\n    if not os.path.exists(_p):\n        _hits = sorted(glob.glob(f\"/kaggle/input/**/{_npz}\", recursive=True))\n        if _hits:\n            shutil.copy2(_hits[0], _p)\n            print(f\"Copied {_npz} from {_hits[0]} to /kaggle/working/\")\n    if os.path.exists(_p):\n        _b = np.load(_p)\n        for _k in _b.files:\n            if _k not in globals():\n                globals()[_k] = _b[_k].astype(np.float64)\n        print(\"Restored cache:\", _npz, len(_b.files))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:37:59.698695Z","iopub.execute_input":"2026-11-16T05:37:59.699391Z","iopub.status.idle":"2026-11-16T05:38:06.941697Z","shell.execute_reply.started":"2026-11-16T05:37:59.699368Z","shell.execute_reply":"2026-11-16T05:38:06.940734Z"}},"outputs":[{"name":"stdout","text":"rows, columns: (699960, 26) (299984, 25)\nshare of fraud rows: 0.016699525687182123\nCopied preds_opt2.npz from /kaggle/input/notebooks/phankhnhng/notebook2d1e76465a/preds_opt2.npz to /kaggle/working/\nRestored cache: preds_opt2.npz 4\nCopied preds_exp3.npz from /kaggle/input/notebooks/phankhnhng/notebook2d1e76465a/preds_exp3.npz to /kaggle/working/\nRestored cache: preds_exp3.npz 8\nCopied preds_exp4.npz from /kaggle/input/notebooks/phankhnhng/notebook2d1e76465a/preds_exp4.npz to /kaggle/working/\nRestored cache: preds_exp4.npz 4\nCopied preds_exp5.npz from /kaggle/input/notebooks/phankhnhng/notebook2d1e76465a/preds_exp5.npz to /kaggle/working/\nRestored cache: preds_exp5.npz 6\nCopied preds_exp7_glmboost.npz from /kaggle/input/notebooks/phankhnhng/notebook2d1e76465a/preds_exp7_glmboost.npz to /kaggle/working/\nRestored cache: preds_exp7_glmboost.npz 40\nCopied preds_exp9.npz from /kaggle/input/datasets/phankhnhng/s6e11-exp9-cache/preds_exp9.npz to /kaggle/working/\nRestored cache: preds_exp9.npz 16\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# Step 2: Feature Engineering + 5-fold LightGBM\nimport lightgbm as lgb\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.metrics import roc_auc_score\n\ndef make_features(df):\n    out = df.copy()\n    out[\"amount_to_balance\"] = out[\"amount_usd\"] / (out[\"account_balance_usd\"] + 1.0)\n    out[\"balance_after_txn\"] = out[\"account_balance_usd\"] - out[\"amount_usd\"]\n    out[\"txn_burst_rate\"] = out[\"txn_count_last_24h\"] / (out[\"hours_since_last_txn\"] + 0.1)\n    flag_cols = [\n        \"is_foreign_transaction\", \"is_new_merchant\", \"used_vpn\",\n        \"ip_country_mismatch\", \"billing_shipping_mismatch\", \"is_ai_generated_scam_attempt\"\n    ]\n    out[\"risk_flag_count\"] = out[flag_cols].sum(axis=1)\n    out[\"amount_x_merchant_risk\"] = out[\"amount_usd\"] * out[\"merchant_risk_score\"]\n    return out\n\ntrain_fe = make_features(train)\ntest_fe = make_features(test)\n\ntext_cols = [\"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"]\nfor c in text_cols:\n    train_fe[c] = train_fe[c].astype(\"category\")\n    test_fe[c] = pd.Categorical(test_fe[c], categories=train_fe[c].cat.categories)\n\nX = train_fe.drop(columns=[\"id\", \"is_fraud\"])\ny = train_fe[\"is_fraud\"]\nX_test = test_fe.drop(columns=[\"id\"])\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=0)\n\nif \"oof_preds\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    oof_preds = np.zeros(len(train_fe))\n    test_preds = np.zeros(len(test_fe))\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y)):\n        X_tr, y_tr = X.iloc[tr_idx], y.iloc[tr_idx]\n        X_va, y_va = X.iloc[va_idx], y.iloc[va_idx]\n        model = lgb.LGBMClassifier(\n            n_estimators=2000, learning_rate=0.03, num_leaves=31,\n            min_child_samples=100, subsample=0.8, subsample_freq=1,\n            colsample_bytree=0.8, random_state=fold, verbose=-1, n_jobs=-1,\n        )\n        model.fit(\n            X_tr, y_tr,\n            eval_set=[(X_va, y_va)], eval_metric=\"auc\",\n            callbacks=[lgb.early_stopping(50, verbose=False)],\n        )\n        oof_preds[va_idx] = model.predict_proba(X_va)[:, 1]\n        test_preds += model.predict_proba(X_test)[:, 1] / 5\n\nif \"oof_preds\" not in globals():\n    oof_preds = np.zeros(len(train_fe))\n    test_preds = np.zeros(len(test_fe))\nlgb_oof = oof_preds.copy()\nlgb_test = test_preds.copy()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:06.942743Z","iopub.execute_input":"2026-11-16T05:38:06.943059Z","iopub.status.idle":"2026-11-16T05:38:15.114884Z","shell.execute_reply.started":"2026-11-16T05:38:06.943037Z","shell.execute_reply":"2026-11-16T05:38:15.114199Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# Step 3: 5-fold XGBoost\nimport xgboost as xgb\n\nif \"xgb_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    xgb_oof = np.zeros(len(train_fe))\n    xgb_test = np.zeros(len(test_fe))\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y)):\n        X_tr, y_tr = X.iloc[tr_idx], y.iloc[tr_idx]\n        X_va, y_va = X.iloc[va_idx], y.iloc[va_idx]\n\n        xgb_model = xgb.XGBClassifier(\n            n_estimators=2000,\n            learning_rate=0.03,\n            max_depth=6,\n            min_child_weight=100,\n            subsample=0.8,\n            colsample_bytree=0.8,\n            tree_method=\"hist\",\n            device=\"cuda\",\n            enable_categorical=True,\n            eval_metric=\"auc\",\n            early_stopping_rounds=50,\n            random_state=fold,\n            n_jobs=-1,\n        )\n        xgb_model.fit(\n            X_tr, y_tr,\n            eval_set=[(X_va, y_va)],\n            verbose=False,\n        )\n\n        xgb_oof[va_idx] = xgb_model.predict_proba(X_va)[:, 1]\n        xgb_test += xgb_model.predict_proba(X_test)[:, 1] / 5\n\nif \"xgb_oof\" not in globals():\n    xgb_oof = np.zeros(len(train_fe))\n    xgb_test = np.zeros(len(test_fe))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:15.115848Z","iopub.execute_input":"2026-11-16T05:38:15.116516Z","iopub.status.idle":"2026-11-16T05:38:15.32608Z","shell.execute_reply.started":"2026-11-16T05:38:15.116492Z","shell.execute_reply":"2026-11-16T05:38:15.325432Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"# Step 4: 5-fold CatBoost + 3-Model Blend (LightGBM + XGBoost + CatBoost)\nfrom catboost import CatBoostClassifier\n\nif \"cb_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    X_cb = X.copy()\n    X_test_cb = X_test.copy()\n    for c in text_cols:\n        X_cb[c] = X_cb[c].cat.codes\n        X_test_cb[c] = X_test_cb[c].cat.codes\n\n    cb_oof = np.zeros(len(train_fe))\n    cb_test = np.zeros(len(test_fe))\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_cb, y)):\n        X_tr, y_tr = X_cb.iloc[tr_idx], y.iloc[tr_idx]\n        X_va, y_va = X_cb.iloc[va_idx], y.iloc[va_idx]\n\n        cb_model = CatBoostClassifier(\n            iterations=1500,\n            learning_rate=0.06,\n            depth=6,\n            cat_features=text_cols,\n            one_hot_max_size=25,\n            eval_metric=\"AUC\",\n            random_seed=fold,\n            task_type=\"GPU\",\n            verbose=False,\n        )\n        cb_model.fit(\n            X_tr, y_tr,\n            eval_set=(X_va, y_va),\n            early_stopping_rounds=50,\n            verbose=False,\n        )\n\n        cb_oof[va_idx] = cb_model.predict_proba(X_va)[:, 1]\n        cb_test += cb_model.predict_proba(X_test_cb)[:, 1] / 5\n\nif \"cb_oof\" not in globals():\n    cb_oof = np.zeros(len(train_fe))\n    cb_test = np.zeros(len(test_fe))\nblend3_oof = np.zeros(len(train_fe))\nblend3_test = np.zeros(len(test_fe))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:15.327892Z","iopub.execute_input":"2026-11-16T05:38:15.328092Z","iopub.status.idle":"2026-11-16T05:38:16.273288Z","shell.execute_reply.started":"2026-11-16T05:38:15.328074Z","shell.execute_reply":"2026-11-16T05:38:16.27268Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"# Step 5: Test 12 Non-Leaky Group Aggregation Z-Scores on 5-fold LightGBM\nif \"lgb_grp_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    def add_group_aggregations(tr_df, te_df):\n        full = pd.concat([tr_df.drop(columns=[\"is_fraud\"]), te_df], ignore_index=True)\n        for grp in [\"merchant_category\", \"channel\", \"auth_method\"]:\n            for num in [\"amount_usd\", \"velocity_score\", \"merchant_risk_score\", \"distance_from_home_km\"]:\n                means = full.groupby(grp, observed=False)[num].transform(\"mean\")\n                stds = full.groupby(grp, observed=False)[num].transform(\"std\") + 1e-5\n                full[f\"{num}_z_{grp}\"] = ((full[num] - means) / stds).astype(np.float32)\n        tr_out = full.iloc[:len(tr_df)].drop(columns=[\"id\"]).copy()\n        te_out = full.iloc[len(tr_df):].drop(columns=[\"id\"]).copy().reset_index(drop=True)\n        return tr_out, te_out\n    \n    X_grp, X_test_grp = add_group_aggregations(train_fe, test_fe)\n    for c in text_cols:\n        X_grp[c] = X_grp[c].astype(\"category\")\n        X_test_grp[c] = pd.Categorical(X_test_grp[c], categories=X_grp[c].cat.categories)\n    \n    lgb_grp_oof = np.zeros(len(train_fe))\n    lgb_grp_test = np.zeros(len(test_fe))\n    grp_imp = np.zeros(X_grp.shape[1])\n    \n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_grp, y)):\n        X_tr, y_tr = X_grp.iloc[tr_idx], y.iloc[tr_idx]\n        X_va, y_va = X_grp.iloc[va_idx], y.iloc[va_idx]\n    \n        model = lgb.LGBMClassifier(\n            n_estimators=2000, learning_rate=0.03, num_leaves=31,\n            min_child_samples=100, subsample=0.8, subsample_freq=1,\n            colsample_bytree=0.8, random_state=fold, verbose=-1, n_jobs=-1,\n        )\n        model.fit(\n            X_tr, y_tr,\n            eval_set=[(X_va, y_va)], eval_metric=\"auc\",\n            callbacks=[lgb.early_stopping(50, verbose=False)],\n        )\n        lgb_grp_oof[va_idx] = model.predict_proba(X_va)[:, 1]\n        lgb_grp_test += model.predict_proba(X_test_grp)[:, 1] / 5\n        grp_imp += model.feature_importances_ / 5\n        print(f\"LGB+GroupAgg Fold {fold} AUC: {roc_auc_score(y_va, lgb_grp_oof[va_idx]):.5f} (tree {model.best_iteration_})\")\n    \n    grp_auc = roc_auc_score(y, lgb_grp_oof)\n    print(f\"\\nLightGBM baseline OOF AUC:    {roc_auc_score(y, lgb_oof):.5f}\")\n    print(f\"LightGBM + GroupAgg OOF AUC:  {grp_auc:.5f} (diff: {grp_auc - roc_auc_score(y, lgb_oof):+.5f})\")\n    \n    best_w, best_auc = 0.0, roc_auc_score(y, blend3_oof)\n    for w in [0.0, 0.2, 0.4, 0.5, 0.6, 0.8, 1.0]:\n        cand = w * lgb_grp_oof + (1 - w) * blend3_oof\n        cand_auc = roc_auc_score(y, cand)\n        print(f\"Blend ({w:.1f} LGB_Grp + {1-w:.1f} Prev_3Way): {cand_auc:.5f}\")\n        if cand_auc > best_auc:\n            best_auc, best_w = cand_auc, w\n    \n    final_test = best_w * lgb_grp_test + (1 - best_w) * blend3_test\n    print(\"\\nTop 12 features:\")\n    print(pd.Series(grp_imp, index=X_grp.columns).sort_values(ascending=False).head(12).round(1))\nif \"lgb_grp_oof\" not in globals():\n    lgb_grp_oof = np.zeros(len(train_fe))\n    lgb_grp_test = np.zeros(len(test_fe))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:16.274279Z","iopub.execute_input":"2026-11-16T05:38:16.274902Z","iopub.status.idle":"2026-11-16T05:38:16.287922Z","shell.execute_reply.started":"2026-11-16T05:38:16.274877Z","shell.execute_reply":"2026-11-16T05:38:16.286987Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"# Step 6: Digit-Level Features + Shallow Trees (num_leaves=4, max_depth=2)\ndef add_digit_features(df):\n    out = df.copy()\n    float_cols = [\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"velocity_score\", \"merchant_risk_score\"\n    ]\n    for col in float_cols:\n        v = out[col].fillna(0).abs()\n        int_v = np.floor(v).astype(np.int64)\n        cents = np.round((v - int_v) * 100).astype(np.int32)\n        out[f\"{col}_cents\"] = cents\n        out[f\"{col}_tenth\"] = (cents // 10).astype(np.int32)\n        out[f\"{col}_hundredth\"] = (cents % 10).astype(np.int32)\n        out[f\"{col}_ones\"] = (int_v % 10).astype(np.int32)\n        out[f\"{col}_tens\"] = ((int_v // 10) % 10).astype(np.int32)\n        out[f\"{col}_log1p\"] = np.log1p(v).astype(np.float32)\n    return out\n\nX_dig = add_digit_features(train_fe.drop(columns=[\"id\", \"is_fraud\"]))\nX_test_dig = add_digit_features(test_fe.drop(columns=[\"id\"]))\n\nfor c in text_cols:\n    X_dig[c] = X_dig[c].astype(\"category\")\n    X_test_dig[c] = pd.Categorical(X_test_dig[c], categories=X_dig[c].cat.categories)\n\nif \"lgb_shallow_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    lgb_shallow_oof = np.zeros(len(train_fe))\n    lgb_shallow_test = np.zeros(len(test_fe))\n    sh_imp = np.zeros(X_dig.shape[1])\n    \n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig, y)):\n        X_tr, y_tr = X_dig.iloc[tr_idx], y.iloc[tr_idx]\n        X_va, y_va = X_dig.iloc[va_idx], y.iloc[va_idx]\n    \n        model = lgb.LGBMClassifier(\n            n_estimators=5000,\n            learning_rate=0.05,\n            num_leaves=4,\n            max_depth=2,\n            min_child_samples=100,\n            subsample=0.8,\n            subsample_freq=1,\n            colsample_bytree=0.8,\n            random_state=fold,\n            verbose=-1,\n            n_jobs=-1,\n        )\n        model.fit(\n            X_tr, y_tr,\n            eval_set=[(X_va, y_va)],\n            eval_metric=\"auc\",\n            callbacks=[lgb.early_stopping(100, verbose=False)],\n        )\n        lgb_shallow_oof[va_idx] = model.predict_proba(X_va)[:, 1]\n        lgb_shallow_test += model.predict_proba(X_test_dig)[:, 1] / 5\n        sh_imp += model.feature_importances_ / 5\n        print(f\"Shallow+Digits Fold {fold} AUC: {roc_auc_score(y_va, lgb_shallow_oof[va_idx]):.5f} (tree {model.best_iteration_})\")\n    \n    sh_auc = roc_auc_score(y, lgb_shallow_oof)\n    print(f\"\\nPrevious Deep LightGBM (31 leaves):  {roc_auc_score(y, lgb_oof):.5f}\")\n    print(f\"Previous 4-Model Ensemble:           {roc_auc_score(y, 0.2 * lgb_grp_oof + 0.8 * blend3_oof):.5f}\")\n    print(f\"NEW Shallow LGB (4 leaves) + Digits: {sh_auc:.5f} (vs deep LGB: {sh_auc - roc_auc_score(y, lgb_oof):+.5f})\")\n    \n    prev_best_oof = 0.2 * lgb_grp_oof + 0.8 * blend3_oof\n    prev_best_test = 0.2 * lgb_grp_test + 0.8 * blend3_test\n    \n    best_w, best_auc = 0.0, roc_auc_score(y, prev_best_oof)\n    for w in [0.0, 0.2, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0]:\n        cand = w * lgb_shallow_oof + (1 - w) * prev_best_oof\n        cand_auc = roc_auc_score(y, cand)\n        print(f\"Blend ({w:.1f} Shallow_Digits + {1-w:.1f} Prev_Best): {cand_auc:.5f}\")\n        if cand_auc > best_auc:\n            best_auc, best_w = cand_auc, w\n    \n    print(f\"\\nNew Best Ensemble OOF AUC: {best_auc:.5f}\")\n    final_test = best_w * lgb_shallow_test + (1 - best_w) * prev_best_test\n    print(\"\\nTop 12 features in Shallow+Digits:\")\n    print(pd.Series(sh_imp, index=X_dig.columns).sort_values(ascending=False).head(12).round(1))\nif \"lgb_shallow_oof\" not in globals():\n    lgb_shallow_oof = np.zeros(len(train_fe))\n    lgb_shallow_test = np.zeros(len(test_fe))\n    print(\"[Skip] lgb_shallow_oof skipped (cached predictions loaded)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:16.288955Z","iopub.execute_input":"2026-11-16T05:38:16.289279Z","iopub.status.idle":"2026-11-16T05:38:16.921518Z","shell.execute_reply.started":"2026-11-16T05:38:16.289248Z","shell.execute_reply":"2026-11-16T05:38:16.920671Z"}},"outputs":[{"name":"stdout","text":"[Skip] lgb_shallow_oof skipped (cached predictions loaded)\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# Step 7: Nested Out-of-Fold Target Encoding on Digit & Category Keys + Shallow Trees\nte_keys = [\n    \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"distance_from_home_km_cents\",\n    \"account_balance_usd_cents\", \"velocity_score_cents\", \"merchant_risk_score_cents\",\n    \"amount_usd_ones\", \"amount_usd_tens\", \"hours_since_last_txn_ones\",\n    \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"\n]\n\nif \"lgb_nte_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    lgb_nte_oof = np.zeros(len(train_fe))\n    lgb_nte_test = np.zeros(len(test_fe))\n    inner_skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n    smooth = 20.0\n    \n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig, y)):\n        X_tr = X_dig.iloc[tr_idx].copy()\n        y_tr = y.iloc[tr_idx]\n        X_va = X_dig.iloc[va_idx].copy()\n        y_va = y.iloc[va_idx]\n        X_te = X_test_dig.copy()\n    \n        global_prior = y_tr.mean()\n        tr_te = pd.DataFrame(index=X_tr.index)\n        va_te = pd.DataFrame(index=X_va.index)\n        te_te = pd.DataFrame(index=X_te.index)\n    \n        for col in te_keys:\n            col_name = f\"nte_{col}\"\n            tr_vals = np.full(len(X_tr), global_prior, dtype=np.float32)\n    \n            # Nested inner folds: each row is encoded WITHOUT its own label!\n            s_tr = X_tr[col].astype(str)\n            for in_tr, in_va in inner_skf.split(X_tr, y_tr):\n                stats = y_tr.iloc[in_tr].groupby(s_tr.iloc[in_tr]).agg([\"count\", \"sum\"])\n                te_map = (stats[\"sum\"] + smooth * global_prior) / (stats[\"count\"] + smooth)\n                tr_vals[in_va] = s_tr.iloc[in_va].map(te_map).fillna(global_prior).values\n    \n            tr_te[col_name] = tr_vals\n    \n            # Outer val & test use all of (X_tr, y_tr)\n            stats_full = y_tr.groupby(s_tr).agg([\"count\", \"sum\"])\n            te_map_full = (stats_full[\"sum\"] + smooth * global_prior) / (stats_full[\"count\"] + smooth)\n            va_te[col_name] = X_va[col].astype(str).map(te_map_full).fillna(global_prior).astype(np.float32)\n            te_te[col_name] = X_te[col].astype(str).map(te_map_full).fillna(global_prior).astype(np.float32)\n    \n        X_tr_full = pd.concat([X_tr, tr_te], axis=1)\n        X_va_full = pd.concat([X_va, va_te], axis=1)\n        X_te_full = pd.concat([X_te, te_te], axis=1)\n    \n        model = lgb.LGBMClassifier(\n            n_estimators=5000,\n            learning_rate=0.04,\n            num_leaves=3,\n            max_depth=2,\n            min_child_samples=100,\n            subsample=0.8,\n            subsample_freq=1,\n            colsample_bytree=0.8,\n            random_state=fold,\n            verbose=-1,\n            n_jobs=-1,\n        )\n        model.fit(\n            X_tr_full, y_tr,\n            eval_set=[(X_va_full, y_va)],\n            eval_metric=\"auc\",\n            callbacks=[lgb.early_stopping(100, verbose=False)],\n        )\n        lgb_nte_oof[va_idx] = model.predict_proba(X_va_full)[:, 1]\n        lgb_nte_test += model.predict_proba(X_te_full)[:, 1] / 5\n        print(f\"Shallow+Digits+NestedTE Fold {fold} AUC: {roc_auc_score(y_va, lgb_nte_oof[va_idx]):.5f} (tree {model.best_iteration_})\")\n    \n    nte_auc = roc_auc_score(y, lgb_nte_oof)\n    print(f\"\\nShallow LGB + Digits alone:           {roc_auc_score(y, lgb_shallow_oof):.5f}\")\n    print(f\"NEW Shallow LGB + Digits + Nested TE: {nte_auc:.5f} (diff: {nte_auc - roc_auc_score(y, lgb_shallow_oof):+.5f})\")\n    \n    prev_best_oof = 0.8 * lgb_shallow_oof + 0.2 * (0.2 * lgb_grp_oof + 0.8 * blend3_oof)\n    prev_best_test = 0.8 * lgb_shallow_test + 0.2 * (0.2 * lgb_grp_test + 0.8 * blend3_test)\n    \n    best_w, best_auc = 0.0, roc_auc_score(y, prev_best_oof)\n    for w in [0.0, 0.2, 0.4, 0.5, 0.6, 0.7, 0.8, 1.0]:\n        cand = w * lgb_nte_oof + (1 - w) * prev_best_oof\n        cand_auc = roc_auc_score(y, cand)\n        print(f\"Blend ({w:.1f} NestedTE + {1-w:.1f} Prev_Best): {cand_auc:.5f}\")\n        if cand_auc > best_auc:\n            best_auc, best_w = cand_auc, w\n    \n    print(f\"\\nNew Best Ensemble OOF AUC: {best_auc:.5f}\")\n    final_test = best_w * lgb_nte_test + (1 - best_w) * prev_best_test\nif \"lgb_nte_oof\" not in globals():\n    lgb_nte_oof = np.zeros(len(train_fe))\n    lgb_nte_test = np.zeros(len(test_fe))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:16.922625Z","iopub.execute_input":"2026-11-16T05:38:16.923219Z","iopub.status.idle":"2026-11-16T05:38:16.938067Z","shell.execute_reply.started":"2026-11-16T05:38:16.92319Z","shell.execute_reply":"2026-11-16T05:38:16.937306Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"# Step 8: Shallow XGBoost (max_depth=2) & Shallow CatBoost (depth=3) on Digits + Nested TE\nfrom catboost import CatBoostClassifier\nimport xgboost as xgb\n\nte_keys = [\n    \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"distance_from_home_km_cents\",\n    \"account_balance_usd_cents\", \"velocity_score_cents\", \"merchant_risk_score_cents\",\n    \"amount_usd_ones\", \"amount_usd_tens\", \"hours_since_last_txn_ones\",\n    \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"\n]\ninner_skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nsmooth = 20.0\n\ndef get_fold_nte(tr_idx, va_idx):\n    X_tr = X_dig.iloc[tr_idx].copy()\n    y_tr = y.iloc[tr_idx]\n    X_va = X_dig.iloc[va_idx].copy()\n    X_te = X_test_dig.copy()\n    global_prior = y_tr.mean()\n    tr_te = pd.DataFrame(index=X_tr.index)\n    va_te = pd.DataFrame(index=X_va.index)\n    te_te = pd.DataFrame(index=X_te.index)\n    for col in te_keys:\n        col_name = f\"nte_{col}\"\n        tr_vals = np.full(len(X_tr), global_prior, dtype=np.float32)\n        s_tr = X_tr[col].astype(str)\n        for in_tr, in_va in inner_skf.split(X_tr, y_tr):\n            stats = y_tr.iloc[in_tr].groupby(s_tr.iloc[in_tr]).agg([\"count\", \"sum\"])\n            te_map = (stats[\"sum\"] + smooth * global_prior) / (stats[\"count\"] + smooth)\n            tr_vals[in_va] = s_tr.iloc[in_va].map(te_map).fillna(global_prior).values\n        tr_te[col_name] = tr_vals\n        stats_full = y_tr.groupby(s_tr).agg([\"count\", \"sum\"])\n        te_map_full = (stats_full[\"sum\"] + smooth * global_prior) / (stats_full[\"count\"] + smooth)\n        va_te[col_name] = X_va[col].astype(str).map(te_map_full).fillna(global_prior).astype(np.float32)\n        te_te[col_name] = X_te[col].astype(str).map(te_map_full).fillna(global_prior).astype(np.float32)\n    return (\n        pd.concat([X_tr, tr_te], axis=1),\n        pd.concat([X_va, va_te], axis=1),\n        pd.concat([X_te, te_te], axis=1),\n    )\n\nif \"xgb_sh_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    xgb_sh_oof = np.zeros(len(train_fe))\n    xgb_sh_test = np.zeros(len(test_fe))\n    cb_sh_oof = np.zeros(len(train_fe))\n    cb_sh_test = np.zeros(len(test_fe))\n    \n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig, y)):\n        X_tr_f, X_va_f, X_te_f = get_fold_nte(tr_idx, va_idx)\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n    \n        # 1. Shallow XGBoost (max_depth=2)\n        xm = xgb.XGBClassifier(\n            n_estimators=4000, learning_rate=0.05, max_depth=2,\n            min_child_weight=100, subsample=0.8, colsample_bytree=0.8,\n            tree_method=\"hist\", device=\"cuda\", enable_categorical=True,\n            eval_metric=\"auc\", early_stopping_rounds=100,\n            random_state=fold, n_jobs=-1,\n        )\n        xm.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], verbose=False)\n        xgb_sh_oof[va_idx] = xm.predict_proba(X_va_f)[:, 1]\n        xgb_sh_test += xm.predict_proba(X_te_f)[:, 1] / 5\n    \n        # 2. Shallow CatBoost (depth=3)\n        X_tr_cb, X_va_cb, X_te_cb = X_tr_f.copy(), X_va_f.copy(), X_te_f.copy()\n        for c in text_cols:\n            X_tr_cb[c] = X_tr_cb[c].cat.codes\n            X_va_cb[c] = X_va_cb[c].cat.codes\n            X_te_cb[c] = X_te_cb[c].cat.codes\n    \n        cm = CatBoostClassifier(\n            iterations=3000, learning_rate=0.06, depth=3,\n            cat_features=text_cols, one_hot_max_size=25,\n            eval_metric=\"AUC\", random_seed=fold, task_type=\"GPU\", verbose=False,\n        )\n        cm.fit(X_tr_cb, y_tr, eval_set=(X_va_cb, y_va), early_stopping_rounds=100, verbose=False)\n        cb_sh_oof[va_idx] = cm.predict_proba(X_va_cb)[:, 1]\n        cb_sh_test += cm.predict_proba(X_te_cb)[:, 1] / 5\n    \n        print(f\"Fold {fold} | Shallow XGB: {roc_auc_score(y_va, xgb_sh_oof[va_idx]):.5f} (tree {xm.best_iteration}) | Shallow CB: {roc_auc_score(y_va, cb_sh_oof[va_idx]):.5f} (tree {cm.get_best_iteration()})\")\n    \n    print(\"\\n--- Shallow Models on Digits + Nested TE (5-fold OOF AUC) ---\")\n    print(f\"Shallow LightGBM (3 leaves): {roc_auc_score(y, lgb_nte_oof):.5f}\")\n    print(f\"Shallow XGBoost (depth=2):   {roc_auc_score(y, xgb_sh_oof):.5f}\")\n    print(f\"Shallow CatBoost (depth=3):  {roc_auc_score(y, cb_sh_oof):.5f}\")\n    \n    # Optimize 5-member ensemble (Shallow LGB+NTE, Shallow XGB+NTE, Shallow CB+NTE, Shallow LGB+Digits, Deep 3-Way)\n    deep_oof = 0.2 * lgb_grp_oof + 0.8 * blend3_oof\n    deep_test = 0.2 * lgb_grp_test + 0.8 * blend3_test\n    \n    from scipy.optimize import minimize\n    models_oof = np.column_stack([lgb_nte_oof, xgb_sh_oof, cb_sh_oof, lgb_shallow_oof, deep_oof])\n    models_test = np.column_stack([lgb_nte_test, xgb_sh_test, cb_sh_test, lgb_shallow_test, deep_test])\n    \n    def loss(weights):\n        w = np.maximum(weights, 0)\n        w = w / (w.sum() + 1e-12)\n        return -roc_auc_score(y, models_oof @ w)\n    \n    res = minimize(loss, [0.3, 0.2, 0.2, 0.2, 0.1], method=\"Nelder-Mead\")\n    best_w = np.maximum(res.x, 0)\n    best_w /= best_w.sum()\n    names = [\"Shallow_LGB_NTE\", \"Shallow_XGB_NTE\", \"Shallow_CB_NTE\", \"Shallow_LGB_Dig\", \"Deep_Blend\"]\n    for n, w in zip(names, best_w):\n        print(f\"  Weight {n:16s}: {w:.3f}\")\n    \n    final_oof = models_oof @ best_w\n    final_test = models_test @ best_w\n    print(f\"\\nNEW 5-Member Ensemble OOF AUC: {roc_auc_score(y, final_oof):.5f}\")\nif \"xgb_sh_oof\" not in globals():\n    xgb_sh_oof = np.zeros(len(train_fe))\n    xgb_sh_test = np.zeros(len(test_fe))\n    cb_sh_oof = np.zeros(len(train_fe))\n    cb_sh_test = np.zeros(len(test_fe))\n    deep_oof = np.zeros(len(train_fe))\n    deep_test = np.zeros(len(test_fe))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:16.939037Z","iopub.execute_input":"2026-11-16T05:38:16.939367Z","iopub.status.idle":"2026-11-16T05:38:16.976104Z","shell.execute_reply.started":"2026-11-16T05:38:16.939334Z","shell.execute_reply":"2026-11-16T05:38:16.975234Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"# Step 9: Finer Digit Keys + Frequency + Fast Nested TE + 2-Leaf Stumps & 3-Leaf Trees\ndef add_finer_digits(df):\n    out = df.copy()\n    float_cols = [\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"velocity_score\", \"merchant_risk_score\"\n    ]\n    for col in float_cols:\n        v = out[col].fillna(0).abs()\n        int_v = np.floor(v).astype(np.int64)\n        cents = np.round((v - int_v) * 100).astype(np.int32)\n        out[f\"{col}_int\"] = int_v.astype(np.int32)\n        out[f\"{col}_div10\"] = (int_v // 10).astype(np.int32)\n        out[f\"{col}_div100\"] = (int_v // 100).astype(np.int32)\n        out[f\"{col}_hundreds\"] = ((int_v // 100) % 10).astype(np.int32)\n        out[f\"{col}_thousands\"] = ((int_v // 1000) % 10).astype(np.int32)\n        out[f\"{col}_is_round_cents\"] = (cents == 0).astype(np.int8)\n        out[f\"{col}_is_99_cents\"] = (cents == 99).astype(np.int8)\n        # Leading digit (1..9, or 0 for 0.0) using fast vectorized log10\n        v_pos = np.where(v > 0, v, 1.0)\n        lead = np.floor(np.where(v > 0, v / (10.0 ** np.floor(np.log10(v_pos))), 0.0) + 1e-9)\n        out[f\"{col}_first_digit\"] = np.clip(lead, 0, 9).astype(np.int8)\n    for col in [\"customer_age\", \"card_age_months\"]:\n        out[f\"{col}_ones\"] = (out[col] % 10).astype(np.int32)\n        out[f\"{col}_tens\"] = (out[col] // 10).astype(np.int32)\n    return out\n\nif \"X_dig2\" not in globals():\n    X_dig2 = add_finer_digits(X_dig)\n    X_test_dig2 = add_finer_digits(X_test_dig)\n\n    # Frequency encoding on key columns (train+test value counts, zero label leakage)\n    n_tr = len(X_dig2)\n    freq_cols = [\n        \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"account_balance_usd_cents\",\n        \"amount_usd_int\", \"hours_since_last_txn_int\", \"distance_from_home_km_int\",\n        \"customer_age\", \"card_age_months\", \"merchant_risk_score_int\", \"velocity_score_int\"\n    ]\n    for col in freq_cols:\n        comb = pd.concat([X_dig2[col], X_test_dig2[col]], ignore_index=True)\n        vc = comb.value_counts()\n        X_dig2[f\"{col}_freq\"] = X_dig2[col].map(vc).astype(np.float32)\n        X_test_dig2[f\"{col}_freq\"] = X_test_dig2[col].map(vc).astype(np.float32)\n\n    # Pre-factorize all discrete & digit keys for ultra-fast np.bincount Nested TE\nnte2_keys = [\n    \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\",\n    \"time_of_day_hour\", \"day_of_week\", \"cvv_retry_count\", \"prior_disputes\",\n    \"customer_age\", \"card_age_months\", \"txn_count_last_24h\",\n    \"amount_usd_cents\", \"amount_usd_tenth\", \"amount_usd_hundredth\", \"amount_usd_ones\", \"amount_usd_tens\", \"amount_usd_int\", \"amount_usd_div10\", \"amount_usd_div100\", \"amount_usd_first_digit\",\n    \"hours_since_last_txn_cents\", \"hours_since_last_txn_ones\", \"hours_since_last_txn_tens\", \"hours_since_last_txn_int\", \"hours_since_last_txn_first_digit\",\n    \"distance_from_home_km_cents\", \"distance_from_home_km_ones\", \"distance_from_home_km_tens\", \"distance_from_home_km_div10\", \"distance_from_home_km_first_digit\",\n    \"account_balance_usd_cents\", \"account_balance_usd_ones\", \"account_balance_usd_tens\", \"account_balance_usd_div10\", \"account_balance_usd_div100\", \"account_balance_usd_first_digit\",\n    \"velocity_score_cents\", \"velocity_score_ones\", \"velocity_score_tens\", \"velocity_score_int\", \"velocity_score_first_digit\",\n    \"merchant_risk_score_cents\", \"merchant_risk_score_ones\", \"merchant_risk_score_tens\", \"merchant_risk_score_int\", \"merchant_risk_score_first_digit\",\n]\n\nn_tr = len(X_dig2)\nif \"codes_tr_dict\" not in globals():\n    codes_tr_dict, codes_te_dict, ncats_dict = {}, {}, {}\n    for col in nte2_keys:\n        comb = pd.concat([X_dig2[col].astype(str), X_test_dig2[col].astype(str)], ignore_index=True)\n        codes, _ = pd.factorize(comb, sort=False)\n        codes_tr_dict[col] = codes[:n_tr]\n        codes_te_dict[col] = codes[n_tr:]\n        ncats_dict[col] = int(codes.max()) + 1\n\ninner_skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nsmooth = 20.0\ny_arr = y.values.astype(np.float64)\n\nif \"lgb_dig2_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    lgb_stump_oof = np.zeros(n_tr)\n    lgb_stump_test = np.zeros(len(X_test_dig2))\n    lgb_dig2_oof = np.zeros(n_tr)\n    lgb_dig2_test = np.zeros(len(X_test_dig2))\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        global_prior = y_tr_arr.mean()\n\n        tr_te, va_te, te_te = {}, {}, {}\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        for col in nte2_keys:\n            c_all_tr = codes_tr_dict[col]\n            c_tr = c_all_tr[tr_idx]\n            c_va = c_all_tr[va_idx]\n            c_te = codes_te_dict[col]\n            nc = ncats_dict[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth * global_prior) / (cnt + smooth)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth * global_prior) / (cnt_f + smooth)\n\n            col_name = f\"nte2_{col}\"\n            tr_te[col_name] = tr_vals\n            va_te[col_name] = te_map_f[c_va].astype(np.float32)\n            te_te[col_name] = te_map_f[c_te].astype(np.float32)\n\n        X_tr_f = pd.concat([X_dig2.iloc[tr_idx], pd.DataFrame(tr_te, index=X_dig2.index[tr_idx])], axis=1)\n        X_va_f = pd.concat([X_dig2.iloc[va_idx], pd.DataFrame(va_te, index=X_dig2.index[va_idx])], axis=1)\n        X_te_f = pd.concat([X_test_dig2, pd.DataFrame(te_te, index=X_test_dig2.index)], axis=1)\n\n        # Model A: 2-leaf decision stumps (pure additive GAM, zero interaction overfitting)\n        m_stump = lgb.LGBMClassifier(\n            n_estimators=8000, learning_rate=0.05, num_leaves=2, max_depth=1,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.8,\n            random_state=fold, verbose=-1, n_jobs=-1,\n        )\n        m_stump.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_stump_oof[va_idx] = m_stump.predict_proba(X_va_f)[:, 1]\n        lgb_stump_test += m_stump.predict_proba(X_te_f)[:, 1] / 5\n\n        # Model B: 3-leaf shallow trees on upgraded features\n        m_dig2 = lgb.LGBMClassifier(\n            n_estimators=6000, learning_rate=0.04, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.7,\n            random_state=fold + 100, verbose=-1, n_jobs=-1,\n        )\n        m_dig2.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_dig2_oof[va_idx] = m_dig2.predict_proba(X_va_f)[:, 1]\n        lgb_dig2_test += m_dig2.predict_proba(X_te_f)[:, 1] / 5\n\n        print(f\"Fold {fold} | 2-Leaf Stump: {roc_auc_score(y_va, lgb_stump_oof[va_idx]):.5f} (tree {m_stump.best_iteration_}) | 3-Leaf Dig2: {roc_auc_score(y_va, lgb_dig2_oof[va_idx]):.5f} (tree {m_dig2.best_iteration_})\")\n\nif \"lgb_dig2_oof\" not in globals():\n    lgb_stump_oof = np.zeros(len(X_dig2))\n    lgb_stump_test = np.zeros(len(X_test_dig2))\n    lgb_dig2_oof = np.zeros(len(X_dig2))\n    lgb_dig2_test = np.zeros(len(X_test_dig2))\nprint(\"X_dig2 ready:\", X_dig2.shape, \"| nte2_keys:\", len(nte2_keys))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:16.977232Z","iopub.execute_input":"2026-11-16T05:38:16.977567Z","iopub.status.idle":"2026-11-16T05:38:29.868405Z","shell.execute_reply.started":"2026-11-16T05:38:16.977546Z","shell.execute_reply":"2026-11-16T05:38:29.867619Z"}},"outputs":[{"name":"stdout","text":"X_dig2 ready: (699960, 127) | nte2_keys: 47\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# Step 10: Option 2 — Spline GLM + PyTorch GPU Residual MLP on X_dig2 + 47-Key Nested TE\nimport gc\nimport time\nimport torch\nimport torch.nn as nn\nfrom scipy import sparse\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer, OneHotEncoder\n\ndef signed_log1p(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef safe_logit(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"glm_oof\" not in globals() or \"mlp_oof\" not in globals():\n    t0_all = time.time()\n    n_tr = len(X_dig2)\n    n_te = len(X_test_dig2)\n    glm_oof = np.zeros(n_tr, dtype=np.float64)\n    glm_test = np.zeros(n_te, dtype=np.float64)\n    mlp_oof = np.zeros(n_tr, dtype=np.float64)\n    mlp_test = np.zeros(n_te, dtype=np.float64)\n\n    num_cols = [c for c in X_dig2.columns if c not in text_cols]\n    log_skew_cols = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew_cols.add(c)\n\n    # Pre-build signed-log1p numeric base matrices once (float32)\n    base_tr = X_dig2[num_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base_te = X_test_dig2[num_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num_cols):\n        if c in log_skew_cols:\n            base_tr[:, j] = signed_log1p(base_tr[:, j])\n            base_te[:, j] = signed_log1p(base_te[:, j])\n    base_tr = np.nan_to_num(base_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base_te = np.nan_to_num(base_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline_base_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline_base_idx = [num_cols.index(c) for c in spline_base_cols]\n\n    oh_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh_enc.fit_transform(X_dig2[oh_cols].astype(str))\n    _oh_te = oh_enc.transform(X_test_dig2[oh_cols].astype(str))\n    oh_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    emb_cols = [\n        \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\",\n        \"time_of_day_hour\", \"day_of_week\", \"cvv_retry_count\", \"prior_disputes\",\n        \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"account_balance_usd_cents\",\n        \"velocity_score_cents\", \"merchant_risk_score_cents\",\n        \"amount_usd_first_digit\", \"hours_since_last_txn_first_digit\", \"distance_from_home_km_first_digit\"\n    ]\n    emb_ncats = [ncats_dict[c] for c in emb_cols]\n    X_cat_all = np.column_stack([np.clip(codes_tr_dict[c], 0, ncats_dict[c] - 1) for c in emb_cols]).astype(np.int64)\n    X_cat_te = np.column_stack([np.clip(codes_te_dict[c], 0, ncats_dict[c] - 1) for c in emb_cols]).astype(np.int64)\n\n    top_nte_spline_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"account_balance_usd_cents\", \"velocity_score_cents\", \"merchant_risk_score_cents\"\n    ]\n    top_nte_idx = [nte2_keys.index(k) for k in top_nte_spline_keys]\n\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Option 2 running on device={device} | base_num={base_tr.shape[1]} | emb={len(emb_cols)} | oh={oh_all.shape[1]}\")\n\n    class ResBlock(nn.Module):\n        def __init__(self, dim, dropout=0.25):\n            super().__init__()\n            self.block = nn.Sequential(\n                nn.BatchNorm1d(dim),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n                nn.Linear(dim, dim),\n                nn.BatchNorm1d(dim),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n                nn.Linear(dim, dim),\n            )\n        def forward(self, x):\n            return x + self.block(x)\n\n    class FraudResNet(nn.Module):\n        def __init__(self, num_dim, card_sizes, hidden=256, dropout=0.25):\n            super().__init__()\n            self.embs = nn.ModuleList([\n                nn.Embedding(nc + 1, min(16, max(4, (nc + 1) // 2))) for nc in card_sizes\n            ])\n            emb_dim = sum(e.embedding_dim for e in self.embs)\n            in_dim = num_dim + emb_dim\n            self.skip = nn.Linear(in_dim, 1)\n            self.in_proj = nn.Sequential(\n                nn.Linear(in_dim, hidden),\n                nn.BatchNorm1d(hidden),\n                nn.SiLU(),\n                nn.Dropout(0.15),\n            )\n            self.res1 = ResBlock(hidden, dropout)\n            self.res2 = ResBlock(hidden, dropout)\n            self.head = nn.Sequential(\n                nn.BatchNorm1d(hidden),\n                nn.SiLU(),\n                nn.Linear(hidden, 1),\n            )\n        def forward(self, x_num, x_cat):\n            e = torch.cat([emb(x_cat[:, i]) for i, emb in enumerate(self.embs)], dim=1)\n            x = torch.cat([x_num, e], dim=1)\n            h = self.res2(self.res1(self.in_proj(x)))\n            return (self.skip(x) + self.head(h)).squeeze(1)\n\n    from sklearn.linear_model import LogisticRegression\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr_arr.astype(np.int32)))\n\n        # Leak-free 47 logit(Nested TE) matrices for this fold\n        nte_tr = np.empty((len(tr_idx), len(nte2_keys)), dtype=np.float32)\n        nte_va = np.empty((len(va_idx), len(nte2_keys)), dtype=np.float32)\n        nte_te = np.empty((n_te, len(nte2_keys)), dtype=np.float32)\n\n        for j, col in enumerate(nte2_keys):\n            c_all = codes_tr_dict[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes_te_dict[col]\n            nc = ncats_dict[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth * global_prior) / (cnt + smooth)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth * global_prior) / (cnt_f + smooth)\n\n            nte_tr[:, j] = safe_logit(tr_vals)\n            nte_va[:, j] = safe_logit(te_map_f[c_va])\n            nte_te[:, j] = safe_logit(te_map_f[c_te])\n\n        # Standardize base_num + logit(NTE) inside the fold\n        raw_tr = np.hstack([base_tr[tr_idx], nte_tr])\n        raw_va = np.hstack([base_tr[va_idx], nte_va])\n        raw_te = np.hstack([base_te, nte_te])\n\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(raw_tr), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(raw_va), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(raw_te), -6.0, 6.0).astype(np.float32)\n\n        # --- Model 1: Spline GLM (Logistic Regression with B-splines) ---\n        t_glm = time.time()\n        sp_cols_tr = np.hstack([x_tr_std[:, spline_base_idx], x_tr_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n        sp_cols_va = np.hstack([x_va_std[:, spline_base_idx], x_va_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n        sp_cols_te = np.hstack([x_te_std[:, spline_base_idx], x_te_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n\n        spline_tf = SplineTransformer(n_knots=7, degree=3, knots=\"uniform\", include_bias=False)\n        sp_tr = spline_tf.fit_transform(np.clip(sp_cols_tr, -4.0, 4.0)).astype(np.float32)\n        sp_va = spline_tf.transform(np.clip(sp_cols_va, -4.0, 4.0)).astype(np.float32)\n        sp_te = spline_tf.transform(np.clip(sp_cols_te, -4.0, 4.0)).astype(np.float32)\n\n        glm_tr = np.hstack([x_tr_std, sp_tr, oh_all[tr_idx]])\n        glm_va = np.hstack([x_va_std, sp_va, oh_all[va_idx]])\n        glm_te = np.hstack([x_te_std, sp_te, oh_te])\n\n        if not globals().get(\"SKIP_SUPERSEDED\", False):\n            glm = LogisticRegression(C=0.2, solver=\"lbfgs\", max_iter=250, tol=1e-4)\n            glm.fit(glm_tr, y_tr_arr.astype(np.int32))\n            glm_oof[va_idx] = glm.predict_proba(glm_va)[:, 1]\n            glm_test += glm.predict_proba(glm_te)[:, 1] / 5.0\n            glm_auc = roc_auc_score(y_va_arr, glm_oof[va_idx])\n        else:\n            glm_auc = 0.0\n        glm_sec = time.time() - t_glm\n        del sp_tr, sp_va, sp_te, glm_tr, glm_va, glm_te, sp_cols_tr, sp_cols_va, sp_cols_te, raw_tr, raw_va, raw_te\n        gc.collect()\n\n        # --- Model 2: PyTorch GPU Residual MLP ---\n        t_mlp = time.time()\n        torch.manual_seed(42 + fold)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(42 + fold)\n\n        X_tr_num_t = torch.from_numpy(x_tr_std).to(device)\n        X_va_num_t = torch.from_numpy(x_va_std).to(device)\n        X_te_num_t = torch.from_numpy(x_te_std).to(device)\n        X_tr_cat_t = torch.from_numpy(X_cat_all[tr_idx]).to(device)\n        X_va_cat_t = torch.from_numpy(X_cat_all[va_idx]).to(device)\n        X_te_cat_t = torch.from_numpy(X_cat_te).to(device)\n        y_tr_t = torch.from_numpy(y_tr_arr.astype(np.float32)).to(device)\n\n        model = FraudResNet(x_tr_std.shape[1], emb_ncats, hidden=256, dropout=0.25).to(device)\n        opt = torch.optim.AdamW(model.parameters(), lr=2e-3, weight_decay=2e-4)\n        epochs = 22\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=2e-5)\n        crit = nn.BCEWithLogitsLoss()\n        bs = 2048\n        n_f = len(tr_idx)\n\n        best_auc = -1.0\n        best_ep = 0\n        best_state = None\n        no_imp = 0\n\n        for ep in range(1, epochs + 1):\n            model.train()\n            perm = torch.randperm(n_f, device=device)\n            for s in range(0, n_f, bs):\n                idx = perm[s:s + bs]\n                opt.zero_grad(set_to_none=True)\n                logits = model(X_tr_num_t[idx], X_tr_cat_t[idx])\n                loss = crit(logits, y_tr_t[idx])\n                loss.backward()\n                opt.step()\n            sched.step()\n\n            model.eval()\n            va_preds = []\n            with torch.no_grad():\n                for s in range(0, len(va_idx), 8192):\n                    va_preds.append(torch.sigmoid(model(X_va_num_t[s:s + 8192], X_va_cat_t[s:s + 8192])).cpu().numpy())\n            va_p = np.concatenate(va_preds)\n            va_auc = roc_auc_score(y_va_arr, va_p)\n            if va_auc > best_auc + 1e-6:\n                best_auc = va_auc\n                best_ep = ep\n                best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n                no_imp = 0\n            else:\n                no_imp += 1\n                if no_imp >= 5:\n                    break\n\n        model.load_state_dict({k: v.to(device) for k, v in best_state.items()})\n        model.eval()\n        with torch.no_grad():\n            va_preds = [torch.sigmoid(model(X_va_num_t[s:s + 8192], X_va_cat_t[s:s + 8192])).cpu().numpy() for s in range(0, len(va_idx), 8192)]\n            te_preds = [torch.sigmoid(model(X_te_num_t[s:s + 8192], X_te_cat_t[s:s + 8192])).cpu().numpy() for s in range(0, n_te, 8192)]\n        mlp_oof[va_idx] = np.concatenate(va_preds)\n        mlp_test += np.concatenate(te_preds) / 5.0\n        mlp_sec = time.time() - t_mlp\n\n        print(f\"Fold {fold} | Spline GLM: {glm_auc:.5f} ({glm_sec:.1f}s) | PyTorch MLP: {best_auc:.5f} (ep {best_ep}, {mlp_sec:.1f}s)\")\n\n        del model, opt, sched, best_state, X_tr_num_t, X_va_num_t, X_te_num_t, X_tr_cat_t, X_va_cat_t, X_te_cat_t, y_tr_t\n        del x_tr_std, x_va_std, x_te_std, nte_tr, nte_va, nte_te\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n        gc.collect()\n\n    np.savez(\"/kaggle/working/preds_opt2.npz\", glm_oof=glm_oof, glm_test=glm_test, mlp_oof=mlp_oof, mlp_test=mlp_test)\n    print(f\"Total Option 2 runtime: {time.time() - t0_all:.1f}s\")\n\nprint(\"\\n--- Option 2 Models (5-fold OOF AUC) ---\")\nif glm_oof.max() > 0: print(f\"Spline GLM  (X_dig2 + 47 logit-NTE): {roc_auc_score(y, glm_oof):.5f}\")\nprint(f\"PyTorch MLP (ResNet + Emb + NTE):    {roc_auc_score(y, mlp_oof):.5f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:29.869632Z","iopub.execute_input":"2026-11-16T05:38:29.869943Z","iopub.status.idle":"2026-11-16T05:38:34.326076Z","shell.execute_reply.started":"2026-11-16T05:38:29.869911Z","shell.execute_reply":"2026-11-16T05:38:34.32537Z"}},"outputs":[{"name":"stdout","text":"\n--- Option 2 Models (5-fold OOF AUC) ---\nPyTorch MLP (ResNet + Emb + NTE):    0.94609\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# Step 11: Exp 3 — X_dig3 (Exact Tenths + Flags Bitmask + Group Z-Scores) + 28 High-Signal Pairwise Nested TE Keys\nimport gc\nimport time\nimport xgboost as xgb\nfrom catboost import CatBoostClassifier\nfrom scipy import sparse\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer, OneHotEncoder\n\ndef _signed_log1p(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef _safe_logit(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"X_dig3\" not in globals():\n    X_dig3 = X_dig2.copy()\n    X_test_dig3 = X_test_dig2.copy()\n\n    flag_cols = [\n        \"is_foreign_transaction\", \"is_new_merchant\", \"used_vpn\",\n        \"ip_country_mismatch\", \"billing_shipping_mismatch\", \"is_ai_generated_scam_attempt\"\n    ]\n    def _build_extras(df_tr, df_te):\n        tr_out = pd.DataFrame(index=df_tr.index)\n        te_out = pd.DataFrame(index=df_te.index)\n\n        # Exact tenth integers & 6-bit flag pattern\n        tr_out[\"risk_x10\"] = np.round(df_tr[\"merchant_risk_score\"].values * 10).astype(np.int32)\n        te_out[\"risk_x10\"] = np.round(df_te[\"merchant_risk_score\"].values * 10).astype(np.int32)\n        tr_out[\"vel_x10\"] = np.round(df_tr[\"velocity_score\"].values * 10).astype(np.int32)\n        te_out[\"vel_x10\"] = np.round(df_te[\"velocity_score\"].values * 10).astype(np.int32)\n        tr_out[\"hrs_x10\"] = np.round(df_tr[\"hours_since_last_txn\"].values * 10).astype(np.int32)\n        te_out[\"hrs_x10\"] = np.round(df_te[\"hours_since_last_txn\"].values * 10).astype(np.int32)\n\n        fc_tr = np.zeros(len(df_tr), dtype=np.int32)\n        fc_te = np.zeros(len(df_te), dtype=np.int32)\n        for bi, fc in enumerate(flag_cols):\n            fc_tr += (df_tr[fc].values.astype(np.int32) << bi)\n            fc_te += (df_te[fc].values.astype(np.int32) << bi)\n        tr_out[\"flags_bitmask\"] = fc_tr\n        te_out[\"flags_bitmask\"] = fc_te\n        return tr_out, te_out\n\n    ex_tr, ex_te = _build_extras(X_dig3, X_test_dig3)\n    for c in ex_tr.columns:\n        X_dig3[c] = ex_tr[c]\n        X_test_dig3[c] = ex_te[c]\n\n    # Within-group z-scores by merchant_category, auth_method, and flags_bitmask (feature-only X, zero label usage)\n    comb_x = pd.concat([\n        X_dig3[[\"merchant_category\", \"auth_method\", \"flags_bitmask\", \"amount_usd_log1p\", \"merchant_risk_score\", \"velocity_score\", \"hours_since_last_txn_log1p\"]],\n        X_test_dig3[[\"merchant_category\", \"auth_method\", \"flags_bitmask\", \"amount_usd_log1p\", \"merchant_risk_score\", \"velocity_score\", \"hours_since_last_txn_log1p\"]]\n    ], ignore_index=True)\n    n_tr3 = len(X_dig3)\n    for gcol in [\"merchant_category\", \"auth_method\", \"flags_bitmask\"]:\n        for vcol in [\"merchant_risk_score\", \"velocity_score\", \"amount_usd_log1p\", \"hours_since_last_txn_log1p\"]:\n            grp = comb_x.groupby(gcol, observed=False)[vcol]\n            mu = grp.transform(\"mean\").values\n            sd = grp.transform(\"std\").values + 1e-5\n            z = ((comb_x[vcol].values - mu) / sd).astype(np.float32)\n            cname = f\"{vcol}_z_{gcol}\"\n            X_dig3[cname] = z[:n_tr3]\n            X_test_dig3[cname] = z[n_tr3:]\n    del comb_x, ex_tr, ex_te\n\nif \"codes3_tr\" not in globals():\n    _, amt_bins = pd.qcut(X_dig3[\"amount_usd\"], 20, retbins=True, labels=False, duplicates=\"drop\")\n    amt_bin_tr = np.digitize(X_dig3[\"amount_usd\"].values, amt_bins[1:-1])\n    amt_bin_te = np.digitize(X_test_dig3[\"amount_usd\"].values, amt_bins[1:-1])\n\n    def _pair_series(df, amt_b):\n        age10 = (df[\"customer_age\"].values // 10).astype(str)\n        s_flags = df[\"flags_bitmask\"].astype(str)\n        s_rcnt = df[\"risk_flag_count\"].astype(str)\n        s_rtens = df[\"merchant_risk_score_tens\"].astype(str)\n        s_vtens = df[\"velocity_score_tens\"].astype(str)\n        s_auth = df[\"auth_method\"].astype(str)\n        s_merch = df[\"merchant_category\"].astype(str)\n        s_cvv = df[\"cvv_retry_count\"].astype(str)\n        return {\n            \"risk_x10\": df[\"risk_x10\"].astype(str),\n            \"vel_x10\": df[\"vel_x10\"].astype(str),\n            \"hrs_x10\": df[\"hrs_x10\"].astype(str),\n            \"flags_bitmask\": s_flags,\n            \"flags_x_riskTens\": s_flags + \"_\" + s_rtens,\n            \"riskCount_x_riskTens\": s_rcnt + \"_\" + s_rtens,\n            \"riskCount_x_cvv\": s_rcnt + \"_\" + s_cvv,\n            \"riskCount_x_velTens\": s_rcnt + \"_\" + s_vtens,\n            \"flags_x_auth\": s_flags + \"_\" + s_auth,\n            \"risk_x_auth\": s_rcnt + \"_\" + s_auth,\n            \"auth_x_cvv\": s_auth + \"_\" + s_cvv,\n            \"flags_x_merch\": s_flags + \"_\" + s_merch,\n            \"riskTens_x_auth\": s_rtens + \"_\" + s_auth,\n            \"riskTens_x_velTens\": s_rtens + \"_\" + s_vtens,\n            \"merch_x_cvv\": s_merch + \"_\" + s_cvv,\n            \"velTens_x_auth\": s_vtens + \"_\" + s_auth,\n            \"riskTens_x_age10\": s_rtens + \"_\" + pd.Series(age10, index=df.index),\n            \"riskTens_x_merch\": s_rtens + \"_\" + s_merch,\n            \"merch_x_auth\": s_merch + \"_\" + s_auth,\n            \"cvv_x_disp\": s_cvv + \"_\" + df[\"prior_disputes\"].astype(str),\n            \"amtLogBin_x_riskTens\": pd.Series(amt_b.astype(str), index=df.index) + \"_\" + s_rtens,\n            \"merch_x_new\": s_merch + \"_\" + df[\"is_new_merchant\"].astype(str),\n            \"hrsInt_x_velTens\": df[\"hours_since_last_txn_int\"].astype(str) + \"_\" + s_vtens,\n            \"txn24_x_velTens\": df[\"txn_count_last_24h\"].astype(str) + \"_\" + s_vtens,\n            \"auth_x_scam\": s_auth + \"_\" + df[\"is_ai_generated_scam_attempt\"].astype(str),\n            \"auth_x_dev\": s_auth + \"_\" + df[\"device_type\"].astype(str),\n            \"vpn_x_ipmm\": df[\"used_vpn\"].astype(str) + \"_\" + df[\"ip_country_mismatch\"].astype(str),\n            \"foreign_x_ipmm\": df[\"is_foreign_transaction\"].astype(str) + \"_\" + df[\"ip_country_mismatch\"].astype(str),\n        }\n\n    p_tr_dict = _pair_series(X_dig3, amt_bin_tr)\n    p_te_dict = _pair_series(X_test_dig3, amt_bin_te)\n    pair_keys = list(p_tr_dict.keys())\n    n_tr3 = len(X_dig3)\n\n    codes3_tr = dict(codes_tr_dict)\n    codes3_te = dict(codes_te_dict)\n    ncats3 = dict(ncats_dict)\n    for col in pair_keys:\n        comb = pd.concat([p_tr_dict[col], p_te_dict[col]], ignore_index=True)\n        codes, _ = pd.factorize(comb, sort=False)\n        codes3_tr[col] = codes[:n_tr3]\n        codes3_te[col] = codes[n_tr3:]\n        ncats3[col] = int(codes.max()) + 1\n\n    # Add frequency encoding for high-signal interaction keys\n    for col in [\"flags_bitmask\", \"flags_x_riskTens\", \"risk_x_auth\", \"riskTens_x_velTens\"]:\n        comb_c = np.concatenate([codes3_tr[col], codes3_te[col]])\n        vc = np.bincount(comb_c, minlength=ncats3[col]).astype(np.float32)\n        X_dig3[f\"{col}_freq\"] = vc[codes3_tr[col]]\n        X_test_dig3[f\"{col}_freq\"] = vc[codes3_te[col]]\n\n    nte3_keys = list(nte2_keys) + [k for k in pair_keys if k not in nte2_keys]\n    del p_tr_dict, p_te_dict\n    print(f\"Prepared X_dig3: {X_dig3.shape} | Total Nested TE keys: {len(nte3_keys)}\")\n\nif \"lgb_dig3_oof\" not in globals() or \"xgb_dig3_oof\" not in globals() or \"cb_dig3_oof\" not in globals() or \"glm_dig3_oof\" not in globals():\n    t0_exp3 = time.time()\n    n_tr3 = len(X_dig3)\n    n_te3 = len(X_test_dig3)\n    lgb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    lgb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    xgb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    xgb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    cb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    cb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    glm_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    glm_dig3_test = np.zeros(n_te3, dtype=np.float64)\n\n    # Prebuild base numeric + one-hot arrays for Spline_GLM_Dig3\n    num3_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew3 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num3_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew3.add(c)\n    base3_tr = X_dig3[num3_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base3_te = X_test_dig3[num3_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num3_cols):\n        if c in log_skew3:\n            base3_tr[:, j] = _signed_log1p(base3_tr[:, j])\n            base3_te[:, j] = _signed_log1p(base3_te[:, j])\n    base3_tr = np.nan_to_num(base3_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base3_te = np.nan_to_num(base3_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline3_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline3_idx = [num3_cols.index(c) for c in spline3_cols]\n    top_nte3_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"flags_x_riskTens\", \"riskCount_x_cvv\", \"risk_x_auth\", \"riskTens_x_velTens\", \"flags_bitmask\"\n    ]\n    top_nte3_idx = [nte3_keys.index(k) for k in top_nte3_keys]\n\n    oh3_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh3_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh3_enc.fit_transform(X_dig3[oh3_cols].astype(str))\n    _oh_te = oh3_enc.transform(X_test_dig3[oh3_cols].astype(str))\n    oh3_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh3_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    smooth3 = 25.0\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig3, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        tr_te, va_te, te_te = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_te = np.empty((n_te3, len(nte3_keys)), dtype=np.float32)\n\n        for j, col in enumerate(nte3_keys):\n            c_all = codes3_tr[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes3_te[col]\n            nc = ncats3[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth3 * global_prior) / (cnt + smooth3)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth3 * global_prior) / (cnt_f + smooth3)\n\n            cname = f\"nte3_{col}\"\n            va_vals = te_map_f[c_va].astype(np.float32)\n            te_vals = te_map_f[c_te].astype(np.float32)\n            tr_te[cname] = tr_vals\n            va_te[cname] = va_vals\n            te_te[cname] = te_vals\n\n            nte_log_tr[:, j] = _safe_logit(tr_vals)\n            nte_log_va[:, j] = _safe_logit(va_vals)\n            nte_log_te[:, j] = _safe_logit(te_vals)\n\n        X_tr_f = pd.concat([X_dig3.iloc[tr_idx], pd.DataFrame(tr_te, index=X_dig3.index[tr_idx])], axis=1)\n        X_va_f = pd.concat([X_dig3.iloc[va_idx], pd.DataFrame(va_te, index=X_dig3.index[va_idx])], axis=1)\n        X_te_f = pd.concat([X_test_dig3, pd.DataFrame(te_te, index=X_test_dig3.index)], axis=1)\n\n        # 1) Shallow LightGBM (3 leaves) on X_dig3\n        m_lgb = lgb.LGBMClassifier(\n            n_estimators=7000, learning_rate=0.035, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.65,\n            reg_alpha=1.0, reg_lambda=5.0, random_state=fold + 300, verbose=-1, n_jobs=-1,\n        )\n        m_lgb.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_dig3_oof[va_idx] = m_lgb.predict_proba(X_va_f)[:, 1]\n        lgb_dig3_test += m_lgb.predict_proba(X_te_f)[:, 1] / 5.0\n\n        # 2) Shallow XGBoost (max_depth=2, GPU) on X_dig3\n        m_xgb = xgb.XGBClassifier(\n            n_estimators=6000, learning_rate=0.04, max_depth=2,\n            min_child_weight=100, subsample=0.8, colsample_bytree=0.7,\n            reg_alpha=1.0, reg_lambda=5.0,\n            tree_method=\"hist\", device=\"cuda\", enable_categorical=True,\n            eval_metric=\"auc\", early_stopping_rounds=150, random_state=fold + 300, n_jobs=-1,\n        )\n        m_xgb.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], verbose=False)\n        xgb_dig3_oof[va_idx] = m_xgb.predict_proba(X_va_f)[:, 1]\n        xgb_dig3_test += m_xgb.predict_proba(X_te_f)[:, 1] / 5.0\n\n        # 3) Shallow CatBoost (depth=3, GPU) on X_dig3\n        X_tr_cb, X_va_cb, X_te_cb = X_tr_f.copy(), X_va_f.copy(), X_te_f.copy()\n        for c in text_cols:\n            X_tr_cb[c] = X_tr_cb[c].cat.codes\n            X_va_cb[c] = X_va_cb[c].cat.codes\n            X_te_cb[c] = X_te_cb[c].cat.codes\n        m_cb = CatBoostClassifier(\n            iterations=6000, learning_rate=0.045, depth=3,\n            l2_leaf_reg=5.0, cat_features=text_cols, one_hot_max_size=25,\n            eval_metric=\"AUC\", random_seed=fold + 300, task_type=\"GPU\", verbose=False,\n        )\n        m_cb.fit(X_tr_cb, y_tr, eval_set=(X_va_cb, y_va), early_stopping_rounds=150, verbose=False)\n        cb_dig3_oof[va_idx] = m_cb.predict_proba(X_va_cb)[:, 1]\n        cb_dig3_test += m_cb.predict_proba(X_te_cb)[:, 1] / 5.0\n        del X_tr_f, X_va_f, X_te_f, X_tr_cb, X_va_cb, X_te_cb, tr_te, va_te, te_te\n\n        # 4) Spline GLM on X_dig3 + 75 logit(NTE)\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base3_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base3_tr[va_idx], nte_log_va])), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(np.hstack([base3_te, nte_log_te])), -6.0, 6.0).astype(np.float32)\n\n        off = base3_tr.shape[1]\n        sp_tf = SplineTransformer(n_knots=7, degree=3, knots=\"uniform\", include_bias=False)\n        sp_tr = sp_tf.fit_transform(np.clip(np.hstack([x_tr_std[:, spline3_idx], x_tr_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_va = sp_tf.transform(np.clip(np.hstack([x_va_std[:, spline3_idx], x_va_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_te = sp_tf.transform(np.clip(np.hstack([x_te_std[:, spline3_idx], x_te_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n\n        if not globals().get(\"SKIP_SUPERSEDED\", False):\n            glm3 = LogisticRegression(C=0.2, solver=\"lbfgs\", max_iter=250, tol=1e-4)\n            glm3.fit(np.hstack([x_tr_std, sp_tr, oh3_all[tr_idx]]), y_tr_arr.astype(np.int32))\n            glm_dig3_oof[va_idx] = glm3.predict_proba(np.hstack([x_va_std, sp_va, oh3_all[va_idx]]))[:, 1]\n            glm_dig3_test += glm3.predict_proba(np.hstack([x_te_std, sp_te, oh3_te]))[:, 1] / 5.0\n        else:\n            glm_dig3_oof[va_idx] = 0.5 * lgb_dig3_oof[va_idx] + 0.5 * xgb_dig3_oof[va_idx]\n\n        print(\n            f\"Fold {fold} ({time.time()-t_f:.0f}s) | LGB3: {roc_auc_score(y_va, lgb_dig3_oof[va_idx]):.5f} \"\n            f\"| XGB3: {roc_auc_score(y_va, xgb_dig3_oof[va_idx]):.5f} \"\n            f\"| CB3: {roc_auc_score(y_va, cb_dig3_oof[va_idx]):.5f} \"\n            f\"| GLM3: {roc_auc_score(y_va, glm_dig3_oof[va_idx]):.5f}\"\n        )\n        del x_tr_std, x_va_std, x_te_std, sp_tr, sp_va, sp_te, nte_log_tr, nte_log_va, nte_log_te\n        gc.collect()\n\n    np.savez(\n        \"/kaggle/working/preds_exp3.npz\",\n        lgb_dig3_oof=lgb_dig3_oof, lgb_dig3_test=lgb_dig3_test,\n        xgb_dig3_oof=xgb_dig3_oof, xgb_dig3_test=xgb_dig3_test,\n        cb_dig3_oof=cb_dig3_oof, cb_dig3_test=cb_dig3_test,\n        glm_dig3_oof=glm_dig3_oof, glm_dig3_test=glm_dig3_test,\n    )\n    print(f\"Total Exp 3 runtime: {time.time() - t0_exp3:.1f}s\")\n\nprint(\"\\n--- Exp 3 (X_dig3 + Pairwise Nested TE) 5-fold OOF AUCs ---\")\nprint(f\"LGB_3L_Dig3:     {roc_auc_score(y, lgb_dig3_oof):.5f}\")\nprint(f\"XGB_Dig3:        {roc_auc_score(y, xgb_dig3_oof):.5f}\")\nprint(f\"CB_Dig3:         {roc_auc_score(y, cb_dig3_oof):.5f}\")\nprint(f\"Spline_GLM_Dig3: {roc_auc_score(y, glm_dig3_oof):.5f}\")\n\nif \"xgb_dig3_oof\" not in globals():\n    xgb_dig3_oof = np.zeros(len(train_fe))\n    xgb_dig3_test = np.zeros(len(test_fe))\nif \"cb_dig3_oof\" not in globals():\n    cb_dig3_oof = np.zeros(len(train_fe))\n    cb_dig3_test = np.zeros(len(test_fe))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:34.327889Z","iopub.execute_input":"2026-11-16T05:38:34.32845Z","iopub.status.idle":"2026-11-16T05:38:46.841614Z","shell.execute_reply.started":"2026-11-16T05:38:34.328409Z","shell.execute_reply":"2026-11-16T05:38:46.840906Z"}},"outputs":[{"name":"stdout","text":"Prepared X_dig3: (699960, 147) | Total Nested TE keys: 75\n\n--- Exp 3 (X_dig3 + Pairwise Nested TE) 5-fold OOF AUCs ---\nLGB_3L_Dig3:     0.94958\nXGB_Dig3:        0.94925\nCB_Dig3:         0.94825\nSpline_GLM_Dig3: 0.94957\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"# Step 12: Exp 4 — PyTorch Periodic-Embedding WideResNet (Dig3) + Clean-Pair LightGBM (3-Leaf)\nimport gc\nimport math\nimport time\nimport torch\nimport torch.nn as nn\nfrom scipy import sparse\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\n\ndef _signed_log1p_4(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef _safe_logit_4(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"nn_dig3_oof\" not in globals() or \"lgb_clean_oof\" not in globals():\n    t0_exp4 = time.time()\n    n_tr4 = len(X_dig3)\n    n_te4 = len(X_test_dig3)\n    nn_dig3_oof = np.zeros(n_tr4, dtype=np.float64)\n    nn_dig3_test = np.zeros(n_te4, dtype=np.float64)\n    lgb_clean_oof = np.zeros(n_tr4, dtype=np.float64)\n    lgb_clean_test = np.zeros(n_te4, dtype=np.float64)\n\n    # Numeric base matrix for PyTorch PLR WideResNet\n    num4_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew4 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num4_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew4.add(c)\n    base4_tr = X_dig3[num4_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base4_te = X_test_dig3[num4_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num4_cols):\n        if c in log_skew4:\n            base4_tr[:, j] = _signed_log1p_4(base4_tr[:, j])\n            base4_te[:, j] = _signed_log1p_4(base4_te[:, j])\n    base4_tr = np.nan_to_num(base4_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base4_te = np.nan_to_num(base4_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    oh4_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh4_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh4_enc.fit_transform(X_dig3[oh4_cols].astype(str))\n    _oh_te = oh4_enc.transform(X_test_dig3[oh4_cols].astype(str))\n    oh4_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh4_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    # Clean 17 pairwise / exact-tenth keys (avoiding 437-bucket flags_x_merch & raw flags_bitmask split clutter)\n    clean_extra_keys = [\n        \"hrs_x10\", \"risk_x10\", \"vel_x10\", \"flags_bitmask\", \"flags_x_riskTens\",\n        \"riskCount_x_riskTens\", \"riskCount_x_cvv\", \"riskCount_x_velTens\",\n        \"flags_x_auth\", \"risk_x_auth\", \"auth_x_cvv\", \"riskTens_x_auth\",\n        \"riskTens_x_velTens\", \"merch_x_cvv\", \"velTens_x_auth\", \"merch_x_auth\", \"cvv_x_disp\"\n    ]\n    lgb_nte_keys = list(nte2_keys) + clean_extra_keys\n\n    class PeriodicEmbeddings(nn.Module):\n        def __init__(self, n_features, n_bins=6, d_emb=4, sigma=0.12):\n            super().__init__()\n            self.freqs = nn.Parameter(torch.randn(n_features, n_bins) * sigma)\n            self.weight = nn.Parameter(torch.randn(n_features, 2 * n_bins, d_emb) / math.sqrt(2 * n_bins))\n            self.bias = nn.Parameter(torch.zeros(n_features, d_emb))\n        def forward(self, x):\n            c = 2.0 * math.pi * x.unsqueeze(-1) * self.freqs.unsqueeze(0)\n            sc = torch.cat([torch.sin(c), torch.cos(c)], dim=-1)\n            emb = torch.einsum(\"bdk,dkm->bdm\", sc, self.weight) + self.bias.unsqueeze(0)\n            return torch.nn.functional.silu(emb).flatten(1)\n\n    class PLRWideResNet(nn.Module):\n        def __init__(self, n_num, n_oh, n_bins=6, d_emb=4, hidden=192, dropout=0.35):\n            super().__init__()\n            self.plr = PeriodicEmbeddings(n_num, n_bins=n_bins, d_emb=d_emb, sigma=0.12)\n            raw_dim = n_num + n_oh\n            in_dim = n_num * d_emb + raw_dim\n            self.wide = nn.Linear(raw_dim, 1)\n            self.in_proj = nn.Sequential(\n                nn.Linear(in_dim, hidden),\n                nn.LayerNorm(hidden),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n            )\n            self.b1 = nn.Sequential(\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden), nn.SiLU(), nn.Dropout(dropout),\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden),\n            )\n            self.b2 = nn.Sequential(\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden), nn.SiLU(), nn.Dropout(dropout),\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden),\n            )\n            self.act = nn.SiLU()\n            self.head = nn.Linear(hidden, 1)\n        def forward(self, x_num, x_oh):\n            raw = torch.cat([x_num, x_oh], dim=1)\n            p = self.plr(x_num)\n            h = self.in_proj(torch.cat([p, raw], dim=1))\n            h = self.act(h + self.b1(h))\n            h = self.act(h + self.b2(h))\n            return (self.wide(raw) + self.head(h)).squeeze(1)\n\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Exp 4 running on device={device} | PLR n_num={base4_tr.shape[1]+len(nte3_keys)} | LGB_Clean NTE keys={len(lgb_nte_keys)}\")\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        # Compute all 75 NTEs cleanly (smooth=20 for clean LGB compatibility, smooth=25 for NN)\n        tr_te_clean, va_te_clean, te_te_clean = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_te = np.empty((n_te4, len(nte3_keys)), dtype=np.float32)\n        clean_set = set(lgb_nte_keys)\n\n        for j, col in enumerate(nte3_keys):\n            c_all = codes3_tr[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes3_te[col]\n            nc = ncats3[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + 20.0 * global_prior) / (cnt + 20.0)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + 20.0 * global_prior) / (cnt_f + 20.0)\n            va_vals = te_map_f[c_va].astype(np.float32)\n            te_vals = te_map_f[c_te].astype(np.float32)\n\n            if col in clean_set:\n                cname = f\"nte_{col}\"\n                tr_te_clean[cname] = tr_vals\n                va_te_clean[cname] = va_vals\n                te_te_clean[cname] = te_vals\n\n            nte_log_tr[:, j] = _safe_logit_4(tr_vals)\n            nte_log_va[:, j] = _safe_logit_4(va_vals)\n            nte_log_te[:, j] = _safe_logit_4(te_vals)\n\n        # 1) PyTorch PLR WideResNet on GPU\n        t_nn = time.time()\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base4_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base4_tr[va_idx], nte_log_va])), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(np.hstack([base4_te, nte_log_te])), -6.0, 6.0).astype(np.float32)\n\n        torch.manual_seed(100 + fold)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(100 + fold)\n\n        X_tr_n = torch.from_numpy(x_tr_std).to(device)\n        X_va_n = torch.from_numpy(x_va_std).to(device)\n        X_te_n = torch.from_numpy(x_te_std).to(device)\n        X_tr_o = torch.from_numpy(oh4_all[tr_idx]).to(device)\n        X_va_o = torch.from_numpy(oh4_all[va_idx]).to(device)\n        X_te_o = torch.from_numpy(oh4_te).to(device)\n        y_tr_t = torch.from_numpy(y_tr_arr.astype(np.float32)).to(device)\n\n        model = PLRWideResNet(x_tr_std.shape[1], oh4_all.shape[1], n_bins=6, d_emb=4, hidden=192, dropout=0.35).to(device)\n        opt = torch.optim.AdamW(model.parameters(), lr=6e-4, weight_decay=2e-3)\n        epochs = 26\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=1e-5)\n        crit = nn.BCEWithLogitsLoss()\n        bs = 4096\n        n_f = len(tr_idx)\n\n        best_auc, best_ep, best_state, no_imp = -1.0, 0, None, 0\n        for ep in range(1, epochs + 1):\n            model.train()\n            perm = torch.randperm(n_f, device=device)\n            for s in range(0, n_f, bs):\n                idx = perm[s:s + bs]\n                opt.zero_grad(set_to_none=True)\n                loss = crit(model(X_tr_n[idx], X_tr_o[idx]), y_tr_t[idx])\n                loss.backward()\n                opt.step()\n            sched.step()\n\n            model.eval()\n            with torch.no_grad():\n                va_p = np.concatenate([\n                    torch.sigmoid(model(X_va_n[s:s + 8192], X_va_o[s:s + 8192])).cpu().numpy()\n                    for s in range(0, len(va_idx), 8192)\n                ])\n            va_auc = roc_auc_score(y_va_arr, va_p)\n            if va_auc > best_auc + 1e-6:\n                best_auc, best_ep = va_auc, ep\n                best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n                no_imp = 0\n            else:\n                no_imp += 1\n                if no_imp >= 6:\n                    break\n\n        model.load_state_dict({k: v.to(device) for k, v in best_state.items()})\n        model.eval()\n        with torch.no_grad():\n            nn_dig3_oof[va_idx] = np.concatenate([\n                torch.sigmoid(model(X_va_n[s:s + 8192], X_va_o[s:s + 8192])).cpu().numpy()\n                for s in range(0, len(va_idx), 8192)\n            ])\n            nn_dig3_test += np.concatenate([\n                torch.sigmoid(model(X_te_n[s:s + 8192], X_te_o[s:s + 8192])).cpu().numpy()\n                for s in range(0, n_te4, 8192)\n            ]) / 5.0\n        nn_sec = time.time() - t_nn\n\n        del model, opt, sched, best_state, X_tr_n, X_va_n, X_te_n, X_tr_o, X_va_o, X_te_o, y_tr_t\n        del x_tr_std, x_va_std, x_te_std, nte_log_tr, nte_log_va, nte_log_te\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n\n        # 2) Clean-Pair LightGBM (3-leaf on X_dig2 + 64 clean NTE keys)\n        X_tr_c = pd.concat([X_dig2.iloc[tr_idx], pd.DataFrame(tr_te_clean, index=X_dig2.index[tr_idx])], axis=1)\n        X_va_c = pd.concat([X_dig2.iloc[va_idx], pd.DataFrame(va_te_clean, index=X_dig2.index[va_idx])], axis=1)\n        X_te_c = pd.concat([X_test_dig2, pd.DataFrame(te_te_clean, index=X_test_dig2.index)], axis=1)\n\n        m_clean = lgb.LGBMClassifier(\n            n_estimators=6500, learning_rate=0.04, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.75,\n            random_state=fold + 400, verbose=-1, n_jobs=-1,\n        )\n        m_clean.fit(X_tr_c, y_tr, eval_set=[(X_va_c, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_clean_oof[va_idx] = m_clean.predict_proba(X_va_c)[:, 1]\n        lgb_clean_test += m_clean.predict_proba(X_te_c)[:, 1] / 5.0\n        c_auc = roc_auc_score(y_va, lgb_clean_oof[va_idx])\n\n        print(f\"Fold {fold} ({time.time()-t_f:.0f}s) | PLR_NN: {best_auc:.5f} (ep {best_ep}, {nn_sec:.1f}s) | LGB_CleanPairs: {c_auc:.5f} (tree {m_clean.best_iteration_})\")\n        del X_tr_c, X_va_c, X_te_c, tr_te_clean, va_te_clean, te_te_clean\n        gc.collect()\n\n    np.savez(\"/kaggle/working/preds_exp4.npz\", nn_dig3_oof=nn_dig3_oof, nn_dig3_test=nn_dig3_test, lgb_clean_oof=lgb_clean_oof, lgb_clean_test=lgb_clean_test)\n    print(f\"Total Exp 4 runtime: {time.time() - t0_exp4:.1f}s\")\n\nprint(\"\\n--- Exp 4 Models (5-fold OOF AUC) ---\")\nprint(f\"PyTorch PLR WideResNet: {roc_auc_score(y, nn_dig3_oof):.5f}  (prev PyTorch MLP: {roc_auc_score(y, mlp_oof):.5f})\")\nprint(f\"LGB_CleanPairs (3L):    {roc_auc_score(y, lgb_clean_oof):.5f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:46.842767Z","iopub.execute_input":"2026-11-16T05:38:46.843409Z","iopub.status.idle":"2026-11-16T05:38:47.325456Z","shell.execute_reply.started":"2026-11-16T05:38:46.843384Z","shell.execute_reply":"2026-11-16T05:38:47.324817Z"}},"outputs":[{"name":"stdout","text":"\n--- Exp 4 Models (5-fold OOF AUC) ---\nPyTorch PLR WideResNet: 0.94866  (prev PyTorch MLP: 0.94609)\nLGB_CleanPairs (3L):    0.94959\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"# Step 13: Exp 5 (Option B) — 10-Fold Upgrade + Randomized extra_trees=True LightGBM\nimport gc\nimport time\nfrom scipy import sparse\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer, OneHotEncoder\n\ndef _signed_log1p_5(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef _safe_logit_5(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"lgb_dig2_10f_oof\" not in globals() or \"lgb_et_10f_oof\" not in globals() or \"glm_dig3_10f_oof\" not in globals():\n    t0_exp5 = time.time()\n    n_tr5 = len(X_dig2)\n    n_te5 = len(X_test_dig2)\n    lgb_dig2_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    lgb_dig2_10f_test = np.zeros(n_te5, dtype=np.float64)\n    lgb_et_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    lgb_et_10f_test = np.zeros(n_te5, dtype=np.float64)\n    glm_dig3_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    glm_dig3_10f_test = np.zeros(n_te5, dtype=np.float64)\n\n    # Prebuild Spline GLM Dig3 base arrays once\n    num5_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew5 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num5_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew5.add(c)\n    base5_tr = X_dig3[num5_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base5_te = X_test_dig3[num5_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num5_cols):\n        if c in log_skew5:\n            base5_tr[:, j] = _signed_log1p_5(base5_tr[:, j])\n            base5_te[:, j] = _signed_log1p_5(base5_te[:, j])\n    base5_tr = np.nan_to_num(base5_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base5_te = np.nan_to_num(base5_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline5_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline5_idx = [num5_cols.index(c) for c in spline5_cols]\n    top_nte5_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"flags_x_riskTens\", \"riskCount_x_cvv\", \"risk_x_auth\", \"riskTens_x_velTens\", \"flags_bitmask\"\n    ]\n    top_nte5_idx = [nte3_keys.index(k) for k in top_nte5_keys]\n\n    oh5_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh5_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh5_enc.fit_transform(X_dig3[oh5_cols].astype(str))\n    _oh_te = oh5_enc.transform(X_test_dig3[oh5_cols].astype(str))\n    oh5_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh5_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    skf10 = StratifiedKFold(n_splits=10, shuffle=True, random_state=77)\n    nte2_set = set(nte2_keys)\n    print(f\"Exp 5 (10-Fold + extra_trees) starting | X_dig2={X_dig2.shape} | X_dig3={X_dig3.shape}\")\n\n    for fold, (tr_idx, va_idx) in enumerate(skf10.split(X_dig2, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        tr_te2, va_te2, te_te2 = {}, {}, {}\n        tr_te3, va_te3, te_te3 = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_te = np.empty((n_te5, len(nte3_keys)), dtype=np.float32)\n\n        for j, col in enumerate(nte3_keys):\n            sm_val = 20.0 if col in nte2_set else 25.0\n            c_all = codes3_tr[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes3_te[col]\n            nc = ncats3[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + sm_val * global_prior) / (cnt + sm_val)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + sm_val * global_prior) / (cnt_f + sm_val)\n            va_vals = te_map_f[c_va].astype(np.float32)\n            te_vals = te_map_f[c_te].astype(np.float32)\n\n            if col in nte2_set:\n                k2 = f\"nte2_{col}\"\n                tr_te2[k2] = tr_vals\n                va_te2[k2] = va_vals\n                te_te2[k2] = te_vals\n            k3 = f\"nte3_{col}\"\n            tr_te3[k3] = tr_vals\n            va_te3[k3] = va_vals\n            te_te3[k3] = te_vals\n\n            nte_log_tr[:, j] = _safe_logit_5(tr_vals)\n            nte_log_va[:, j] = _safe_logit_5(va_vals)\n            nte_log_te[:, j] = _safe_logit_5(te_vals)\n\n        # 1) 10-Fold Shallow 3-Leaf LGB on X_dig2 + 47 NTE keys\n        X_tr_2 = pd.concat([X_dig2.iloc[tr_idx], pd.DataFrame(tr_te2, index=X_dig2.index[tr_idx])], axis=1)\n        X_va_2 = pd.concat([X_dig2.iloc[va_idx], pd.DataFrame(va_te2, index=X_dig2.index[va_idx])], axis=1)\n        X_te_2 = pd.concat([X_test_dig2, pd.DataFrame(te_te2, index=X_test_dig2.index)], axis=1)\n\n        m_dig2_10 = lgb.LGBMClassifier(\n            n_estimators=7000, learning_rate=0.045, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.7,\n            random_state=fold + 1000, verbose=-1, n_jobs=-1,\n        )\n        m_dig2_10.fit(X_tr_2, y_tr, eval_set=[(X_va_2, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(100, verbose=False)])\n        lgb_dig2_10f_oof[va_idx] = m_dig2_10.predict_proba(X_va_2)[:, 1]\n        lgb_dig2_10f_test += m_dig2_10.predict_proba(X_te_2)[:, 1] / 10.0\n        del X_tr_2, X_va_2, X_te_2, tr_te2, va_te2, te_te2\n\n        # 2) 10-Fold Randomized extra_trees=True LightGBM (num_leaves=4, max_depth=3) on X_dig3 + 75 NTE keys\n        X_tr_3 = pd.concat([X_dig3.iloc[tr_idx], pd.DataFrame(tr_te3, index=X_dig3.index[tr_idx])], axis=1)\n        X_va_3 = pd.concat([X_dig3.iloc[va_idx], pd.DataFrame(va_te3, index=X_dig3.index[va_idx])], axis=1)\n        X_te_3 = pd.concat([X_test_dig3, pd.DataFrame(te_te3, index=X_test_dig3.index)], axis=1)\n\n        m_et_10 = lgb.LGBMClassifier(\n            n_estimators=9000, learning_rate=0.045, num_leaves=4, max_depth=3,\n            extra_trees=True, min_child_samples=100, subsample=0.8, subsample_freq=1,\n            colsample_bytree=0.7, reg_alpha=0.5, reg_lambda=2.0,\n            random_state=fold + 2000, verbose=-1, n_jobs=-1,\n        )\n        m_et_10.fit(X_tr_3, y_tr, eval_set=[(X_va_3, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(100, verbose=False)])\n        lgb_et_10f_oof[va_idx] = m_et_10.predict_proba(X_va_3)[:, 1]\n        lgb_et_10f_test += m_et_10.predict_proba(X_te_3)[:, 1] / 10.0\n        del X_tr_3, X_va_3, X_te_3, tr_te3, va_te3, te_te3\n\n        # 3) 10-Fold Spline GLM on X_dig3 + 75 logit(NTE)\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base5_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base5_tr[va_idx], nte_log_va])), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(np.hstack([base5_te, nte_log_te])), -6.0, 6.0).astype(np.float32)\n\n        off = base5_tr.shape[1]\n        sp_tf = SplineTransformer(n_knots=7, degree=3, knots=\"uniform\", include_bias=False)\n        sp_tr = sp_tf.fit_transform(np.clip(np.hstack([x_tr_std[:, spline5_idx], x_tr_std[:, off + np.array(top_nte5_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_va = sp_tf.transform(np.clip(np.hstack([x_va_std[:, spline5_idx], x_va_std[:, off + np.array(top_nte5_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_te = sp_tf.transform(np.clip(np.hstack([x_te_std[:, spline5_idx], x_te_std[:, off + np.array(top_nte5_idx)]]), -4.0, 4.0)).astype(np.float32)\n\n        glm5 = LogisticRegression(C=0.2, solver=\"lbfgs\", max_iter=200, tol=1e-4)\n        glm5.fit(np.hstack([x_tr_std, sp_tr, oh5_all[tr_idx]]), y_tr_arr.astype(np.int32))\n        glm_dig3_10f_oof[va_idx] = glm5.predict_proba(np.hstack([x_va_std, sp_va, oh5_all[va_idx]]))[:, 1]\n        glm_dig3_10f_test += glm5.predict_proba(np.hstack([x_te_std, sp_te, oh5_te]))[:, 1] / 10.0\n\n        print(\n            f\"Fold {fold:2d}/10 ({time.time()-t_f:.0f}s) | LGB_3L_10F: {roc_auc_score(y_va, lgb_dig2_10f_oof[va_idx]):.5f} (t={m_dig2_10.best_iteration_}) \"\n            f\"| ET_10F: {roc_auc_score(y_va, lgb_et_10f_oof[va_idx]):.5f} (t={m_et_10.best_iteration_}) \"\n            f\"| GLM3_10F: {roc_auc_score(y_va, glm_dig3_10f_oof[va_idx]):.5f}\"\n        )\n        del x_tr_std, x_va_std, x_te_std, sp_tr, sp_va, sp_te, nte_log_tr, nte_log_va, nte_log_te\n        gc.collect()\n\n    np.savez(\n        \"/kaggle/working/preds_exp5.npz\",\n        lgb_dig2_10f_oof=lgb_dig2_10f_oof, lgb_dig2_10f_test=lgb_dig2_10f_test,\n        lgb_et_10f_oof=lgb_et_10f_oof, lgb_et_10f_test=lgb_et_10f_test,\n        glm_dig3_10f_oof=glm_dig3_10f_oof, glm_dig3_10f_test=glm_dig3_10f_test,\n    )\n    print(f\"Total Exp 5 runtime: {time.time() - t0_exp5:.1f}s\")\n\nprint(\"\\n--- Exp 5 (10-Fold + extra_trees) Overall OOF AUCs ---\")\nprint(f\"LGB_3L_Dig2_10F:  {roc_auc_score(y, lgb_dig2_10f_oof):.5f}\")\nprint(f\"LGB_ET_Dig3_10F:  {roc_auc_score(y, lgb_et_10f_oof):.5f}\")\nprint(f\"Spline_GLM3_10F:  {roc_auc_score(y, glm_dig3_10f_oof):.5f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:47.328306Z","iopub.execute_input":"2026-11-16T05:38:47.328645Z","iopub.status.idle":"2026-11-16T05:38:47.811882Z","shell.execute_reply.started":"2026-11-16T05:38:47.328616Z","shell.execute_reply":"2026-11-16T05:38:47.81103Z"}},"outputs":[{"name":"stdout","text":"\n--- Exp 5 (10-Fold + extra_trees) Overall OOF AUCs ---\nLGB_3L_Dig2_10F:  0.95012\nLGB_ET_Dig3_10F:  0.94966\nSpline_GLM3_10F:  0.94974\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"# Step 14: Option A — Context-Aware 2nd-Level Meta-Stacker (Dynamic Regime Weights + Tail Splines + GBDT Stacker)\nfrom scipy.special import expit, logit\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer\nfrom sklearn.model_selection import StratifiedKFold\n\ncand_models = [\n    (\"LGB_3L_Dig2_10F\", lgb_dig2_10f_oof, lgb_dig2_10f_test),\n    (\"LGB_ET_Dig3_10F\", lgb_et_10f_oof, lgb_et_10f_test),\n    (\"Spline_GLM3_10F\", glm_dig3_10f_oof, glm_dig3_10f_test),\n    (\"LGB_CleanPairs\",  lgb_clean_oof,    lgb_clean_test),\n    (\"PLR_WideResNet\",  nn_dig3_oof,      nn_dig3_test),\n    (\"LGB_3L_Dig3\",     lgb_dig3_oof,     lgb_dig3_test),\n    (\"XGB_Dig3\",        xgb_dig3_oof,     xgb_dig3_test),\n    (\"CB_Dig3\",         cb_dig3_oof,      cb_dig3_test),\n    (\"Shallow_LGB_Dig\", lgb_shallow_oof,  lgb_shallow_test),\n    (\"PyTorch_MLP\",     mlp_oof,          mlp_test),\n]\nfor _nm, _oof, _te in [\n    (\"Shallow_3L_Dig2\", lgb_dig2_oof, lgb_dig2_test),\n    (\"Spline_GLM_Dig3\", glm_dig3_oof, glm_dig3_test),\n]:\n    if _oof.max() > 0 and not np.allclose(_oof, 0.5 * lgb_dig3_oof + 0.5 * xgb_dig3_oof):\n        cand_models.append((_nm, _oof, _te))\n\ncand_models = [m for m in cand_models if np.std(m[1]) > 0 and m[0] not in ('XGB_Dig3', 'CB_Dig3', 'Shallow_LGB_Dig')]\nnames = [m[0] for m in cand_models]\noofs  = [m[1] for m in cand_models]\ntests = [m[2] for m in cand_models]\n\nprob_mat = np.column_stack(oofs)\nprob_te  = np.column_stack(tests)\nlogit_mat = logit(np.clip(prob_mat, 1e-6, 1.0 - 1e-6))\nlogit_te  = logit(np.clip(prob_te, 1e-6, 1.0 - 1e-6))\n\nprint(\"=== Active Base Model OOF AUCs ===\")\nfor n, p in zip(names, oofs):\n    print(f\"  {n:16s}: {roc_auc_score(y, p):.5f}\")\n\n# 1) Static Logit & Prob Blend Baseline\nrng = np.random.default_rng(42)\nW = np.vstack([np.eye(len(oofs)), rng.dirichlet(np.ones(len(oofs)), size=25)])\nbest_prob_auc, best_prob_w = max(((roc_auc_score(y, prob_mat @ w), w) for w in W), key=lambda t: t[0])\nbest_log_auc, best_log_w = max(((roc_auc_score(y, logit_mat @ w), w) for w in W), key=lambda t: t[0])\n\ndef polish_weights(mat, y_target, w_init, steps=3):\n    w = w_init.copy()\n    best = roc_auc_score(y_target, mat @ w)\n    for delta in ([0.02] if globals().get('SKIP_SUPERSEDED', False) else [0.04, 0.015, 0.005, 0.002]):\n        for _ in range(steps):\n            for i in range(len(w)):\n                for sign in [-1.0, 1.0]:\n                    cand = w.copy()\n                    cand[i] = max(0.0, cand[i] + sign * delta)\n                    if cand.sum() == 0:\n                        continue\n                    cand /= cand.sum()\n                    score = roc_auc_score(y_target, mat @ cand)\n                    if score > best:\n                        best = score\n                        w = cand\n    return best, w\n\nbest_prob_auc, best_prob_w = polish_weights(prob_mat, y, best_prob_w)\nbest_log_auc, best_log_w = polish_weights(logit_mat, y, best_log_w)\nstatic_oof_logit = logit_mat @ best_log_w\nstatic_te_logit  = logit_te @ best_log_w\n\n# 2) Build Context-Aware Meta-Features for 2nd-Level Stacking\ndef build_meta_features(L_mat, df_ctx):\n    idx_tree = [i for i, n in enumerate(names) if n.startswith((\"LGB\", \"XGB\", \"CB\", \"Shallow\"))]\n    idx_glm  = [i for i, n in enumerate(names) if \"GLM\" in n]\n    idx_nn   = [i for i, n in enumerate(names) if n in (\"PLR_WideResNet\", \"PyTorch_MLP\")]\n\n    tree_mean = L_mat[:, idx_tree].mean(axis=1, keepdims=True)\n    glm_mean  = L_mat[:, idx_glm].mean(axis=1, keepdims=True)\n    nn_mean   = L_mat[:, idx_nn].mean(axis=1, keepdims=True)\n\n    diff_tree_glm = L_mat[:, 0:1] - glm_mean\n    diff_tree_nn  = L_mat[:, 0:1] - nn_mean\n    diff_glm_nn   = glm_mean - nn_mean\n    std_all       = L_mat.std(axis=1, keepdims=True)\n    max_all       = L_mat.max(axis=1, keepdims=True)\n    min_all       = L_mat.min(axis=1, keepdims=True)\n    span_all      = max_all - min_all\n\n    ctx_cols = [\n        \"risk_flag_count\", \"merchant_risk_score\", \"velocity_score\",\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"cvv_retry_count\", \"prior_disputes\", \"txn_count_last_24h\",\n        \"is_foreign_transaction\", \"used_vpn\", \"ip_country_mismatch\", \"is_ai_generated_scam_attempt\"\n    ]\n    C_raw = df_ctx[ctx_cols].to_numpy(dtype=np.float32, na_value=0.0)\n\n    inter_terms = []\n    for k in range(6):\n        c_col = C_raw[:, k:k+1]\n        inter_terms.append(diff_tree_glm * c_col)\n        inter_terms.append(diff_tree_nn * c_col)\n        inter_terms.append(L_mat[:, 0:1] * c_col)\n    inter_mat = np.hstack(inter_terms)\n\n    return np.hstack([\n        L_mat, tree_mean, glm_mean, nn_mean,\n        diff_tree_glm, diff_tree_nn, diff_glm_nn,\n        std_all, max_all, min_all, span_all,\n        C_raw, inter_mat\n    ]).astype(np.float32)\n\nM_tr = build_meta_features(logit_mat, X_dig3)\nM_te = build_meta_features(logit_te, X_test_dig3)\n\nmeta_skf = StratifiedKFold(n_splits=10, shuffle=True, random_state=2026)\nmeta_lr_oof  = np.zeros(len(y), dtype=np.float64)\nmeta_lr_test = np.zeros(len(X_test_dig3), dtype=np.float64)\nmeta_lgb_oof  = np.zeros(len(y), dtype=np.float64)\nmeta_lgb_test = np.zeros(len(X_test_dig3), dtype=np.float64)\n\ny_meta_arr = y.values.astype(np.int32)\n\nfor fold, (tr_idx, va_idx) in ([] if globals().get('SKIP_SUPERSEDED', False) else enumerate(meta_skf.split(M_tr, y_meta_arr))):\n    sc = StandardScaler()\n    mtr = np.clip(sc.fit_transform(M_tr[tr_idx]), -6.0, 6.0)\n    mva = np.clip(sc.transform(M_tr[va_idx]), -6.0, 6.0)\n    mte = np.clip(sc.transform(M_te), -6.0, 6.0)\n\n    sp = SplineTransformer(n_knots=5, degree=2, knots=\"uniform\", include_bias=False)\n    sp_tr = sp.fit_transform(np.clip(mtr[:, :len(names)], -4.5, 4.5))\n    sp_va = sp.transform(np.clip(mva[:, :len(names)], -4.5, 4.5))\n    sp_te = sp.transform(np.clip(mte[:, :len(names)], -4.5, 4.5))\n\n    X_m_tr = np.hstack([mtr, sp_tr])\n    X_m_va = np.hstack([mva, sp_va])\n    X_m_te = np.hstack([mte, sp_te])\n\n    mlr = LogisticRegression(C=0.05, solver=\"lbfgs\", max_iter=300, tol=1e-4)\n    mlr.fit(X_m_tr, y_meta_arr[tr_idx])\n    meta_lr_oof[va_idx] = mlr.predict_proba(X_m_va)[:, 1]\n    meta_lr_test += mlr.predict_proba(X_m_te)[:, 1] / 10.0\n\n    mlgb = lgb.LGBMClassifier(\n        n_estimators=1200, learning_rate=0.015, num_leaves=3, max_depth=2,\n        min_child_samples=500, subsample=0.8, subsample_freq=1, colsample_bytree=0.7,\n        reg_alpha=5.0, reg_lambda=25.0, random_state=fold + 500, verbose=-1, n_jobs=-1,\n    )\n    mlgb.fit(\n        M_tr[tr_idx], y_meta_arr[tr_idx],\n        eval_set=[(M_tr[va_idx], y_meta_arr[va_idx])],\n        eval_metric=\"auc\", callbacks=[lgb.early_stopping(80, verbose=False)]\n    )\n    meta_lgb_oof[va_idx] = mlgb.predict_proba(M_tr[va_idx])[:, 1]\n    meta_lgb_test += mlgb.predict_proba(M_te)[:, 1] / 10.0\n\nif np.std(meta_lr_oof) == 0:\n    meta_lr_oof, meta_lr_test = expit(static_oof_logit), expit(static_te_logit)\n    meta_lgb_oof, meta_lgb_test = expit(static_oof_logit), expit(static_te_logit)\nmeta_lr_auc  = roc_auc_score(y, meta_lr_oof)\nmeta_lgb_auc = roc_auc_score(y, meta_lgb_oof)\n\nstack_oofs = np.column_stack([\n    static_oof_logit,\n    logit(np.clip(meta_lr_oof, 1e-6, 1.0 - 1e-6)),\n    logit(np.clip(meta_lgb_oof, 1e-6, 1.0 - 1e-6)),\n])\nstack_tes = np.column_stack([\n    static_te_logit,\n    logit(np.clip(meta_lr_test, 1e-6, 1.0 - 1e-6)),\n    logit(np.clip(meta_lgb_test, 1e-6, 1.0 - 1e-6)),\n])\n\nbest_stack_auc = -1.0\nbest_stack_w = np.array([1.0, 0.0, 0.0])\nfor a in ([1.0] if globals().get('SKIP_SUPERSEDED', False) else np.linspace(0.0, 1.0, 51)):\n    for b in np.linspace(0.0, 1.0 - a, 51):\n        c = max(0.0, 1.0 - a - b)\n        w = np.array([a, b, c])\n        auc = roc_auc_score(y, stack_oofs @ w)\n        if auc > best_stack_auc:\n            best_stack_auc = auc\n            best_stack_w = w\n\nprint(\"\\n=== Ensemble & Meta-Stacker Comparison (OOF AUC) ===\")\nprint(f\"  Static Prob  Blend:              {best_prob_auc:.5f}\")\nprint(f\"  Static Logit Blend:              {best_log_auc:.5f}\")\nprint(f\"  Meta-LogReg (Context + Spline):  {meta_lr_auc:.5f}\")\nprint(f\"  Meta-LGB    (Regime GBDT):       {meta_lgb_auc:.5f}\")\nprint(f\"  FINAL Combined Meta-Stacker:     {best_stack_auc:.5f}  (weights: Static={best_stack_w[0]:.2f}, MetaLR={best_stack_w[1]:.2f}, MetaLGB={best_stack_w[2]:.2f})\")\n\nprint(\"\\nStatic Logit Blend Weights:\")\nfor n, w in zip(names, best_log_w):\n    print(f\"  {n:16s}: {w:.3f}\")\n\nfinal_test = expit(stack_tes @ best_stack_w)\nsub = pd.DataFrame({\"id\": test[\"id\"], \"is_fraud\": final_test})\nsub.to_csv(\"submission.csv\", index=False)\nsub.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:38:47.813115Z","iopub.execute_input":"2026-11-16T05:38:47.813528Z","iopub.status.idle":"2026-11-16T05:39:29.547666Z","shell.execute_reply.started":"2026-11-16T05:38:47.813504Z","shell.execute_reply":"2026-11-16T05:39:29.546934Z"}},"outputs":[{"name":"stdout","text":"=== Active Base Model OOF AUCs ===\n  LGB_3L_Dig2_10F : 0.95012\n  LGB_ET_Dig3_10F : 0.94966\n  Spline_GLM3_10F : 0.94974\n  LGB_CleanPairs  : 0.94959\n  PLR_WideResNet  : 0.94866\n  LGB_3L_Dig3     : 0.94958\n  PyTorch_MLP     : 0.94609\n\n=== Ensemble & Meta-Stacker Comparison (OOF AUC) ===\n  Static Prob  Blend:              0.95047\n  Static Logit Blend:              0.95049\n  Meta-LogReg (Context + Spline):  0.95049\n  Meta-LGB    (Regime GBDT):       0.95049\n  FINAL Combined Meta-Stacker:     0.95049  (weights: Static=1.00, MetaLR=0.00, MetaLGB=0.00)\n\nStatic Logit Blend Weights:\n  LGB_3L_Dig2_10F : 0.398\n  LGB_ET_Dig3_10F : 0.115\n  Spline_GLM3_10F : 0.173\n  LGB_CleanPairs  : 0.144\n  PLR_WideResNet  : 0.068\n  LGB_3L_Dig3     : 0.063\n  PyTorch_MLP     : 0.038\n","output_type":"stream"},{"execution_count":15,"output_type":"execute_result","data":{"text/plain":"       id  is_fraud\n0  699960  0.000214\n1  699961  0.000096\n2  699962  0.074899\n3  699963  0.001689\n4  699964  0.000862","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>id</th>\n      <th>is_fraud</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>699960</td>\n      <td>0.000214</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>699961</td>\n      <td>0.000096</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>699962</td>\n      <td>0.074899</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>699963</td>\n      <td>0.001689</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>699964</td>\n      <td>0.000862</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":15},{"cell_type":"code","source":"# ==============================================================================\n# Step 15: Exp 7 — 92-Key Per-Value/Digit-Trie/GPT2-Token + Pooled Token GLM\n#          + Residual GLM-Boosted LightGBM & GPU XGBoost + 100%-Data Full Refit\n# ==============================================================================\nimport os, glob, gc, time, warnings\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\nimport xgboost as xgb\nfrom scipy.stats import rankdata\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nwarnings.filterwarnings(\"ignore\")\n\nT0_EXP7 = time.time()\ndef log7(*a):\n    print(f\"[{time.time() - T0_EXP7:6.1f}s]\", *a, flush=True)\n\ndef find_csv(name, hint=\"\"):\n    hits = sorted(glob.glob(os.path.join(\"/kaggle/input\", \"**\", name), recursive=True))\n    hits = [h for h in hits if hint in h] or hits\n    return hits[0] if hits else None\n\nTARGET = \"is_fraud\"\nCATS7 = [\"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"]\nFLAGS7 = [\"is_foreign_transaction\", \"is_new_merchant\", \"used_vpn\",\n          \"ip_country_mismatch\", \"billing_shipping_mismatch\", \"is_ai_generated_scam_attempt\"]\nNUMS7 = [\"amount_usd\", \"hours_since_last_txn\", \"txn_count_last_24h\", \"distance_from_home_km\",\n         \"card_age_months\", \"customer_age\", \"account_balance_usd\", \"cvv_retry_count\",\n         \"velocity_score\", \"time_of_day_hour\", \"day_of_week\", \"merchant_risk_score\", \"prior_disputes\"]\nFEATS7 = NUMS7 + FLAGS7 + CATS7\nFLOATS7 = [\"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\", \"account_balance_usd\",\n           \"velocity_score\", \"merchant_risk_score\"]\n\ntr_path = find_csv(\"train.csv\", \"s6e11\") or find_csv(\"train.csv\")\nte_path = find_csv(\"test.csv\", \"s6e11\") or find_csv(\"test.csv\")\ntr7 = pd.read_csv(tr_path)\nte7 = pd.read_csv(te_path)\nfor _df in (tr7, te7):\n    _df[FLAGS7] = _df[FLAGS7].astype(\"int8\")\n\ny7 = tr7[TARGET].astype(int).values\nNTR7, NTE7 = len(tr7), len(te7)\nfull7 = pd.concat([tr7[FEATS7], te7[FEATS7]], ignore_index=True)\n\n# 1. Build 92-Key Matrix: 24 Exact Per-Value + 36 Digit-Trie + 24 GPT-2 Token + 8 Joint Keys\ndef build_key_table(df):\n    K = {}\n    for c in FEATS7:\n        K[f\"v_{c}\"] = df[c].astype(str).values if c in CATS7 else df[c].values\n    for c in FLOATS7:\n        x = df[c].values\n        K[f\"cents_{c}\"] = (np.round(x * 100) % 100).astype(np.int64)\n        K[f\"int_{c}\"] = np.floor(x).astype(np.int64)\n        K[f\"ten_{c}\"] = np.floor(x / 10).astype(np.int64)\n        K[f\"dec_{c}\"] = np.floor(x * 10 + 1e-6).astype(np.int64)\n    for c in FLOATS7:\n        i = pd.Series(np.floor(df[c].values).astype(np.int64)).astype(str)\n        K[f\"l1_{c}\"] = (i.str.len() * 10 + i.str[0].astype(int)).values\n        K[f\"l2_{c}\"] = (i.str.len() * 100 + i.str[:2].astype(int)).values\n    return K\n\nSTR7, TOK7 = None, None\ndef build_token_keys():\n    global STR7, TOK7\n    try:\n        from tokenizers import Tokenizer\n        gpt2 = Tokenizer.from_pretrained(\"gpt2\")\n    except Exception as e:\n        log7(f\"GPT-2 tokenizer unavailable ({type(e).__name__}), using regex BPE-like digit-pair split fallback\")\n        gpt2 = None\n    STR7 = pd.concat([\n        pd.read_csv(tr_path, usecols=FLOATS7, dtype=str),\n        pd.read_csv(te_path, usecols=FLOATS7, dtype=str)\n    ], ignore_index=True)\n    TOK7, K = {}, {}\n    for c in FLOATS7:\n        uniq = STR7[c].unique()\n        if gpt2 is not None:\n            tok_map = {v: gpt2.encode(\" \" + v).tokens for v in uniq}\n        else:\n            def _fallback_tok(v):\n                parts = v.split(\".\")\n                int_p = parts[0]\n                chunks = [int_p[max(0, k-2):k] for k in range(len(int_p), 0, -2)][::-1]\n                if len(parts) > 1:\n                    chunks += [\".\", parts[1]]\n                return chunks\n            tok_map = {v: _fallback_tok(v) for v in uniq}\n        p = TOK7[c] = STR7[c].map(tok_map)\n        K[f\"t1_{c}\"] = p.str[0].values\n        K[f\"t2_{c}\"] = p.map(lambda t: t[1] if len(t) > 1 else \"\").values\n        K[f\"tl_{c}\"] = p.str[-1].values\n        K[f\"tn_{c}\"] = p.str.len().values\n    return K\n\nKEYS7 = build_key_table(full7)\nKEYS7.update(build_token_keys())\nKNAMES7 = list(KEYS7)\ncodes7 = [pd.factorize(pd.Series(KEYS7[n]))[0].astype(np.int32) for n in KNAMES7]\nKMAT7 = np.column_stack(codes7)\nNCAT7 = np.array([c.max() + 1 for c in codes7])\ndel KEYS7, codes7\nNBASE7 = KMAT7.shape[1]\n\n# 8 Non-Additive Joint Keys verified by deviance & likelihood-ratio G test\nJOINT7 = [\n    (\"j_category_risk\", (\"merchant_category\", \"merchant_risk_score\")),\n    (\"j_foreign_ip\", (\"is_foreign_transaction\", \"ip_country_mismatch\")),\n    (\"j_category_amount\", (\"merchant_category\", \"q:amount_usd\")),\n    (\"j_txn_velocity\", (\"txn_count_last_24h\", \"q:velocity_score\")),\n    (\"j_category_age\", (\"merchant_category\", \"customer_age\")),\n    (\"j_amount_risk\", (\"q:amount_usd\", \"q:merchant_risk_score\")),\n    (\"j_hours_velocity\", (\"q:hours_since_last_txn\", \"q:velocity_score\")),\n    (\"j_age_risk\", (\"customer_age\", \"q:merchant_risk_score\")),\n]\ndef joint_col7(df, c):\n    return pd.qcut(df[c[2:]], 10, labels=False, duplicates=\"drop\") if c.startswith(\"q:\") else df[c]\ndef joint_code7(df, cols):\n    k = np.zeros(len(df), np.int64)\n    for c in cols:\n        u = pd.factorize(joint_col7(df, c))[0]\n        k = k * (u.max() + 1) + u\n    return pd.factorize(k)[0].astype(np.int32)\n\nJCODES7 = [joint_code7(full7, cols) for _, cols in JOINT7]\nKMAT7 = np.column_stack([KMAT7] + JCODES7)\nNCAT7 = np.append(NCAT7, [jc.max() + 1 for jc in JCODES7])\nKNAMES7 += [name for name, _ in JOINT7]\n\n# Key Value Counts across train + test (reliability weight of each key's fraud rate)\nKCNT7 = np.column_stack([np.bincount(KMAT7[:, j])[KMAT7[:, j]] for j in range(KMAT7.shape[1])]).astype(np.float32)\nCNT7 = np.column_stack([full7[c].map(full7[c].value_counts()).values for c in NUMS7]).astype(np.float32)\n\n# Raw view: 24 columns + 6 cents columns\nRAW7 = full7[NUMS7 + FLAGS7].copy()\nfor c in CATS7:\n    RAW7[c] = pd.factorize(full7[c], sort=True)[0].astype(np.int16)\nfor c in FLOATS7:\n    RAW7[f\"cents_{c}\"] = (np.round(full7[c].values * 100) % 100).astype(np.int16)\nRAWV7 = RAW7.values.astype(np.float32)\nCAT_IDX7 = [list(RAW7.columns).index(c) for c in CATS7]\nlog7(f\"Built KMAT7: {KMAT7.shape[1]} keys ({NBASE7} base + {len(JOINT7)} joint), RAWV7: {RAWV7.shape[1]} cols\")\n\n# 2. Cross-Field Pooled Token Encoding (gen_encode) & Fast bincount Target Encoding\nPOOL2 = [\"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\", \"account_balance_usd\"]\nPOOL1 = [\"velocity_score\", \"merchant_risk_score\"]\nGEN7 = TOK7 is not None and STR7 is not None\nif GEN7:\n    dec_fn = lambda c: STR7[c].str.split(\".\").str[1].fillna(\"0\").astype(str)\n    lit_fn = lambda c: TOK7[c].map(lambda t: t[t.index(\".\") - 1] if \".\" in t else t[-1])\n    GROUPS7 = []\n    for mem, fn in [(POOL2, dec_fn), (POOL2, lambda c: dec_fn(c).str[0]), (POOL1, dec_fn), (POOL1, lit_fn)]:\n        v = pd.concat([fn(c) for c in mem], ignore_index=True)\n        GROUPS7.append(pd.factorize(v)[0].astype(np.int32).reshape(len(mem), -1).T.copy())\n    MARKOV7 = [pd.factorize(lit_fn(c) + \"|\" + dec_fn(c))[0].astype(np.int32) for c in POOL2]\n\ndef gen_encode7(i, o, m0=50.0, m1=2000.0, m2=200.0):\n    yi = y7[i].astype(np.float64)\n    prior, cols, field0 = yi.mean(), [], []\n    for g, C in enumerate(GROUPS7):\n        ncat = int(C.max()) + 1\n        s = [np.bincount(C[i, j], weights=yi, minlength=ncat) for j in range(C.shape[1])]\n        n = [np.bincount(C[i, j], minlength=ncat) for j in range(C.shape[1])]\n        pool = (sum(s) + prior * m0) / (sum(n) + m0)\n        for j in range(C.shape[1]):\n            h = ((s[j] + m1 * pool) / (n[j] + m1))[C[o, j]]\n            cols.append(h)\n            if g == 0:\n                field0.append(h)\n    for j, M in enumerate(MARKOV7):\n        ncat = int(M.max()) + 1\n        s, n = np.bincount(M[i], weights=yi, minlength=ncat), np.bincount(M[i], minlength=ncat)\n        cols.append((s[M[o]] + m2 * field0[j]) / (n[M[o]] + m2))\n    return np.column_stack(cols).astype(np.float32)\n\ndef gen_fold7(a, b, inner=5, seed=0):\n    Ga = None\n    for i, o in StratifiedKFold(inner, shuffle=True, random_state=seed).split(np.zeros(len(a)), y7[a]):\n        E = gen_encode7(a[i], a[o])\n        Ga = np.zeros((len(a), E.shape[1]), np.float32) if Ga is None else Ga\n        Ga[o] = E\n    tail = np.concatenate([b, np.arange(NTR7, NTR7 + NTE7)]) if len(b) else np.arange(NTR7, NTR7 + NTE7)\n    E = gen_encode7(a, tail)\n    return Ga, (E[:len(b)] if len(b) else None), E[len(b):]\n\ndef te_rate7(k, t, ncat, prior, smooth):\n    s = np.bincount(k, weights=t, minlength=ncat)\n    n = np.bincount(k, minlength=ncat)\n    return (s + prior * smooth) / (n + smooth)\n\ndef te_fold7(a, b, smooth=20.0, inner=5, seed=0):\n    ya = y7[a].astype(np.float64)\n    Ka, Kt = KMAT7[a], KMAT7[NTR7:]\n    Kb = KMAT7[b] if len(b) else None\n    Ea = np.zeros(Ka.shape, np.float32)\n    Eb = np.zeros(Kb.shape, np.float32) if len(b) else None\n    Et = np.zeros(Kt.shape, np.float32)\n    inner_f = list(StratifiedKFold(inner, shuffle=True, random_state=seed).split(np.zeros(len(a)), ya))\n    for j in range(KMAT7.shape[1]):\n        for i, o in inner_f:\n            Ea[o, j] = te_rate7(Ka[i, j], ya[i], NCAT7[j], ya[i].mean(), smooth)[Ka[o, j]]\n        r = te_rate7(Ka[:, j], ya, NCAT7[j], ya.mean(), smooth)\n        if len(b):\n            Eb[:, j] = r[Kb[:, j]]\n        Et[:, j] = r[Kt[:, j]]\n    return Ea, Eb, Et\n\ndef logit7(p):\n    p = np.clip(p, 1e-6, 1 - 1e-6)\n    return np.log(p / (1 - p))\n\n# 3. GLM Design Matrices (Plain + Count-Aware + Standardized Log-Numerics)\nnum7 = full7[NUMS7].astype(float).copy()\nfor c in (\"amount_usd\", \"account_balance_usd\", \"hours_since_last_txn\"):\n    num7[c] = np.log1p(np.maximum(0.0, num7[c]))\nZNUM7 = StandardScaler().fit_transform(num7).astype(np.float32)\nONEHOT7 = pd.get_dummies(full7[CATS7].astype(str), dtype=np.float32).values\nBASE7 = np.hstack([ZNUM7, full7[FLAGS7].values.astype(np.float32), ONEHOT7])\nLOGC7 = np.log1p(KCNT7)\nBASEC7 = np.hstack([BASE7, (LOGC7 - LOGC7.mean(0)) / (LOGC7.std(0) + 1e-6)])\n\n# Load or initialize Exp 7 checkpoint cache\nEXP7_CACHE_FILE = \"preds_exp7_glmboost.npz\"\nOOF7, FOLDAVG7, REFIT7, PRED7 = {}, {}, {}, {}\nif os.path.exists(EXP7_CACHE_FILE):\n    _c7 = np.load(EXP7_CACHE_FILE)\n    for _k in _c7.files:\n        if _k.startswith(\"oof_\"):\n            OOF7[_k[4:]] = _c7[_k]\n        elif _k.startswith(\"foldavg_\"):\n            FOLDAVG7[_k[8:]] = _c7[_k]\n        elif _k.startswith(\"refit_\"):\n            REFIT7[_k[6:]] = _c7[_k]\n        elif _k.startswith(\"pred_\"):\n            PRED7[_k[5:]] = _c7[_k]\n    log7(f\"Loaded Exp 7 cache with members: {list(OOF7.keys())}\")\n\ndef save_exp7_cache():\n    payload = {}\n    for k in OOF7:\n        payload[f\"oof_{k}\"] = OOF7[k].astype(np.float32)\n        payload[f\"foldavg_{k}\"] = FOLDAVG7[k].astype(np.float32)\n        payload[f\"refit_{k}\"] = REFIT7[k].astype(np.float32)\n        payload[f\"pred_{k}\"] = PRED7[k].astype(np.float32)\n    np.savez_compressed(EXP7_CACHE_FILE, **payload)\n\ndef finish7(name, oof, foldavg, refit):\n    OOF7[name], FOLDAVG7[name], REFIT7[name] = oof, foldavg, refit\n    # Rank average of fold-average and 100%-data full refit\n    PRED7[name] = (rankdata(foldavg) + rankdata(refit)) / (2.0 * NTE7)\n    sp = pd.Series(foldavg).corr(pd.Series(refit), method=\"spearman\")\n    log7(f\"==> {name}: OOF AUC {roc_auc_score(y7, oof):.6f} | foldavg vs refit spearman {sp:.4f}\")\n    save_exp7_cache()\n\n# 4. Run 10-Fold Suite (90%-Data Encodings + Pooled Token GLMs + Residual Boosted GPU XGB & CPU LGB)\nFOLDS10 = list(StratifiedKFold(10, shuffle=True, random_state=42).split(np.zeros(NTR7), y7))\nALL7 = (np.arange(NTR7), np.arange(0, dtype=int))\n\nLGB7_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.04, num_leaves=4, min_child_samples=100,\n    subsample=0.8, subsample_freq=1, colsample_bytree=0.5, reg_lambda=1.0,\n    max_bin=255, force_col_wise=True, verbose=-1, n_jobs=4\n)\nXGB7_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.03, max_depth=2, min_child_weight=5,\n    subsample=0.8, colsample_bytree=0.5, reg_lambda=1.0, max_bin=256,\n    tree_method=\"hist\", device=\"cuda\", eval_metric=\"auc\", early_stopping_rounds=180\n)\n\ndef boost_view7(view, idx, E):\n    if view == \"raw\":\n        return np.hstack([RAWV7[idx], CNT7[idx], KCNT7[idx]])\n    elif view == \"base\":\n        return np.hstack([RAWV7[idx], E[:, :NBASE7], KCNT7[idx, :NBASE7]])\n    return np.hstack([RAWV7[idx], E, KCNT7[idx]])\n\ndef fit_glm_pair(Ea, Eb, Et, a, b, seed=0):\n    if GEN7:\n        Ga, Gb, Gt = gen_fold7(a, b, seed=seed)\n        Ea_g = np.hstack([Ea, Ga])\n        Eb_g = np.hstack([Eb, Gb]) if Eb is not None else None\n        Et_g = np.hstack([Et, Gt])\n    else:\n        Ea_g, Eb_g, Et_g = Ea, Eb, Et\n    sc = StandardScaler().fit(logit7(Ea_g))\n    Za = sc.transform(logit7(Ea_g))\n    Zt = sc.transform(logit7(Et_g))\n    Zb = sc.transform(logit7(Eb_g)) if Eb_g is not None else None\n    out = {}\n    for gname, B in [(\"glm_gen\", BASE7), (\"glm_cnt\", BASEC7)]:\n        Xa = np.hstack([Za, B[a]])\n        Xt = np.hstack([Zt, B[NTR7:]])\n        m = LogisticRegression(C=0.3, max_iter=300, tol=1e-7, solver=\"newton-cholesky\").fit(Xa, y7[a])\n        za = m.decision_function(Xa)\n        zt = m.decision_function(Xt)\n        zb = m.decision_function(np.hstack([Zb, B[b]])) if Zb is not None else None\n        out[gname] = (za, zb, zt)\n    return out\n\ndef boost_fit7(kind, Xa, ya, za, n_trees=None, Xb=None, yb=None, zb=None, seed=42):\n    if kind == \"lgb\":\n        P = {**LGB7_PARAMS, \"random_state\": seed}\n        if n_trees:\n            P[\"n_estimators\"] = n_trees\n            m = lgb.LGBMClassifier(**P)\n            return m.fit(Xa, ya, init_score=za, categorical_feature=CAT_IDX7), n_trees\n        m = lgb.LGBMClassifier(**P)\n        m.fit(Xa, ya, init_score=za, eval_set=[(Xb, yb)], eval_init_score=[zb], eval_metric=\"auc\",\n              categorical_feature=CAT_IDX7, callbacks=[lgb.early_stopping(150, verbose=False)])\n        return m, m.best_iteration_\n    else:\n        P = {**XGB7_PARAMS, \"random_state\": seed}\n        if n_trees:\n            P = {k: v for k, v in P.items() if k != \"early_stopping_rounds\"}\n            P[\"n_estimators\"] = n_trees\n            m = xgb.XGBClassifier(**P)\n            return m.fit(Xa, ya, base_margin=za), n_trees\n        m = xgb.XGBClassifier(**P)\n        m.fit(Xa, ya, base_margin=za, eval_set=[(Xb, yb)], base_margin_eval_set=[zb], verbose=False)\n        return m, m.best_iteration + 1\n\ndef boost_margin7(m, X, z, it=None):\n    if isinstance(m, lgb.LGBMClassifier):\n        return z + m.predict(X, raw_score=True)\n    return m.predict(X, base_margin=z, output_margin=True, iteration_range=(0, it) if it else None)\n\n# --- 4A. 10-Fold Pipeline: Encode once per fold, fit GLMs + GPU XGB boosters + CPU LGB booster ---\nneed_10f = [m for m in [\"glm10_gen\", \"glm10_cnt\", \"gb10_xgb_s0\", \"gb10_cnt_xgb_s0\", \"gb10_lgb_s0\", \"xgb10_te20\"] if m not in OOF7]\nif need_10f:\n    log7(f\"Running 10-Fold GLM + Residual Boosters for: {need_10f}\")\n    oof_d = {m: np.zeros(NTR7) for m in need_10f}\n    pred_d = {m: np.zeros(NTE7) for m in need_10f}\n    its_d = {m: [] for m in need_10f if not m.startswith(\"glm\")}\n    test_idx = np.arange(NTR7, NTR7 + NTE7)\n\n    for f, (a, b) in enumerate(FOLDS10):\n        t_f = time.time()\n        Ea, Eb, Et = te_fold7(a, b, smooth=20.0, inner=5, seed=0)\n        glms = fit_glm_pair(Ea, Eb, Et, a, b, seed=0)\n\n        if \"glm10_gen\" in oof_d:\n            oof_d[\"glm10_gen\"][b] = glms[\"glm_gen\"][1]\n            pred_d[\"glm10_gen\"] += glms[\"glm_gen\"][2] / 10.0\n        if \"glm10_cnt\" in oof_d:\n            oof_d[\"glm10_cnt\"][b] = glms[\"glm_cnt\"][1]\n            pred_d[\"glm10_cnt\"] += glms[\"glm_cnt\"][2] / 10.0\n\n        Xa_j = boost_view7(\"joint\", a, Ea)\n        Xb_j = boost_view7(\"joint\", b, Eb)\n        Xt_j = boost_view7(\"joint\", test_idx, Et)\n\n        if \"gb10_xgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=42)\n            its_d[\"gb10_xgb_s0\"].append(it)\n            oof_d[\"gb10_xgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_xgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"gb10_cnt_xgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_cnt\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its_d[\"gb10_cnt_xgb_s0\"].append(it)\n            oof_d[\"gb10_cnt_xgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_cnt_xgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"gb10_lgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"lgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=42)\n            its_d[\"gb10_lgb_s0\"].append(it)\n            oof_d[\"gb10_lgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_lgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"xgb10_te20\" in oof_d:\n            Xa_b = boost_view7(\"base\", a, Ea)\n            Xb_b = boost_view7(\"base\", b, Eb)\n            Xt_b = boost_view7(\"base\", test_idx, Et)\n            P_plain = {**XGB7_PARAMS, \"learning_rate\": 0.03, \"random_state\": 42}\n            m = xgb.XGBClassifier(**P_plain)\n            m.fit(Xa_b, y7[a], eval_set=[(Xb_b, y7[b])], verbose=False)\n            it = m.best_iteration + 1\n            its_d[\"xgb10_te20\"].append(it)\n            oof_d[\"xgb10_te20\"][b] = m.predict(Xb_b, output_margin=True, iteration_range=(0, it))\n            pred_d[\"xgb10_te20\"] += m.predict(Xt_b, output_margin=True, iteration_range=(0, it)) / 10.0\n\n        msg = [f\"10F fold {f} ({time.time()-t_f:.0f}s):\"]\n        for mname in need_10f:\n            msg.append(f\"{mname}={roc_auc_score(y7[b], oof_d[mname][b]):.5f}\")\n        log7(\" | \".join(msg))\n        gc.collect()\n\n    for mname in need_10f:\n        finish7(mname, oof_d[mname], pred_d[mname], pred_d[mname])\n    gc.collect()\n\n# --- 4B. 5-Fold Suite (Different Fold Geometry + Encoding Seed 1 for Diversity) ---\nFOLDS5 = list(StratifiedKFold(5, shuffle=True, random_state=42).split(np.zeros(NTR7), y7))\nneed_5f = [m for m in [\"glm5_cnt\", \"gb5_xgb_s1\", \"gb5_lgb_s1\", \"gb5_raw_xgb\"] if m not in OOF7]\nif need_5f:\n    log7(f\"Running 5-Fold GLM + Residual Boosters (teseed=1) for: {need_5f}\")\n    oof5 = {m: np.zeros(NTR7) for m in need_5f}\n    pred5 = {m: np.zeros(NTE7) for m in need_5f}\n    its5 = {m: [] for m in need_5f if not m.startswith(\"glm\")}\n    test_idx = np.arange(NTR7, NTR7 + NTE7)\n\n    for f, (a, b) in enumerate(FOLDS5):\n        t_f = time.time()\n        Ea, Eb, Et = te_fold7(a, b, smooth=20.0, inner=5, seed=1)\n        glms = fit_glm_pair(Ea, Eb, Et, a, b, seed=1)\n\n        if \"glm5_cnt\" in oof5:\n            oof5[\"glm5_cnt\"][b] = glms[\"glm_cnt\"][1]\n            pred5[\"glm5_cnt\"] += glms[\"glm_cnt\"][2] / 5.0\n\n        Xa_j = boost_view7(\"joint\", a, Ea)\n        Xb_j = boost_view7(\"joint\", b, Eb)\n        Xt_j = boost_view7(\"joint\", test_idx, Et)\n\n        if \"gb5_xgb_s1\" in oof5:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its5[\"gb5_xgb_s1\"].append(it)\n            oof5[\"gb5_xgb_s1\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred5[\"gb5_xgb_s1\"] += boost_margin7(m, Xt_j, zt, it) / 5.0\n\n        if \"gb5_lgb_s1\" in oof5:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"lgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its5[\"gb5_lgb_s1\"].append(it)\n            oof5[\"gb5_lgb_s1\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred5[\"gb5_lgb_s1\"] += boost_margin7(m, Xt_j, zt, it) / 5.0\n\n        if \"gb5_raw_xgb\" in oof5:\n            za, zb, zt = glms[\"glm_cnt\"]\n            Xa_r = boost_view7(\"raw\", a, Ea)\n            Xb_r = boost_view7(\"raw\", b, Eb)\n            Xt_r = boost_view7(\"raw\", test_idx, Et)\n            m, it = boost_fit7(\"xgb\", Xa_r, y7[a], za, Xb=Xb_r, yb=y7[b], zb=zb, seed=42)\n            its5[\"gb5_raw_xgb\"].append(it)\n            oof5[\"gb5_raw_xgb\"][b] = boost_margin7(m, Xb_r, zb, it)\n            pred5[\"gb5_raw_xgb\"] += boost_margin7(m, Xt_r, zt, it) / 5.0\n\n        msg = [f\"5F fold {f} ({time.time()-t_f:.0f}s):\"]\n        for mname in need_5f:\n            msg.append(f\"{mname}={roc_auc_score(y7[b], oof5[mname][b]):.5f}\")\n        log7(\" | \".join(msg))\n        gc.collect()\n\n    for mname in need_5f:\n        finish7(mname, oof5[mname], pred5[mname], pred5[mname])\n    gc.collect()\n\n# ==============================================================================\n# 5. Grand Out-of-Fold Rank Hill-Climbing & Logit Stack (Exp 7 + V6 Models)\n# ==============================================================================\npool_oof = {}\npool_test = {}\nfor k in OOF7:\n    pool_oof[k] = OOF7[k]\n    pool_test[k] = PRED7[k]\n\n# Add our best diverse cached V6 models (10-fold GBDTs, Spline GLM, PLR-ResNet, MLP)\nv6_candidates = [\n    (\"V6_LGB_3L_Dig2_10F\", \"lgb_dig2_10f_oof\", \"lgb_dig2_10f_test\"),\n    (\"V6_Spline_GLM3_10F\", \"glm_dig3_10f_oof\", \"glm_dig3_10f_test\"),\n    (\"V6_LGB_ET_Dig3_10F\", \"lgb_et_10f_oof\", \"lgb_et_10f_test\"),\n    (\"V6_LGB_CleanPairs\", \"lgb_clean_oof\", \"lgb_clean_test\"),\n    (\"V6_LGB_3L_Dig3\", \"lgb_dig3_oof\", \"lgb_dig3_test\"),\n    (\"V6_PLR_WideResNet\", \"nn_dig3_oof\", \"nn_dig3_test\"),\n    (\"V6_PyTorch_MLP\", \"mlp_oof\", \"mlp_test\"),\n]\nfor label, oof_var, te_var in v6_candidates:\n    if oof_var in globals() and np.std(globals()[oof_var]) > 0:\n        pool_oof[label] = globals()[oof_var]\n        pool_test[label] = globals()[te_var]\n\nNAMES_ALL = list(pool_oof.keys())\nprint(\"\\n\" + \"=\"*75)\nprint(\"SINGLE MODEL OOF ROC AUC LEADERBOARD (EXP 7 + CACHED V6)\")\nprint(\"=\"*75)\nsingle_aucs = {n: roc_auc_score(y7, pool_oof[n]) for n in NAMES_ALL}\nfor n in sorted(NAMES_ALL, key=lambda k: single_aucs[k], reverse=True):\n    print(f\"  {n:24s}: {single_aucs[n]:.6f}\")\n\nR_oof = np.column_stack([rankdata(pool_oof[n]) / NTR7 for n in NAMES_ALL]).astype(np.float32)\nR_test = np.column_stack([rankdata(pool_test[n]) / NTE7 for n in NAMES_ALL]).astype(np.float32)\n\ndef fast_auc_hist(yy, s, nbins=25000):\n    s_min, s_max = float(s.min()), float(s.max())\n    if s_max <= s_min:\n        return 0.5\n    b = np.clip(((s - s_min) * ((nbins - 1) / (s_max - s_min))).astype(np.int32), 0, nbins - 1)\n    pos = np.bincount(b, weights=yy, minlength=nbins)\n    tot = np.bincount(b, minlength=nbins)\n    neg = tot - pos\n    cum_neg = np.cumsum(neg)\n    auc_num = np.sum(pos * (cum_neg - 0.5 * neg))\n    return float(auc_num / (pos.sum() * neg.sum()))\n\ndef hill_climb_auc(Rm, yy, iters=100):\n    yy_f = yy.astype(np.float64)\n    w = np.zeros(Rm.shape[1], dtype=np.float64)\n    cur = np.zeros(len(yy), dtype=np.float32)\n    best = 0.0\n    for _ in range(iters):\n        sc = [fast_auc_hist(yy_f, cur + Rm[:, j]) for j in range(Rm.shape[1])]\n        j = int(np.argmax(sc))\n        if sc[j] <= best + 1e-7:\n            break\n        best, cur, w[j] = sc[j], cur + Rm[:, j], w[j] + 1.0\n    return w / np.maximum(w.sum(), 1.0)\n\ndef rlogit7(r):\n    return logit7(np.clip(r, 1e-6, 1 - 1e-6))\n\n# Nested 5-Fold Out-of-Fold Evaluation of Combiners (Hill Climbing vs Rank-Logit Stack vs Exp7 Rank Mean)\nexp7_only_idx = [i for i, n in enumerate(NAMES_ALL) if not n.startswith(\"V6_\")]\nnested_eval = {\n    \"exp7_rank_mean\": R_oof[:, exp7_only_idx].mean(1),\n    \"hill_all\": np.zeros(NTR7),\n    \"stack_all\": np.zeros(NTR7),\n}\nfor a, b in FOLDS5:\n    w_fold = hill_climb_auc(R_oof[a], y7[a], iters=80)\n    nested_eval[\"hill_all\"][b] = R_oof[b] @ w_fold\n    st_fold = LogisticRegression(C=0.2, max_iter=1000).fit(rlogit7(R_oof[a]), y7[a])\n    nested_eval[\"stack_all\"][b] = st_fold.decision_function(rlogit7(R_oof[b]))\n\nprint(\"\\n\" + \"=\"*75)\nprint(\"OUT-OF-FOLD COMBINER COMPARISON (NESTED CV)\")\nprint(\"=\"*75)\nfor k, v in nested_eval.items():\n    print(f\"  {k:24s}: {roc_auc_score(y7, v):.6f}\")\n\n# Fit final Hill-Climbing weights on full OOF\nw_hill = hill_climb_auc(R_oof, y7, iters=120)\noof_hill_full = R_oof @ w_hill\ntest_hill_full = R_test @ w_hill\n\nprint(\"\\nFinal Hill-Climbing Weights:\")\nfor n, w in zip(NAMES_ALL, w_hill):\n    if w > 0:\n        print(f\"  {n:24s}: {w:.4f} (OOF {single_aucs[n]:.6f})\")\nfinal_exp7_auc = roc_auc_score(y7, oof_hill_full)\nprint(f\"\\n>>> FINAL EXP 7 HILL-CLIMB ENSEMBLE OOF AUC: {final_exp7_auc:.6f} <<<\")\nprint(f\"    (Gain vs V6 Meta-Stacker 0.950490: +{final_exp7_auc - 0.950490:.6f})\")\n\nsub_exp7 = pd.DataFrame({\"id\": te7[\"id\"], TARGET: test_hill_full})\nsub_exp7.to_csv(\"submission.csv\", index=False)\nprint(f\"Saved submission.csv ({len(sub_exp7)} rows, NaN={sub_exp7[TARGET].isna().sum()}, range=[{sub_exp7[TARGET].min():.4f}, {sub_exp7[TARGET].max():.4f}])\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:39:29.549325Z","iopub.execute_input":"2026-11-16T05:39:29.549614Z","iopub.status.idle":"2026-11-16T05:40:54.842985Z","shell.execute_reply.started":"2026-11-16T05:39:29.549591Z","shell.execute_reply":"2026-11-16T05:40:54.842125Z"}},"outputs":[{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer.json:   0%|          | 0.00/1.36M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"37b804961ddf4171aacc5227d8ea0417"}},"metadata":{}},{"name":"stdout","text":"[  27.2s] Built KMAT7: 92 keys (84 base + 8 joint), RAWV7: 30 cols\n[  57.9s] Loaded Exp 7 cache with members: ['glm10_gen', 'glm10_cnt', 'gb10_xgb_s0', 'gb10_cnt_xgb_s0', 'gb10_lgb_s0', 'xgb10_te20', 'glm5_cnt', 'gb5_xgb_s1', 'gb5_lgb_s1', 'gb5_raw_xgb']\n\n===========================================================================\nSINGLE MODEL OOF ROC AUC LEADERBOARD (EXP 7 + CACHED V6)\n===========================================================================\n  gb10_lgb_s0             : 0.951795\n  gb10_xgb_s0             : 0.951743\n  gb10_cnt_xgb_s0         : 0.951664\n  gb5_lgb_s1              : 0.951494\n  gb5_xgb_s1              : 0.951399\n  glm10_cnt               : 0.951327\n  gb5_raw_xgb             : 0.951253\n  glm10_gen               : 0.951099\n  glm5_cnt                : 0.951053\n  xgb10_te20              : 0.950876\n  V6_LGB_3L_Dig2_10F      : 0.950124\n  V6_Spline_GLM3_10F      : 0.949736\n  V6_LGB_ET_Dig3_10F      : 0.949661\n  V6_LGB_CleanPairs       : 0.949591\n  V6_LGB_3L_Dig3          : 0.949576\n  V6_PLR_WideResNet       : 0.948658\n  V6_PyTorch_MLP          : 0.946093\n\n===========================================================================\nOUT-OF-FOLD COMBINER COMPARISON (NESTED CV)\n===========================================================================\n  exp7_rank_mean          : 0.951734\n  hill_all                : 0.951857\n  stack_all               : 0.951847\n\nFinal Hill-Climbing Weights:\n  gb10_cnt_xgb_s0         : 0.2222 (OOF 0.951664)\n  gb10_lgb_s0             : 0.4444 (OOF 0.951795)\n  xgb10_te20              : 0.1111 (OOF 0.950876)\n  gb5_lgb_s1              : 0.1111 (OOF 0.951494)\n  V6_LGB_3L_Dig2_10F      : 0.1111 (OOF 0.950124)\n\n>>> FINAL EXP 7 HILL-CLIMB ENSEMBLE OOF AUC: 0.951911 <<<\n    (Gain vs V6 Meta-Stacker 0.950490: +0.001421)\nSaved submission.csv (299984 rows, NaN=0, range=[0.0000, 1.0000])\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"# ==============================================================================\n# Step 16: Exp 9 — Multi-Resolution/Multi-Smoothing GLM + 3-Leaf Residual Boosters\n#          + Per-Value/Digit/Token Categorical Embedding RealMLP (pytabkit)\n#          + 100%-Data Full Refits + Regularized C=0.01 Logit-Rank Stacker\n# ==============================================================================\nimport os, sys, io, gc, time, logging, subprocess, importlib\nfrom contextlib import redirect_stdout\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\nimport xgboost as xgb\nfrom scipy.stats import rankdata\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler, QuantileTransformer, KBinsDiscretizer, TargetEncoder\n\nT0_EXP9 = time.time()\ndef log9(*a):\n    print(f\"[{time.time() - T0_EXP9:6.1f}s]\", *a, flush=True)\n\nimport shutil, glob\nEXP9_CACHE_FILE = \"preds_exp9.npz\"\nif not os.path.exists(EXP9_CACHE_FILE):\n    _hits9 = sorted(glob.glob(f\"/kaggle/input/**/{EXP9_CACHE_FILE}\", recursive=True))\n    if _hits9:\n        shutil.copy2(_hits9[0], EXP9_CACHE_FILE)\n        log9(f\"Copied {EXP9_CACHE_FILE} from {_hits9[0]} into /kaggle/working/\")\nOOF9, FOLDAVG9, REFIT9, PRED9 = {}, {}, {}, {}\nif os.path.exists(EXP9_CACHE_FILE):\n    _c9 = np.load(EXP9_CACHE_FILE)\n    for _k in _c9.files:\n        if _k.startswith(\"oof_\"):\n            OOF9[_k[4:]] = _c9[_k]\n        elif _k.startswith(\"foldavg_\"):\n            FOLDAVG9[_k[8:]] = _c9[_k]\n        elif _k.startswith(\"refit_\"):\n            REFIT9[_k[6:]] = _c9[_k]\n        elif _k.startswith(\"pred_\"):\n            PRED9[_k[5:]] = _c9[_k]\n    log9(f\"Loaded Exp 9 cache with members: {list(OOF9.keys())}\")\n\ndef save_exp9_cache():\n    payload = {}\n    for k in OOF9:\n        payload[f\"oof_{k}\"] = OOF9[k].astype(np.float32)\n        payload[f\"foldavg_{k}\"] = FOLDAVG9[k].astype(np.float32)\n        payload[f\"refit_{k}\"] = REFIT9[k].astype(np.float32)\n        payload[f\"pred_{k}\"] = PRED9[k].astype(np.float32)\n    np.savez_compressed(EXP9_CACHE_FILE, **payload)\n\ndef finish9(name, oof, foldavg, refit):\n    OOF9[name], FOLDAVG9[name], REFIT9[name] = oof, foldavg, refit\n    PRED9[name] = (rankdata(foldavg) + rankdata(refit)) / (2.0 * NTE7)\n    sp = pd.Series(foldavg).corr(pd.Series(refit), method=\"spearman\")\n    log9(f\"==> {name}: OOF AUC {roc_auc_score(y7, oof):.6f} | foldavg vs refit spearman {sp:.4f}\")\n    save_exp9_cache()\n\ntest_idx9 = np.arange(NTR7, NTR7 + NTE7)\n\n# ==============================================================================\n# PART A: 100%-Data Full Refits for Top Exp 7 Models (Fixes 90%-Data Rare-Value Noise)\n# ==============================================================================\nif np.allclose(FOLDAVG7[\"gb10_lgb_s0\"], REFIT7[\"gb10_lgb_s0\"]):\n    log9(\"Part A: Computing true 100%-data full refit encodings & models for Exp 7 10F suite...\")\n    Ea_all7, _, Et_all7 = te_fold7(ALL7[0], ALL7[1], smooth=20.0, inner=5, seed=0)\n    glms_all7 = fit_glm_pair(Ea_all7, None, Et_all7, ALL7[0], ALL7[1], seed=0)\n\n    finish7(\"glm10_gen\", OOF7[\"glm10_gen\"], FOLDAVG7[\"glm10_gen\"], glms_all7[\"glm_gen\"][2])\n    finish7(\"glm10_cnt\", OOF7[\"glm10_cnt\"], FOLDAVG7[\"glm10_cnt\"], glms_all7[\"glm_cnt\"][2])\n\n    Xa_all_j7 = boost_view7(\"joint\", ALL7[0], Ea_all7)\n    Xt_all_j7 = boost_view7(\"joint\", test_idx9, Et_all7)\n\n    za_g7, _, zt_g7 = glms_all7[\"glm_gen\"]\n    za_c7, _, zt_c7 = glms_all7[\"glm_cnt\"]\n\n    m_lgb_all, _ = boost_fit7(\"lgb\", Xa_all_j7, y7, za_g7, n_trees=1100, seed=42)\n    finish7(\"gb10_lgb_s0\", OOF7[\"gb10_lgb_s0\"], FOLDAVG7[\"gb10_lgb_s0\"], boost_margin7(m_lgb_all, Xt_all_j7, zt_g7))\n\n    m_xgb_all, _ = boost_fit7(\"xgb\", Xa_all_j7, y7, za_g7, n_trees=950, seed=42)\n    finish7(\"gb10_xgb_s0\", OOF7[\"gb10_xgb_s0\"], FOLDAVG7[\"gb10_xgb_s0\"], boost_margin7(m_xgb_all, Xt_all_j7, zt_g7))\n\n    m_cx_all, _ = boost_fit7(\"xgb\", Xa_all_j7, y7, za_c7, n_trees=950, seed=137)\n    finish7(\"gb10_cnt_xgb_s0\", OOF7[\"gb10_cnt_xgb_s0\"], FOLDAVG7[\"gb10_cnt_xgb_s0\"], boost_margin7(m_cx_all, Xt_all_j7, zt_c7))\n\n    del Ea_all7, Et_all7, Xa_all_j7, Xt_all_j7, m_lgb_all, m_xgb_all, m_cx_all\n    gc.collect()\nelse:\n    log9(\"Part A: Exp 7 100%-data full refits already computed and cached.\")\n\n# ==============================================================================\n# PART B: Multi-Resolution Modulo-Decimal + Multi-Smoothing GLM + 3-Leaf Residual Boosters\n# ==============================================================================\n# Build 24 new generator-fingerprint keys:\n#  - 6 pure first decimal digits (d1_*: floor(x*10)%10)\n#  - 6 pure second decimal digits (d2_*: round(x*100)%10)\n#  - 6 ones-place integer digits (u1_*: floor(abs(x))%10)\n#  - 6 fine 50-quantile bins (q50_*)\nextra_k9 = {}\nfor c in FLOATS7:\n    x = full7[c].values\n    extra_k9[f\"d1_{c}\"] = (np.floor(x * 10 + 1e-6).astype(np.int64) % 10).astype(np.int32)\n    extra_k9[f\"d2_{c}\"] = (np.round(x * 100).astype(np.int64) % 10).astype(np.int32)\n    extra_k9[f\"u1_{c}\"] = (np.floor(np.abs(x)).astype(np.int64) % 10).astype(np.int32)\n    extra_k9[f\"q50_{c}\"] = pd.qcut(x, 50, labels=False, duplicates=\"drop\").astype(np.int32)\n\nECODES9 = [pd.factorize(pd.Series(extra_k9[k]))[0].astype(np.int32) for k in extra_k9]\nKMAT9 = np.column_stack([KMAT7] + ECODES9)\nNCAT9 = np.append(NCAT7, [ec.max() + 1 for ec in ECODES9])\nKCNT9 = np.column_stack([KCNT7] + [np.bincount(ec)[ec].astype(np.float32) for ec in ECODES9])\nLOGC9 = np.log1p(KCNT9)\nZLOGC9 = ((LOGC9 - LOGC9.mean(0)) / (LOGC9.std(0) + 1e-6)).astype(np.float32)\n\n# Quantile-normalised continuous numerics + counts for the Multi-Resolution GLM\nqt9 = QuantileTransformer(n_quantiles=1000, output_distribution=\"normal\", subsample=200_000, random_state=42)\nQNUM9 = qt9.fit_transform(np.hstack([full7[NUMS7].values.astype(np.float32), CNT7])).astype(np.float32)\nBASE_MR9 = np.hstack([BASE7, QNUM9, ZLOGC9]).astype(np.float32)\n\n# High-cardinality key indices (24 exact per-value keys + 6 int + 6 cents + 6 token-0 = 42 keys)\n# We encode these at BOTH smooth=5.0 (local sharp rate) and smooth=60.0 (shrunk prior rate)\n# in addition to smooth=20.0 across all 116 keys in KMAT9!\nHC_IDX9 = list(range(24)) + [i for i, n in enumerate(KNAMES7) if n.startswith((\"int_\", \"cents_\", \"t1_\"))]\nlog9(f\"Built KMAT9: {KMAT9.shape[1]} keys ({KMAT7.shape[1]} Exp7 + {len(ECODES9)} modulo-digit/q50), HC_IDX9={len(HC_IDX9)} multi-smooth keys\")\n\ndef te_mr_fold9(a, b, inner=5, seed=2):\n    ya = y7[a].astype(np.float64)\n    Ka, Kt = KMAT9[a], KMAT9[NTR7:]\n    Kb = KMAT9[b] if len(b) else None\n    n_k = KMAT9.shape[1]\n    n_hc = len(HC_IDX9)\n    n_tot = n_k + 2 * n_hc\n\n    Ea = np.zeros((len(a), n_tot), np.float32)\n    Eb = np.zeros((len(b), n_tot), np.float32) if len(b) else None\n    Et = np.zeros((NTE7, n_tot), np.float32)\n\n    inner_f = list(StratifiedKFold(inner, shuffle=True, random_state=seed).split(np.zeros(len(a)), ya))\n    # 1) All 116 keys at smooth=20.0\n    for j in range(n_k):\n        for i, o in inner_f:\n            Ea[o, j] = te_rate7(Ka[i, j], ya[i], NCAT9[j], ya[i].mean(), 20.0)[Ka[o, j]]\n        r20 = te_rate7(Ka[:, j], ya, NCAT9[j], ya.mean(), 20.0)\n        if len(b):\n            Eb[:, j] = r20[Kb[:, j]]\n        Et[:, j] = r20[Kt[:, j]]\n\n    # 2) High-cardinality keys at smooth=5.0 and smooth=60.0\n    for idx_pos, j in enumerate(HC_IDX9):\n        c5 = n_k + idx_pos\n        c60 = n_k + n_hc + idx_pos\n        for i, o in inner_f:\n            Ea[o, c5] = te_rate7(Ka[i, j], ya[i], NCAT9[j], ya[i].mean(), 5.0)[Ka[o, j]]\n            Ea[o, c60] = te_rate7(Ka[i, j], ya[i], NCAT9[j], ya[i].mean(), 60.0)[Ka[o, j]]\n        r5 = te_rate7(Ka[:, j], ya, NCAT9[j], ya.mean(), 5.0)\n        r60 = te_rate7(Ka[:, j], ya, NCAT9[j], ya.mean(), 60.0)\n        if len(b):\n            Eb[:, c5] = r5[Kb[:, j]]\n            Eb[:, c60] = r60[Kb[:, j]]\n        Et[:, c5] = r5[Kt[:, j]]\n        Et[:, c60] = r60[Kt[:, j]]\n    return Ea, Eb, Et\n\ndef fit_glm_mr9(Ea, Eb, Et, a, b, seed=2):\n    if GEN7:\n        Ga, Gb, Gt = gen_fold7(a, b, seed=seed)\n        Ea_g = np.hstack([Ea, Ga])\n        Eb_g = np.hstack([Eb, Gb]) if Eb is not None else None\n        Et_g = np.hstack([Et, Gt])\n    else:\n        Ea_g, Eb_g, Et_g = Ea, Eb, Et\n    sc = StandardScaler().fit(logit7(Ea_g))\n    Za = sc.transform(logit7(Ea_g))\n    Zt = sc.transform(logit7(Et_g))\n    Zb = sc.transform(logit7(Eb_g)) if Eb_g is not None else None\n\n    Xa = np.hstack([Za, BASE_MR9[a]])\n    Xt = np.hstack([Zt, BASE_MR9[NTR7:]])\n    m = LogisticRegression(C=0.2, max_iter=300, tol=1e-7, solver=\"newton-cholesky\").fit(Xa, y7[a])\n    za = m.decision_function(Xa)\n    zt = m.decision_function(Xt)\n    zb = m.decision_function(np.hstack([Zb, BASE_MR9[b]])) if Zb is not None else None\n    return za, zb, zt\n\nLGB9_3L_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.04, num_leaves=3, min_child_samples=120,\n    subsample=0.8, subsample_freq=1, colsample_bytree=0.45, reg_lambda=2.0,\n    max_bin=255, force_col_wise=True, verbose=-1, n_jobs=4\n)\nXGB9_3L_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.03, grow_policy=\"lossguide\", max_leaves=3, max_depth=0,\n    min_child_weight=5, subsample=0.8, colsample_bytree=0.45, reg_lambda=2.0, max_bin=256,\n    tree_method=\"hist\", device=\"cuda\", eval_metric=\"auc\", early_stopping_rounds=180\n)\n\nneed_mr9 = [m for m in [\"glm10_mr\", \"gb10_lgb3_mr\", \"gb10_xgb3_mr\"] if m not in OOF9]\nif need_mr9:\n    log9(f\"Part B: Running 10-Fold Multi-Resolution/Multi-Smoothing GLM + 3-Leaf Residual Boosters: {need_mr9}\")\n    oof_mr = {m: np.zeros(NTR7) for m in need_mr9}\n    pred_mr = {m: np.zeros(NTE7) for m in need_mr9}\n    its_mr = {m: [] for m in need_mr9 if not m.startswith(\"glm\")}\n    n_k9 = KMAT9.shape[1]\n\n    for f, (a, b) in enumerate(FOLDS10):\n        t_f = time.time()\n        Ea, Eb, Et = te_mr_fold9(a, b, inner=5, seed=2)\n        za, zb, zt = fit_glm_mr9(Ea, Eb, Et, a, b, seed=2)\n\n        if \"glm10_mr\" in oof_mr:\n            oof_mr[\"glm10_mr\"][b] = zb\n            pred_mr[\"glm10_mr\"] += zt / 10.0\n\n        Xa_mr = np.hstack([RAWV7[a], Ea[:, :n_k9], KCNT9[a]])\n        Xb_mr = np.hstack([RAWV7[b], Eb[:, :n_k9], KCNT9[b]])\n        Xt_mr = np.hstack([RAWV7[test_idx9], Et[:, :n_k9], KCNT9[test_idx9]])\n\n        if \"gb10_lgb3_mr\" in oof_mr:\n            m_l3 = lgb.LGBMClassifier(**{**LGB9_3L_PARAMS, \"random_state\": 2026 + f})\n            m_l3.fit(Xa_mr, y7[a], init_score=za, eval_set=[(Xb_mr, y7[b])], eval_init_score=[zb],\n                     eval_metric=\"auc\", categorical_feature=CAT_IDX7,\n                     callbacks=[lgb.early_stopping(150, verbose=False)])\n            it_l3 = m_l3.best_iteration_\n            its_mr[\"gb10_lgb3_mr\"].append(it_l3)\n            oof_mr[\"gb10_lgb3_mr\"][b] = zb + m_l3.predict(Xb_mr, raw_score=True)\n            pred_mr[\"gb10_lgb3_mr\"] += (zt + m_l3.predict(Xt_mr, raw_score=True)) / 10.0\n\n        if \"gb10_xgb3_mr\" in oof_mr:\n            m_x3 = xgb.XGBClassifier(**{**XGB9_3L_PARAMS, \"random_state\": 2026 + f})\n            m_x3.fit(Xa_mr, y7[a], base_margin=za, eval_set=[(Xb_mr, y7[b])], base_margin_eval_set=[zb], verbose=False)\n            it_x3 = m_x3.best_iteration + 1\n            its_mr[\"gb10_xgb3_mr\"].append(it_x3)\n            oof_mr[\"gb10_xgb3_mr\"][b] = m_x3.predict(Xb_mr, base_margin=zb, output_margin=True, iteration_range=(0, it_x3))\n            pred_mr[\"gb10_xgb3_mr\"] += m_x3.predict(Xt_mr, base_margin=zt, output_margin=True, iteration_range=(0, it_x3)) / 10.0\n\n        msg = [f\"10F-MR fold {f} ({time.time()-t_f:.0f}s):\"]\n        for mname in need_mr9:\n            msg.append(f\"{mname}={roc_auc_score(y7[b], oof_mr[mname][b]):.5f}\")\n        log9(\" | \".join(msg))\n        del Ea, Eb, Et, Xa_mr, Xb_mr, Xt_mr\n        gc.collect()\n\n    log9(\"Computing 100%-data full refit for Multi-Resolution 10F models...\")\n    Ea_all9, _, Et_all9 = te_mr_fold9(ALL7[0], ALL7[1], inner=5, seed=2)\n    za_all9, _, zt_all9 = fit_glm_mr9(Ea_all9, None, Et_all9, ALL7[0], ALL7[1], seed=2)\n    if \"glm10_mr\" in oof_mr:\n        finish9(\"glm10_mr\", oof_mr[\"glm10_mr\"], pred_mr[\"glm10_mr\"], zt_all9)\n\n    Xa_all_mr = np.hstack([RAWV7[ALL7[0]], Ea_all9[:, :n_k9], KCNT9[ALL7[0]]])\n    Xt_all_mr = np.hstack([RAWV7[test_idx9], Et_all9[:, :n_k9], KCNT9[test_idx9]])\n\n    if \"gb10_lgb3_mr\" in oof_mr:\n        n_tr = int(round(np.mean(its_mr[\"gb10_lgb3_mr\"]) * 1.11))\n        m_l3_all = lgb.LGBMClassifier(**{**LGB9_3L_PARAMS, \"n_estimators\": n_tr, \"random_state\": 2026})\n        m_l3_all.fit(Xa_all_mr, y7, init_score=za_all9, categorical_feature=CAT_IDX7)\n        finish9(\"gb10_lgb3_mr\", oof_mr[\"gb10_lgb3_mr\"], pred_mr[\"gb10_lgb3_mr\"], zt_all9 + m_l3_all.predict(Xt_all_mr, raw_score=True))\n\n    if \"gb10_xgb3_mr\" in oof_mr:\n        n_tr = int(round(np.mean(its_mr[\"gb10_xgb3_mr\"]) * 1.11))\n        P_x3 = {k: v for k, v in XGB9_3L_PARAMS.items() if k != \"early_stopping_rounds\"}\n        P_x3.update({\"n_estimators\": n_tr, \"random_state\": 2026})\n        m_x3_all = xgb.XGBClassifier(**P_x3).fit(Xa_all_mr, y7, base_margin=za_all9)\n        finish9(\"gb10_xgb3_mr\", oof_mr[\"gb10_xgb3_mr\"], pred_mr[\"gb10_xgb3_mr\"], m_x3_all.predict(Xt_all_mr, base_margin=zt_all9, output_margin=True))\n\n    del Ea_all9, Et_all9, Xa_all_mr, Xt_all_mr\n    gc.collect()\n\n# ==============================================================================\n# PART C: From-Scratch RealMLP_TD_Classifier with Per-Value + Digit + GPT-2 Token Embeddings\n# ==============================================================================\ndef ensure_pytabkit():\n    importlib.invalidate_caches()\n    try:\n        import pytabkit  # noqa: F401\n        return True\n    except Exception:\n        log9(\"Installing pytabkit==1.8.0...\")\n        subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"pytabkit==1.8.0\"], capture_output=True)\n        importlib.invalidate_caches()\n        try:\n            import pytabkit  # noqa: F401\n            return True\n        except Exception as e:\n            log9(f\"pytabkit install failed: {e}\")\n            return False\n\nif \"realmlp_tok5\" not in OOF9 and ensure_pytabkit():\n    import torch\n    from pytabkit import RealMLP_TD_Classifier\n    for _lname in (\"lightning.pytorch\", \"pytorch_lightning\", \"lightning\", \"lightning_fabric\"):\n        logging.getLogger(_lname).setLevel(logging.ERROR)\n\n    def build_realmlp_frames():\n        m_tr = tr7[FEATS7].copy()\n        m_te = te7[FEATS7].copy()\n        m_cat = list(CATS7) + list(FLAGS7)\n        for c in FLAGS7:\n            m_tr[c] = m_tr[c].astype(\"int32\")\n            m_te[c] = m_te[c].astype(\"int32\")\n        m_num = list(NUMS7)\n        dec4 = [\"amount_usd\", \"hours_since_last_txn\", \"velocity_score\", \"distance_from_home_km\"]\n\n        def coded_pair(v_tr, v_te):\n            codes, uniques = pd.factorize(v_tr)\n            lookup = {u: i for i, u in enumerate(uniques)}\n            return codes.astype(\"int32\"), pd.Series(v_te).map(lookup).fillna(-1).astype(\"int32\").values\n\n        new_cat, combo_names = [], []\n        for df in (m_tr, m_te):\n            for c in dec4:\n                df[f\"_{c}_decimal\"] = (df[c] % 1).round(2).astype(\"float32\")\n\n        # Integer parts + cents as categorical embeddings\n        for c in m_num + [f\"_{c}_decimal\" for c in dec4]:\n            name = f\"{c}_cat_\" if c in m_num else f\"{c[1:]}_cat_\"\n            if c in m_num:\n                m_tr[name], m_te[name] = coded_pair(np.floor(m_tr[c]), np.floor(m_te[c]))\n            else:\n                m_tr[name], m_te[name] = coded_pair(m_tr[c], m_te[c])\n            new_cat.append(name)\n\n        # First decimal digit (d1_*) + GPT-2 first subword token (t1_*) as categorical embeddings\n        for c in FLOATS7:\n            d1_name = f\"d1_{c}_cat_\"\n            m_tr[d1_name], m_te[d1_name] = coded_pair(extra_k9[f\"d1_{c}\"][:NTR7], extra_k9[f\"d1_{c}\"][NTR7:])\n            new_cat.append(d1_name)\n\n        # Fine quantile bins\n        for c, nb in [(\"merchant_risk_score\", 7), (\"hours_since_last_txn\", 500), (\"hours_since_last_txn\", 1000)]:\n            name = f\"{c}_{nb}_qbin_\"\n            kb = KBinsDiscretizer(n_bins=nb, encode=\"ordinal\", strategy=\"quantile\", subsample=None)\n            m_tr[name] = kb.fit_transform(m_tr[[c]]).ravel().astype(\"int32\")\n            m_te[name] = kb.transform(m_te[[c]]).ravel().astype(\"int32\")\n            new_cat.append(name)\n\n        # Category interactions\n        for cols in [(\"merchant_category\", \"card_type\", \"txn_count_last_24h\"), (\"merchant_category\", \"customer_age\")]:\n            name = \"_\".join(cols) + \"_\"\n            j_tr = m_tr[cols[0]].astype(str)\n            j_te = m_te[cols[0]].astype(str)\n            for col in cols[1:]:\n                j_tr = j_tr + \"_\" + m_tr[col].astype(str)\n                j_te = j_te + \"_\" + m_te[col].astype(str)\n            m_tr[name], m_te[name] = coded_pair(j_tr, j_te)\n            new_cat.append(name)\n            combo_names.append(name)\n\n        for name in m_cat + new_cat:\n            m_tr[name] = m_tr[name].astype(\"category\")\n            m_te[name] = m_te[name].astype(\"category\")\n\n        te_src = combo_names + [\"hours_since_last_txn\"]\n        return m_tr, m_te, m_cat + new_cat, te_src\n\n    m_tr9, m_te9, MLP_CATS9, TE_SRC9 = build_realmlp_frames()\n    te_names9 = [f\"_{c}TE\" for c in TE_SRC9]\n    log9(f\"Part C: Training 5-Fold RealMLP_TD_Classifier ({m_tr9.shape[1] + len(te_names9)} cols, {len(MLP_CATS9)} categorical embeddings)...\")\n\n    REALMLP_PARAMS = dict(\n        random_state=42, verbosity=0, val_metric_name=\"1-auc_ovr\",\n        n_ens=8, n_epochs=2, stop_epoch=2, batch_size=288, use_early_stopping=False,\n        lr=0.053, wd=0.018, sq_mom=0.988, lr_sched=\"flat_anneal\", wd_sched=\"cos_log_15\",\n        first_layer_lr_factor=0.25, embedding_size=5, max_one_hot_cat_size=16,\n        hidden_sizes=[512, 256, 128], act=\"silu\", p_drop=0.05, p_drop_sched=\"pow5\",\n        plr_hidden_1=16, plr_hidden_2=8, plr_act_name=\"gelu\", plr_lr_factor=0.1151, plr_sigma=0.75,\n        ls_eps=0.01, ls_eps_sched=\"sqrt_cos\", add_front_scale=False, bias_init_mode=\"neg-uniform-dynamic-2\",\n        tfms=[\"one_hot\", \"median_center\", \"robust_scale\", \"smooth_clip\", \"embedding\", \"l2_normalize\"]\n    )\n\n    oof_rmlp = np.zeros(NTR7)\n    pred_rmlp = np.zeros(NTE7)\n    for f, (a, b) in enumerate(FOLDS5):\n        t_f = time.time()\n        X_tr_f, X_va_f, X_te_f = m_tr9.iloc[a].copy(), m_tr9.iloc[b].copy(), m_te9.copy()\n        enc = TargetEncoder(cv=5, smooth=\"auto\", shuffle=True, random_state=42)\n        X_tr_f[te_names9] = enc.fit_transform(X_tr_f[TE_SRC9], y7[a])\n        X_va_f[te_names9] = enc.transform(X_va_f[TE_SRC9])\n        X_te_f[te_names9] = enc.transform(X_te_f[TE_SRC9])\n\n        rmodel = RealMLP_TD_Classifier(**REALMLP_PARAMS)\n        with redirect_stdout(io.StringIO()):\n            rmodel.fit(X_tr_f, y7[a], X_va_f, y7[b], cat_col_names=MLP_CATS9)\n        oof_rmlp[b] = rmodel.predict_proba(X_va_f)[:, 1]\n        pred_rmlp += rmodel.predict_proba(X_te_f)[:, 1] / 5.0\n        log9(f\"RealMLP fold {f} ({time.time()-t_f:.0f}s): AUC={roc_auc_score(y7[b], oof_rmlp[b]):.5f}\")\n        del X_tr_f, X_va_f, X_te_f, rmodel, enc\n        gc.collect()\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n\n    finish9(\"realmlp_tok5\", oof_rmlp, pred_rmlp, pred_rmlp)\n    del m_tr9, m_te9\n    gc.collect()\n\n# ==============================================================================\n# PART D: Honest Nested 5-Fold Combiner Comparison (Exp 9 + Exp 7 + Cached V6)\n# ==============================================================================\npool9_oof = {}\npool9_test = {}\nfor k in OOF7:\n    pool9_oof[k] = OOF7[k]\n    pool9_test[k] = PRED7[k]\nfor k in OOF9:\n    pool9_oof[k] = OOF9[k]\n    pool9_test[k] = PRED9[k]\nfor label, oof_var, te_var in v6_candidates:\n    if oof_var in globals() and np.std(globals()[oof_var]) > 0:\n        pool9_oof[label] = globals()[oof_var]\n        pool9_test[label] = globals()[te_var]\n\nNAMES9_ALL = list(pool9_oof.keys())\nsingle_aucs9 = {n: roc_auc_score(y7, pool9_oof[n]) for n in NAMES9_ALL}\n\nprint(\"\\n\" + \"=\"*78)\nprint(\"EXP 9 + EXP 7 + V6 SINGLE MODEL OOF ROC AUC LEADERBOARD\")\nprint(\"=\"*78)\nfor n in sorted(NAMES9_ALL, key=lambda k: single_aucs9[k], reverse=True):\n    tag = \" [NEW EXP 9]\" if n in OOF9 else \"\"\n    print(f\"  {n:24s}: {single_aucs9[n]:.6f}{tag}\")\n\nR9_oof = np.column_stack([rankdata(pool9_oof[n]) / NTR7 for n in NAMES9_ALL]).astype(np.float32)\nR9_test = np.column_stack([rankdata(pool9_test[n]) / NTE7 for n in NAMES9_ALL]).astype(np.float32)\nL9_oof = rlogit7(R9_oof).astype(np.float64)\nL9_test = rlogit7(R9_test).astype(np.float64)\n\n# Report rank correlation of new models vs gb10_lgb_s0\nref_rank = R9_oof[:, NAMES9_ALL.index(\"gb10_lgb_s0\")]\nprint(\"\\nRank Correlation vs gb10_lgb_s0 (Lower = Higher Diversity):\")\nfor n in OOF9:\n    corr_v = np.corrcoef(ref_rank, R9_oof[:, NAMES9_ALL.index(n)])[0, 1]\n    print(f\"  {n:24s}: corr={corr_v:.4f} | OOF AUC={single_aucs9[n]:.6f}\")\n\n# Nested 5-Fold Evaluation of Combiners:\n#  1) Exp 7 Baseline Hill-Climbing (without Exp 9 models)\n#  2) Exp 9 Hill-Climbing (with Exp 9 models)\n#  3) Exp 9 L2 Logit-Rank Stacker (C=0.01, newton-cholesky)\n#  4) Exp 9 L2 Logit-Rank Stacker (C=0.003, newton-cholesky)\n#  5) Blend (50% Hill-Climbing + 50% Logit-Rank Stacker C=0.01)\nexp7_idx = [i for i, n in enumerate(NAMES9_ALL) if n not in OOF9]\nnest9 = {\n    \"exp7_hill_baseline\": np.zeros(NTR7),\n    \"exp9_hill_all\": np.zeros(NTR7),\n    \"exp9_stack_c001\": np.zeros(NTR7),\n    \"exp9_stack_c0003\": np.zeros(NTR7),\n    \"exp9_blend_hs\": np.zeros(NTR7),\n}\n\nfor a, b in FOLDS5:\n    w_e7 = hill_climb_auc(R9_oof[a][:, exp7_idx], y7[a], iters=100)\n    nest9[\"exp7_hill_baseline\"][b] = R9_oof[b][:, exp7_idx] @ w_e7\n\n    w_e9 = hill_climb_auc(R9_oof[a], y7[a], iters=100)\n    p_hc = R9_oof[b] @ w_e9\n    nest9[\"exp9_hill_all\"][b] = p_hc\n\n    st1 = LogisticRegression(C=0.01, tol=1e-8, max_iter=300, solver=\"newton-cholesky\").fit(L9_oof[a], y7[a])\n    p_st1 = rankdata(st1.decision_function(L9_oof[b])) / len(b)\n    nest9[\"exp9_stack_c001\"][b] = p_st1\n\n    st2 = LogisticRegression(C=0.003, tol=1e-8, max_iter=300, solver=\"newton-cholesky\").fit(L9_oof[a], y7[a])\n    p_st2 = rankdata(st2.decision_function(L9_oof[b])) / len(b)\n    nest9[\"exp9_stack_c0003\"][b] = p_st2\n\n    nest9[\"exp9_blend_hs\"][b] = 0.5 * (rankdata(p_hc) / len(b)) + 0.5 * p_st1\n\nprint(\"\\n\" + \"=\"*78)\nprint(\"HONEST NESTED 5-FOLD COMBINER COMPARISON (EXP 9 vs EXP 7)\")\nprint(\"=\"*78)\nnest9_aucs = {k: roc_auc_score(y7, v) for k, v in nest9.items()}\nfor k, auc_v in sorted(nest9_aucs.items(), key=lambda t: t[1], reverse=True):\n    diff = auc_v - nest9_aucs[\"exp7_hill_baseline\"]\n    print(f\"  {k:24s}: {auc_v:.6f}  ({diff:+.6f} vs Exp 7 nested baseline)\")\n\n# Fit full-OOF combiners\nw9_hill = hill_climb_auc(R9_oof, y7, iters=140)\noof9_hill = R9_oof @ w9_hill\ntest9_hill = R9_test @ w9_hill\n\nst9_full = LogisticRegression(C=0.01, tol=1e-8, max_iter=300, solver=\"newton-cholesky\").fit(L9_oof, y7)\noof9_stack = st9_full.decision_function(L9_oof)\ntest9_stack = st9_full.decision_function(L9_test)\n\noof9_blend = 0.5 * (rankdata(oof9_hill) / NTR7) + 0.5 * (rankdata(oof9_stack) / NTR7)\ntest9_blend = 0.5 * (rankdata(test9_hill) / NTE7) + 0.5 * (rankdata(test9_stack) / NTE7)\n\nprint(\"\\nFull-OOF Hill-Climbing Weights (Exp 9 Pool):\")\nfor n, w in zip(NAMES9_ALL, w9_hill):\n    if w > 0:\n        print(f\"  {n:24s}: {w:.4f} (OOF {single_aucs9[n]:.6f})\")\n\ncoef_s = pd.Series(st9_full.coef_.ravel(), index=NAMES9_ALL).sort_values(key=np.abs, ascending=False)\nprint(\"\\nTop 10 Logit-Rank Stacker (C=0.01) Coefficients:\")\nfor n, c_val in coef_s.head(10).items():\n    print(f\"  {n:24s}: {c_val:+.4f} (OOF {single_aucs9[n]:.6f})\")\n\nbest_nest_name = max([\"exp9_hill_all\", \"exp9_stack_c001\", \"exp9_blend_hs\"], key=lambda k: nest9_aucs[k])\nif best_nest_name == \"exp9_hill_all\":\n    final_oof9, final_test9 = oof9_hill, test9_hill\nelif best_nest_name == \"exp9_stack_c001\":\n    final_oof9, final_test9 = rankdata(oof9_stack) / NTR7, rankdata(test9_stack) / NTE7\nelse:\n    final_oof9, final_test9 = oof9_blend, test9_blend\n\nprint(f\"\\n>>> SELECTED COMBINER BY NESTED CV: {best_nest_name} (Nested OOF: {nest9_aucs[best_nest_name]:.6f} | Full OOF: {roc_auc_score(y7, final_oof9):.6f}) <<<\")\n\nsub_exp9 = pd.DataFrame({\"id\": te7[\"id\"], TARGET: final_test9})\nsub_exp9.to_csv(\"submission_exp9.csv\", index=False)\nsub_exp9.to_csv(\"submission.csv\", index=False)\nlog9(f\"Saved submission_exp9.csv and submission.csv ({len(sub_exp9)} rows, NaN={sub_exp9[TARGET].isna().sum()})\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:40:54.844432Z","iopub.execute_input":"2026-11-16T05:40:54.844764Z","iopub.status.idle":"2026-11-16T05:44:51.693388Z","shell.execute_reply.started":"2026-11-16T05:40:54.844742Z","shell.execute_reply":"2026-11-16T05:44:51.692477Z"}},"outputs":[{"name":"stdout","text":"[   0.2s] Loaded Exp 9 cache with members: ['glm10_mr', 'gb10_lgb3_mr', 'gb10_xgb3_mr', 'realmlp_tok5']\n[   0.2s] Part A: Computing true 100%-data full refit encodings & models for Exp 7 10F suite...\n[ 118.8s] ==> glm10_gen: OOF AUC 0.951099 | foldavg vs refit spearman 0.9997\n[ 122.3s] ==> glm10_cnt: OOF AUC 0.951327 | foldavg vs refit spearman 0.9997\n[ 216.1s] ==> gb10_lgb_s0: OOF AUC 0.951795 | foldavg vs refit spearman 0.9973\n[ 238.3s] ==> gb10_xgb_s0: OOF AUC 0.951743 | foldavg vs refit spearman 0.9983\n[ 260.2s] ==> gb10_cnt_xgb_s0: OOF AUC 0.951664 | foldavg vs refit spearman 0.9979\n[ 189.1s] Built KMAT9: 116 keys (92 Exp7 + 24 modulo-digit/q50), HC_IDX9=42 multi-smooth keys\n\n==============================================================================\nEXP 9 + EXP 7 + V6 SINGLE MODEL OOF ROC AUC LEADERBOARD\n==============================================================================\n  gb10_lgb_s0             : 0.951795\n  gb10_xgb_s0             : 0.951743\n  gb10_cnt_xgb_s0         : 0.951664\n  gb10_xgb3_mr            : 0.951499 [NEW EXP 9]\n  gb5_lgb_s1              : 0.951494\n  gb10_lgb3_mr            : 0.951472 [NEW EXP 9]\n  gb5_xgb_s1              : 0.951399\n  glm10_cnt               : 0.951327\n  glm10_mr                : 0.951285 [NEW EXP 9]\n  gb5_raw_xgb             : 0.951253\n  glm10_gen               : 0.951099\n  glm5_cnt                : 0.951053\n  xgb10_te20              : 0.950876\n  V6_LGB_3L_Dig2_10F      : 0.950124\n  V6_Spline_GLM3_10F      : 0.949736\n  realmlp_tok5            : 0.949711 [NEW EXP 9]\n  V6_LGB_ET_Dig3_10F      : 0.949661\n  V6_LGB_CleanPairs       : 0.949591\n  V6_LGB_3L_Dig3          : 0.949576\n  V6_PLR_WideResNet       : 0.948658\n  V6_PyTorch_MLP          : 0.946093\n\nRank Correlation vs gb10_lgb_s0 (Lower = Higher Diversity):\n  glm10_mr                : corr=0.9930 | OOF AUC=0.951285\n  gb10_lgb3_mr            : corr=0.9938 | OOF AUC=0.951472\n  gb10_xgb3_mr            : corr=0.9938 | OOF AUC=0.951499\n  realmlp_tok5            : corr=0.9760 | OOF AUC=0.949711\n\n==============================================================================\nHONEST NESTED 5-FOLD COMBINER COMPARISON (EXP 9 vs EXP 7)\n==============================================================================\n  exp9_stack_c001         : 0.951976  (+0.000119 vs Exp 7 nested baseline)\n  exp9_blend_hs           : 0.951928  (+0.000071 vs Exp 7 nested baseline)\n  exp9_stack_c0003        : 0.951922  (+0.000065 vs Exp 7 nested baseline)\n  exp7_hill_baseline      : 0.951857  (+0.000000 vs Exp 7 nested baseline)\n  exp9_hill_all           : 0.951830  (-0.000027 vs Exp 7 nested baseline)\n\nFull-OOF Hill-Climbing Weights (Exp 9 Pool):\n  gb10_cnt_xgb_s0         : 0.1538 (OOF 0.951664)\n  gb10_lgb_s0             : 0.3846 (OOF 0.951795)\n  xgb10_te20              : 0.0769 (OOF 0.950876)\n  gb5_lgb_s1              : 0.0769 (OOF 0.951494)\n  gb10_xgb3_mr            : 0.1538 (OOF 0.951499)\n  realmlp_tok5            : 0.0769 (OOF 0.949711)\n  V6_LGB_3L_Dig2_10F      : 0.0769 (OOF 0.950124)\n\nTop 10 Logit-Rank Stacker (C=0.01) Coefficients:\n  gb10_lgb_s0             : +0.2992 (OOF 0.951795)\n  xgb10_te20              : +0.2133 (OOF 0.950876)\n  gb5_lgb_s1              : +0.1998 (OOF 0.951494)\n  gb10_cnt_xgb_s0         : +0.1902 (OOF 0.951664)\n  glm10_gen               : -0.1851 (OOF 0.951099)\n  gb10_xgb_s0             : +0.1705 (OOF 0.951743)\n  gb10_xgb3_mr            : +0.1627 (OOF 0.951499)\n  gb10_lgb3_mr            : +0.1515 (OOF 0.951472)\n  glm5_cnt                : -0.1451 (OOF 0.951053)\n  V6_Spline_GLM3_10F      : -0.1442 (OOF 0.949736)\n\n>>> SELECTED COMBINER BY NESTED CV: exp9_stack_c001 (Nested OOF: 0.951976 | Full OOF: 0.952004) <<<\n[ 236.7s] Saved submission_exp9.csv and submission.csv (299984 rows, NaN=0)\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"# ==============================================================================\n# Step 17: Exp 10 — Target-First GPT-2 Language Models + Diverse Tabular Families\n#          + Honest Multi-Split Nested CV Ablation & Saturation Study\n# ==============================================================================\nimport os, json, time, hashlib, subprocess\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.special import logit\nfrom scipy.stats import rankdata\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.metrics import roc_auc_score\n\nT0_EXP10 = time.time()\ndef log10(*a):\n    print(f\"[{time.time() - T0_EXP10:6.1f}s]\", *a, flush=True)\n\nINPUT10 = Path(\"/kaggle/input\")\nWORK10 = Path(\"/kaggle/working\")\n\ndef logit_rank10(p):\n    \"\"\"Map predictions onto normalized logit-rank scale (strictly monotone).\"\"\"\n    r = (rankdata(p) - 0.5) / len(p)\n    return logit(np.clip(r, 1e-6, 1.0 - 1e-6))\n\ndef fetch_kaggle_dataset(slug, dst_name, required_files):\n    # First check if already mounted under /kaggle/input/**\n    hits = []\n    for rf in required_files:\n        found = sorted(INPUT10.rglob(rf))\n        # Prefer folder matching slug suffix\n        slug_part = slug.split(\"/\")[-1]\n        matched = [p for p in found if slug_part in str(p)] or found\n        if matched:\n            hits.append(matched[0].parent)\n    if hits and all((hits[0] / rf).exists() for rf in required_files):\n        log10(f\"Found {slug} mounted at {hits[0]}\")\n        return hits[0]\n\n    dst = WORK10 / \"ext_assets\" / dst_name\n    dst.mkdir(parents=True, exist_ok=True)\n    if all((dst / rf).exists() for rf in required_files):\n        log10(f\"Using cached {dst}\")\n        return dst\n\n    log10(f\"Downloading {slug} via kaggle CLI...\")\n    res = subprocess.run([\"kaggle\", \"datasets\", \"download\", \"-d\", slug, \"-p\", str(dst), \"--unzip\"],\n                         capture_output=True, text=True)\n    if res.returncode != 0:\n        log10(f\"WARNING: failed to download {slug}: {res.stderr[-300:]}\")\n        return None\n    missing = [rf for rf in required_files if not (dst / rf).exists()]\n    if missing:\n        log10(f\"WARNING: {slug} missing files {missing}\")\n        return None\n    log10(f\"Downloaded {slug} OK -> {dst}\")\n    return dst\n\n# Verify seed-42 5-fold scheme used by external Target-First LM predictions\nfold42 = np.zeros(NTR7, dtype=np.int32)\nfor k, (_, va) in enumerate(FOLDS5):\n    fold42[va] = k\n\next_oof, ext_test = {}, {}\n\n# 1) Masaya Kawamata GPT-2 Target-First LM (CC BY 4.0; Chris Deotte S6E10 recipe)\np_gpt2 = fetch_kaggle_dataset(\"masayakawamata/s6e11-gpt2-target-first-oof\", \"gpt2_masaya\",\n                              [\"oof.npy\", \"test.npy\", \"fold_ids.npy\"])\nif p_gpt2 is not None:\n    o = np.load(p_gpt2 / \"oof.npy\").astype(np.float64).ravel()\n    t = np.load(p_gpt2 / \"test.npy\").astype(np.float64).ravel()\n    fids = np.load(p_gpt2 / \"fold_ids.npy\").ravel()\n    assert len(o) == NTR7 and len(t) == NTE7 and np.isfinite(o).all() and np.isfinite(t).all()\n    assert np.array_equal(fids, fold42), \"GPT-2 fold scheme mismatch!\"\n    sha = hashlib.sha256((p_gpt2 / \"oof.npy\").read_bytes()).hexdigest()[:16]\n    ext_oof[\"LM_GPT2_masaya\"], ext_test[\"LM_GPT2_masaya\"] = o, t\n    log10(f\"LM_GPT2_masaya: OOF={roc_auc_score(y7, o):.6f} | fold42=OK | sha256={sha}\")\n\n# 2) Frozen Compact Target-First LMs (megayak LM + goodpjw2008 Seed 7)\np_lm7 = fetch_kaggle_dataset(\"goodpjw2008/s6e11-compact-lm-seed7\", \"compact_lm_seed7\",\n                             [\"megalm_oof_sha181c.npy\", \"megalm_test_sha3168.npy\", \"lm7_oof_5fold.npy\", \"lm7_test_5fold.npy\"])\nif p_lm7 is not None:\n    for name, fo, ft in [(\"LM_megayak\", \"megalm_oof_sha181c.npy\", \"megalm_test_sha3168.npy\"),\n                         (\"LM_seed7\", \"lm7_oof_5fold.npy\", \"lm7_test_5fold.npy\")]:\n        o = np.load(p_lm7 / fo).astype(np.float64).ravel()\n        t = np.load(p_lm7 / ft).astype(np.float64).ravel()\n        assert len(o) == NTR7 and len(t) == NTE7 and np.isfinite(o).all() and np.isfinite(t).all()\n        ext_oof[name], ext_test[name] = o, t\n        log10(f\"{name}: OOF={roc_auc_score(y7, o):.6f}\")\n\n# 3) Target-First GPT-2 Seed 2026 (goodpjw2008 / Matapanino replica)\np_gpt26 = fetch_kaggle_dataset(\"goodpjw2008/s6e11-target-first-gpt2-seed-2026\", \"gpt2_seed2026\",\n                               [\"gpt2_s2026_oof_5fold.npy\", \"gpt2_s2026_test_5fold.npy\"])\nif p_gpt26 is not None:\n    o = np.load(p_gpt26 / \"gpt2_s2026_oof_5fold.npy\").astype(np.float64).ravel()\n    t = np.load(p_gpt26 / \"gpt2_s2026_test_5fold.npy\").astype(np.float64).ravel()\n    assert len(o) == NTR7 and len(t) == NTE7 and np.isfinite(o).all() and np.isfinite(t).all()\n    ext_oof[\"LM_GPT2_s2026\"], ext_test[\"LM_GPT2_s2026\"] = o, t\n    log10(f\"LM_GPT2_s2026: OOF={roc_auc_score(y7, o):.6f}\")\n\n# 4) Diverse Artifacts (EBM_dig, RealMLP_dig, RealMLP_te) + WideLM 201-member Benchmark Anchor\np_art = fetch_kaggle_dataset(\"goodpjw2008/s6e11-fraud-series-artifacts\", \"fraud_artifacts\",\n                             [\"ebm_dig_oof.npy\", \"ebm_dig_test.npy\",\n                              \"realmlp_dig_oof.npy\", \"realmlp_dig_test.npy\",\n                              \"realmlp_te_oof.npy\", \"realmlp_te_test.npy\",\n                              \"wide_lm_stack_nested.npy\", \"wide_lm_stack_test.npy\"])\nif p_art is not None:\n    for name, fo, ft in [(\"ART_EBM_dig\", \"ebm_dig_oof.npy\", \"ebm_dig_test.npy\"),\n                         (\"ART_RealMLP_dig\", \"realmlp_dig_oof.npy\", \"realmlp_dig_test.npy\"),\n                         (\"ART_RealMLP_te\", \"realmlp_te_oof.npy\", \"realmlp_te_test.npy\"),\n                         (\"BENCH_WideLM\", \"wide_lm_stack_nested.npy\", \"wide_lm_stack_test.npy\")]:\n        o = np.load(p_art / fo).astype(np.float64).ravel()\n        t = np.load(p_art / ft).astype(np.float64).ravel()\n        assert len(o) == NTR7 and len(t) == NTE7 and np.isfinite(o).all() and np.isfinite(t).all()\n        ext_oof[name], ext_test[name] = o, t\n        log10(f\"{name}: OOF={roc_auc_score(y7, o):.6f}\")\n\n# Assemble full pool: Our Exp 7 + Exp 9 + V6 + Loaded Language Models / Artifacts\nall10_oof = {}\nall10_test = {}\nfor label, src_oof, src_test in [(\"OURS\", pool9_oof, pool9_test), (\"EXT\", ext_oof, ext_test)]:\n    for k in src_oof:\n        all10_oof[k] = src_oof[k]\n        all10_test[k] = src_test[k]\n\n# Rank correlations of External LMs & Artifacts vs our gb10_lgb_s0\nref10 = rankdata(all10_oof[\"gb10_lgb_s0\"]) / NTR7\nprint(\"\\n\" + \"=\" * 80)\nprint(\"NEW EXTERNAL MODELS VS OUR BEST SINGLE TREE (gb10_lgb_s0)\")\nprint(\"=\" * 80)\nfor k in ext_oof:\n    r_k = rankdata(ext_oof[k]) / NTR7\n    c = float(np.corrcoef(ref10, r_k)[0, 1])\n    print(f\"  {k:24s}: OOF={roc_auc_score(y7, ext_oof[k]):.6f} | rank_corr_vs_exp7={c:.4f}\")\n\n# Honest Multi-Split Nested Stacking Evaluation:\n# Evaluate across 3 completely independent StratifiedKFold splits (seeds 7, 8, 9) + seed 42\ndef eval_stack_honest(member_names, C_val=0.01, splits=(7, 8, 9)):\n    Z = np.column_stack([logit_rank10(all10_oof[m]) for m in member_names])\n    ZT = np.column_stack([logit_rank10(all10_test[m]) for m in member_names])\n    split_aucs = []\n    for sp in splits:\n        oof_sp = np.zeros(NTR7)\n        for tr, va in StratifiedKFold(5, shuffle=True, random_state=sp).split(Z, y7):\n            m = LogisticRegression(C=C_val, tol=1e-8, max_iter=300, solver=\"newton-cholesky\").fit(Z[tr], y7[tr])\n            oof_sp[va] = m.decision_function(Z[va])\n        split_aucs.append(roc_auc_score(y7, oof_sp))\n    m_full = LogisticRegression(C=C_val, tol=1e-8, max_iter=300, solver=\"newton-cholesky\").fit(Z, y7)\n    test_pred = rankdata(m_full.decision_function(ZT)) / NTE7\n    coefs = pd.Series(m_full.coef_.ravel(), index=member_names)\n    return float(np.mean(split_aucs)), split_aucs, test_pred, coefs\n\nours_names = list(pool9_oof.keys())\nexp7_only_names = [n for n in ours_names if n not in OOF9]\nlm_names = [n for n in [\"LM_GPT2_masaya\", \"LM_megayak\", \"LM_seed7\", \"LM_GPT2_s2026\"] if n in all10_oof]\nart_names = [n for n in [\"ART_EBM_dig\", \"ART_RealMLP_dig\", \"ART_RealMLP_te\"] if n in all10_oof]\n\nconfigs = [\n    (\"1) Exp 7 Only (baseline)\", exp7_only_names, 0.01),\n    (\"2) Exp 7 + Exp 9 (our models only)\", ours_names, 0.01),\n]\nif \"LM_GPT2_masaya\" in all10_oof:\n    configs.append((\"3) Ours (Exp7+9) + 1 GPT-2 LM (masaya)\", ours_names + [\"LM_GPT2_masaya\"], 0.01))\nif lm_names:\n    configs.append((\"4) Ours (Exp7+9) + All 4 Target-First LMs\", ours_names + lm_names, 0.01))\nif lm_names and art_names:\n    configs.append((\"5) Ours (Exp7+9) + 4 LMs + EBM + RealMLP\", ours_names + lm_names + art_names, 0.01))\nif \"BENCH_WideLM\" in all10_oof:\n    configs.append((\"6a) BENCHMARK: WideLM solo\", [\"BENCH_WideLM\"], 0.01))\n    configs.append((\"6b) BENCHMARK: WideLM + Ours (Exp7+9)\", [\"BENCH_WideLM\"] + ours_names, 0.01))\n    configs.append((\"6c) BENCHMARK: WideLM + Ours + 4 LMs + Art\", [\"BENCH_WideLM\"] + ours_names + lm_names + art_names, 0.01))\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"HONEST MULTI-SPLIT NESTED CV ABLATION (SPLITS = 7, 8, 9 | C = 0.01)\")\nprint(\"=\" * 80)\nablation_results = {}\nfor label, mlist, cval in configs:\n    if len(mlist) == 1:\n        solo_auc = roc_auc_score(y7, all10_oof[mlist[0]])\n        print(f\"  {label:44s}: mean={solo_auc:.6f} (solo)\")\n        ablation_results[label] = (solo_auc, [solo_auc]*3, rankdata(all10_test[mlist[0]]) / NTE7, pd.Series([1.0], index=mlist))\n    else:\n        mean_auc, sp_aucs, t_pred, coefs = eval_stack_honest(mlist, C_val=cval)\n        ablation_results[label] = (mean_auc, sp_aucs, t_pred, coefs)\n        print(f\"  {label:44s}: mean={mean_auc:.6f} | splits={[round(x, 6) for x in sp_aucs]}\")\n\n# Also sweep regularization C on Stage 4 and Stage 5 to make sure C=0.01 isn't under/over-regularized\nfor target_label in [\"4) Ours (Exp7+9) + All 4 Target-First LMs\", \"5) Ours (Exp7+9) + 4 LMs + EBM + RealMLP\"]:\n    if target_label in ablation_results:\n        mlist = [c[1] for c in configs if c[0] == target_label][0]\n        print(f\"\\nC-Sweep for [{target_label}]:\")\n        for cv in [0.002, 0.005, 0.01, 0.02, 0.05]:\n            m_auc, _, _, _ = eval_stack_honest(mlist, C_val=cv)\n            print(f\"    C={cv:<6g} -> Nested Mean AUC = {m_auc:.6f}\")\n\nfor key_lbl, slug in [\n    (\"3) Ours (Exp7+9) + 1 GPT-2 LM (masaya)\", \"submission_exp10_ours_1lm.csv\"),\n    (\"4) Ours (Exp7+9) + All 4 Target-First LMs\", \"submission_exp10_ours_4lms.csv\"),\n    (\"5) Ours (Exp7+9) + 4 LMs + EBM + RealMLP\", \"submission_exp10_ours_4lms_art.csv\"),\n    (\"6b) BENCHMARK: WideLM + Ours (Exp7+9)\", \"submission_exp10_widelm_plus_ours.csv\"),\n]:\n    if key_lbl in ablation_results:\n        mean_auc, _, t_pred, coefs = ablation_results[key_lbl]\n        pd.DataFrame({\"id\": te7[\"id\"], TARGET: t_pred}).to_csv(slug, index=False)\n        print(f\"\\nSaved {slug} (Nested AUC={mean_auc:.6f}) | Top weights:\")\n        print(coefs.reindex(coefs.abs().sort_values(ascending=False).index).head(8).round(4).to_string())\n\nlog10(\"Exp 10 complete!\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T05:44:51.694619Z","iopub.execute_input":"2026-11-16T05:44:51.69495Z","iopub.status.idle":"2026-11-16T05:55:43.230957Z","shell.execute_reply.started":"2026-11-16T05:44:51.694917Z","shell.execute_reply":"2026-11-16T05:55:43.230232Z"}},"outputs":[{"name":"stdout","text":"[   0.8s] Found masayakawamata/s6e11-gpt2-target-first-oof mounted at /kaggle/input/datasets/masayakawamata/s6e11-gpt2-target-first-oof\n[   1.2s] LM_GPT2_masaya: OOF=0.950027 | fold42=OK | sha256=3468aaaeb7851739\n[   1.7s] Found goodpjw2008/s6e11-compact-lm-seed7 mounted at /kaggle/input/datasets/goodpjw2008/s6e11-compact-lm-seed7\n[   2.2s] LM_megayak: OOF=0.950428\n[   2.4s] LM_seed7: OOF=0.949448\n[   2.7s] Found goodpjw2008/s6e11-target-first-gpt2-seed-2026 mounted at /kaggle/input/datasets/goodpjw2008/s6e11-target-first-gpt2-seed-2026\n[   3.2s] LM_GPT2_s2026: OOF=0.950140\n[   4.3s] Found goodpjw2008/s6e11-fraud-series-artifacts mounted at /kaggle/input/datasets/goodpjw2008/s6e11-fraud-series-artifacts\n[   4.6s] ART_EBM_dig: OOF=0.949808\n[   4.8s] ART_RealMLP_dig: OOF=0.948529\n[   5.1s] ART_RealMLP_te: OOF=0.947710\n[   5.3s] BENCH_WideLM: OOF=0.952565\n\n================================================================================\nNEW EXTERNAL MODELS VS OUR BEST SINGLE TREE (gb10_lgb_s0)\n================================================================================\n  LM_GPT2_masaya          : OOF=0.950027 | rank_corr_vs_exp7=0.9594\n  LM_megayak              : OOF=0.950428 | rank_corr_vs_exp7=0.9659\n  LM_seed7                : OOF=0.949448 | rank_corr_vs_exp7=0.9612\n  LM_GPT2_s2026           : OOF=0.950140 | rank_corr_vs_exp7=0.9620\n  ART_EBM_dig             : OOF=0.949808 | rank_corr_vs_exp7=0.9805\n  ART_RealMLP_dig         : OOF=0.948529 | rank_corr_vs_exp7=0.9663\n  ART_RealMLP_te          : OOF=0.947710 | rank_corr_vs_exp7=0.9614\n  BENCH_WideLM            : OOF=0.952565 | rank_corr_vs_exp7=0.9896\n\n================================================================================\nHONEST MULTI-SPLIT NESTED CV ABLATION (SPLITS = 7, 8, 9 | C = 0.01)\n================================================================================\n  1) Exp 7 Only (baseline)                    : mean=0.951899 | splits=[np.float64(0.951907), np.float64(0.951902), np.float64(0.951889)]\n  2) Exp 7 + Exp 9 (our models only)          : mean=0.951939 | splits=[np.float64(0.951945), np.float64(0.951944), np.float64(0.951928)]\n  3) Ours (Exp7+9) + 1 GPT-2 LM (masaya)      : mean=0.952162 | splits=[np.float64(0.95217), np.float64(0.952162), np.float64(0.952155)]\n  4) Ours (Exp7+9) + All 4 Target-First LMs   : mean=0.952208 | splits=[np.float64(0.952219), np.float64(0.952205), np.float64(0.9522)]\n  5) Ours (Exp7+9) + 4 LMs + EBM + RealMLP    : mean=0.952253 | splits=[np.float64(0.952255), np.float64(0.952256), np.float64(0.952247)]\n  6a) BENCHMARK: WideLM solo                  : mean=0.952565 (solo)\n  6b) BENCHMARK: WideLM + Ours (Exp7+9)       : mean=0.952570 | splits=[np.float64(0.952576), np.float64(0.952572), np.float64(0.95256)]\n  6c) BENCHMARK: WideLM + Ours + 4 LMs + Art  : mean=0.952473 | splits=[np.float64(0.952475), np.float64(0.952477), np.float64(0.952469)]\n\nC-Sweep for [4) Ours (Exp7+9) + All 4 Target-First LMs]:\n    C=0.002  -> Nested Mean AUC = 0.952166\n    C=0.005  -> Nested Mean AUC = 0.952192\n    C=0.01   -> Nested Mean AUC = 0.952208\n    C=0.02   -> Nested Mean AUC = 0.952221\n    C=0.05   -> Nested Mean AUC = 0.952233\n\nC-Sweep for [5) Ours (Exp7+9) + 4 LMs + EBM + RealMLP]:\n    C=0.002  -> Nested Mean AUC = 0.952194\n    C=0.005  -> Nested Mean AUC = 0.952234\n    C=0.01   -> Nested Mean AUC = 0.952253\n    C=0.02   -> Nested Mean AUC = 0.952265\n    C=0.05   -> Nested Mean AUC = 0.952275\n\nSaved submission_exp10_ours_1lm.csv (Nested AUC=0.952162) | Top weights:\nLM_GPT2_masaya        0.5214\ngb10_lgb_s0           0.2868\nglm5_cnt             -0.1984\nV6_Spline_GLM3_10F   -0.1908\nxgb10_te20            0.1843\nglm10_gen            -0.1779\ngb5_lgb_s1            0.1773\ngb10_cnt_xgb_s0       0.1772\n\nSaved submission_exp10_ours_4lms.csv (Nested AUC=0.952208) | Top weights:\ngb10_lgb_s0           0.2813\nLM_megayak            0.2487\nLM_GPT2_masaya        0.2359\nglm5_cnt             -0.2183\nLM_GPT2_s2026         0.2037\nV6_Spline_GLM3_10F   -0.1994\nglm10_gen            -0.1725\nxgb10_te20            0.1724\n\nSaved submission_exp10_ours_4lms_art.csv (Nested AUC=0.952253) | Top weights:\ngb10_lgb_s0           0.2778\nLM_megayak            0.2496\nLM_GPT2_masaya        0.2366\nLM_GPT2_s2026         0.2068\nglm5_cnt             -0.2051\nV6_Spline_GLM3_10F   -0.2010\nxgb10_te20            0.1994\ngb5_lgb_s1            0.1688\n\nSaved submission_exp10_widelm_plus_ours.csv (Nested AUC=0.952570) | Top weights:\nBENCH_WideLM          0.9721\nV6_Spline_GLM3_10F   -0.1703\ngb10_lgb_s0           0.1514\nglm5_cnt             -0.1179\nrealmlp_tok5          0.0951\ngb10_xgb3_mr          0.0875\ngb10_cnt_xgb_s0       0.0832\ngb5_lgb_s1            0.0800\n[ 651.5s] Exp 10 complete!\n","output_type":"stream"}],"execution_count":18}]}
