rs=7000, learning_rate=0.045, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.7,\n            random_state=fold + 1000, verbose=-1, n_jobs=-1,\n        )\n        m_dig2_10.fit(X_tr_2, y_tr, eval_set=[(X_va_2, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(100, verbose=False)])\n        lgb_dig2_10f_oof[va_idx] = m_dig2_10.predict_proba(X_va_2)[:, 1]\n        lgb_dig2_10f_test += m_dig2_10.predict_proba(X_te_2)[:, 1] / 10.0\n        del X_tr_2, X_va_2, X_te_2, tr_te2, va_te2, te_te2\n\n        # 2) 10-Fold Randomized extra_trees=True LightGBM (num_leaves=4, max_depth=3) on X_dig3 + 75 NTE keys\n        X_tr_3 = pd.concat([X_dig3.iloc[tr_idx], pd.DataFrame(tr_te3, index=X_dig3.index[tr_idx])], axis=1)\n        X_va_3 = pd.concat([X_dig3.iloc[va_idx], pd.DataFrame(va_te3, index=X_dig3.index[va_idx])], axis=1)\n        X_te_3 = pd.concat([X_test_dig3, pd.DataFrame(te_te3, index=X_test_dig3.index)], axis=1)\n\n        m_et_10 = lgb.LGBMClassifier(\n            n_estimators=9000, learning_rate=0.045, num_leaves=4, max_depth=3,\n            extra_trees=True, min_child_samples=100, subsample=0.8, subsample_freq=1,\n            colsample_bytree=0.7, reg_alpha=0.5, reg_lambda=2.0,\n            random_state=fold + 2000, verbose=-1, n_jobs=-1,\n        )\n        m_et_10.fit(X_tr_3, y_tr, eval_set=[(X_va_3, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(100, verbose=False)])\n        lgb_et_10f_oof[va_idx] = m_et_10.predict_proba(X_va_3)[:, 1]\n        lgb_et_10f_test += m_et_10.predict_proba(X_te_3)[:, 1] / 10.0\n        del X_tr_3, X_va_3, X_te_3, tr_te3, va_te3, te_te3\n\n        # 3) 10-Fold Spline GLM on X_dig3 + 75 logit(NTE)\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base5_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base5_tr[va_idx], nte_log_va])), -6.0, 6.0).as