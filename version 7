atic_te_logit)\nmeta_lr_auc  = roc_auc_score(y, meta_lr_oof)\nmeta_lgb_auc = roc_auc_score(y, meta_lgb_oof)\n\nstack_oofs = np.column_stack([\n    static_oof_logit,\n    logit(np.clip(meta_lr_oof, 1e-6, 1.0 - 1e-6)),\n    logit(np.clip(meta_lgb_oof, 1e-6, 1.0 - 1e-6)),\n])\nstack_tes = np.column_stack([\n    static_te_logit,\n    logit(np.clip(meta_lr_test, 1e-6, 1.0 - 1e-6)),\n    logit(np.clip(meta_lgb_test, 1e-6, 1.0 - 1e-6)),\n])\n\nbest_stack_auc = -1.0\nbest_stack_w = np.array([1.0, 0.0, 0.0])\nfor a in ([1.0] if globals().get('SKIP_SUPERSEDED', False) else np.linspace(0.0, 1.0, 51)):\n    for b in np.linspace(0.0, 1.0 - a, 51):\n        c = max(0.0, 1.0 - a - b)\n        w = np.array([a, b, c])\n        auc = roc_auc_score(y, stack_oofs @ w)\n        if auc > best_stack_auc:\n            best_stack_auc = auc\n            best_stack_w = w\n\nprint(\"\\n=== Ensemble & Meta-Stacker Comparison (OOF AUC) ===\")\nprint(f\"  Static Prob  Blend:              {best_prob_auc:.5f}\")\nprint(f\"  Static Logit Blend:              {best_log_auc:.5f}\")\nprint(f\"  Meta-LogReg (Context + Spline):  {meta_lr_auc:.5f}\")\nprint(f\"  Meta-LGB    (Regime GBDT):       {meta_lgb_auc:.5f}\")\nprint(f\"  FINAL Combined Meta-Stacker:     {best_stack_auc:.5f}  (weights: Static={best_stack_w[0]:.2f}, MetaLR={best_stack_w[1]:.2f}, MetaLGB={best_stack_w[2]:.2f})\")\n\nprint(\"\\nStatic Logit Blend Weights:\")\nfor n, w in zip(names, best_log_w):\n    print(f\"  {n:16s}: {w:.3f}\")\n\nfinal_test = expit(stack_tes @ best_stack_w)\nsub = pd.DataFrame({\"id\": test[\"id\"], \"is_fraud\": final_test})\nsub.to_csv(\"submission.csv\", index=False)\nsub.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T05:33:36.261067Z","iopub.execute_input":"2026-11-14T05:33:36.261437Z","iopub.status.idle":"2026-11-14T05:34:17.807771Z","shell.execute_reply.started":"2026-11-14T05:33:36.261414Z","shell.execute_reply":"2026-11-14T05:34:17.806987Z"}},"outputs":[{"name":"stdout","tex