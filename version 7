# ==============================================================================\n# Step 15: Exp 7 — 92-Key Per-Value/Digit-Trie/GPT2-Token + Pooled Token GLM\n#          + Residual GLM-Boosted LightGBM & GPU XGBoost + 100%-Data Full Refit\n# ==============================================================================\nimport os, glob, gc, time, warnings\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\nimport xgboost as xgb\nfrom scipy.stats import rankdata\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nwarnings.filterwarnings(\"ignore\")\n\nT0_EXP7 = time.time()\ndef log7(*a):\n    print(f\"[{time.time() - T0_EXP7:6.1f}s]\", *a, flush=True)\n\ndef find_csv(name, hint=\"\"):\n    hits = sorted(glob.glob(os.path.join(\"/kaggle/input\", \"**\", name), recursive=True))\n    hits = [h for h in hits if hint in h] or hits\n    return hits[0] if hits else None\n\nTARGET = \"is_fraud\"\nCATS7 = [\"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"]\nFLAGS7 = [\"is_foreign_transaction\", \"is_new_merchant\", \"used_vpn\",\n          \"ip_country_mismatch\", \"billing_shipping_mismatch\", \"is_ai_generated_scam_attempt\"]\nNUMS7 = [\"amount_usd\", \"hours_since_last_txn\", \"txn_count_last_24h\", \"distance_from_home_km\",\n         \"card_age_months\", \"customer_age\", \"account_balance_usd\", \"cvv_retry_count\",\n         \"velocity_score\", \"time_of_day_hour\", \"day_of_week\", \"merchant_risk_score\", \"prior_disputes\"]\nFEATS7 = NUMS7 + FLAGS7 + CATS7\nFLOATS7 = [\"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\", \"account_balance_usd\",\n           \"velocity_score\", \"merchant_risk_score\"]\n\ntr_path = find_csv(\"train.csv\", \"s6e11\") or find_csv(\"train.csv\")\nte_path = find_csv(\"test.csv\", \"s6e11\") or find_csv(\"test.csv\")\ntr7 = pd.read_csv(tr_path)\nte7 = pd.read_csv(te_path)\nfor _df in (tr7, te7):\n    _df[FLAGS7] = _df[FLAGS7].astype(\"int8\")\n\ny7 = tr7[TARGET].astype(int).values\nNTR7, NTE7 = len(tr7), len(te7)\nfull7 = pd.concat([tr7[FEATS7], te7[FEATS7]], ignore_index=True)\n\n# 1. Build 92-Key Matrix: 24 Exact Per-Value + 36 Digit-Trie + 24 GPT-2 Token + 8 Joint Keys\ndef build_key_table(df):\n    K = {}\n    for c in FEATS7:\n        K[f\"v_{c}\"] = df[c].astype(str).values if c in CATS7 else df[c].values\n    for c in FLOATS7:\n        x = df[c].values\n        K[f\"cents_{c}\"] = (np.round(x * 100) % 100).astype(np.int64)\n        K[f\"int_{c}\"] = np.floor(x).astype(np.int64)\n        K[f\"ten_{c}\"] = np.floor(x / 10).astype(np.int64)\n        K[f\"dec_{c}\"] = np.floor(x * 10 + 1e-6).astype(np.int64)\n    for c in FLOATS7:\n        i = pd.Series(np.floor(df[c].values).astype(np.int64)).astype(str)\n        K[f\"l1_{c}\"] = (i.str.len() * 10 + i.str[0].astype(int)).values\n        K[f\"l2_{c}\"] = (i.str.len() * 100 + i.str[:2].astype(int)).values\n    return K\n\nSTR7, TOK7 = None, None\ndef build_token_keys():\n    global STR7, TOK7\n    try:\n        from tokenizers import Tokenizer\n        gpt2 = Tokenizer.from_pretrained(\"gpt2\")\n    except Exception as e:\n        log7(f\"GPT-2 tokenizer unavailable ({type(e).__name__}), using regex BPE-like digit-pair split fallback\")\n        gpt2 = None\n    STR7 = pd.concat([\n        pd.read_csv(tr_path, usecols=FLOATS7, dtype=str),\n        pd.read_csv(te_path, usecols=FLOATS7, dtype=str)\n    ], ignore_index=True)\n    TOK7, K = {}, {}\n    for c in FLOATS7:\n        uniq = STR7[c].unique()\n        if gpt2 is not None:\n            tok_map = {v: gpt2.encode(\" \" + v).tokens for v in uniq}\n        else:\n            def _fallback_tok(v):\n                parts = v.split(\".\")\n                int_p = parts[0]\n                chunks = [int_p[max(0, k-2):k] for k in range(len(int_p), 0, -2)][::-1]\n                if len(parts) > 1:\n                    chunks += [\".\", parts[1]]\n                return chunks\n            tok_map = {v: _fallback_tok(v) for v in uniq}\n        p = TOK7[c] = STR7[c].map(tok_map)\n        K[f\"t1_{c}\"] = p.str[0].values\n        K[f\"t2_{c}\"] = p.map(lambda t: t[1] if len(t) > 1 else \"\").values\n        K[f\"tl_{c}\"] = p.str[-1].values\n        K[f\"tn_{c}\"] = p.str.len().values\n    return K\n\nKEYS7 = build_key_table(full7)\nKEYS7.update(build_token_keys())\nKNAMES7 = list(KEYS7)\ncodes7 = [pd.factorize(pd.Series(KEYS7[n]))[0].astype(np.int32) for n in KNAMES7]\nKMAT7 = np.column_stack(codes7)\nNCAT7 = np.array([c.max() + 1 for c in codes7])\ndel KEYS7, codes7\nNBASE7 = KMAT7.shape[1]\n\n# 8 Non-Additive Joint Keys verified by deviance & likelihood-ratio G test\nJOINT7 = [\n    (\"j_category_risk\", (\"merchant_category\", \"merchant_risk_score\")),\n    (\"j_foreign_ip\", (\"is_foreign_transaction\", \"ip_country_mismatch\")),\n    (\"j_category_amount\", (\"merchant_category\", \"q:amount_usd\")),\n    (\"j_txn_velocity\", (\"txn_count_last_24h\", \"q:velocity_score\")),\n    (\"j_category_age\", (\"merchant_category\", \"customer_age\")),\n    (\"j_amount_risk\", (\"q:amount_usd\", \"q:merchant_risk_score\")),\n    (\"j_hours_velocity\", (\"q:hours_since_last_txn\", \"q:velocity_score\")),\n    (\"j_age_risk\", (\"customer_age\", \"q:merchant_risk_score\")),\n]\ndef joint_col7(df, c):\n    return pd.qcut(df[c[2:]], 10, labels=False, duplicates=\"drop\") if c.startswith(\"q:\") else df[c]\ndef joint_code7(df, cols):\n    k = np.zeros(len(df), np.int64)\n    for c in cols:\n        u = pd.factorize(joint_col7(df, c))[0]\n        k = k * (u.max() + 1) + u\n    return pd.factorize(k)[0].astype(np.int32)\n\nJCODES7 = [joint_code7(full7, cols) for _, cols in JOINT7]\nKMAT7 = np.column_stack([KMAT7] + JCODES7)\nNCAT7 = np.append(NCAT7, [jc.max() + 1 for jc in JCODES7])\nKNAMES7 += [name for name, _ in JOINT7]\n\n# Key Value Counts across train + test (reliability weight of each key's fraud rate)\nKCNT7 = np.column_stack([np.bincount(KMAT7[:, j])[KMAT7[:, j]] for j in range(KMAT7.shape[1])]).astype(np.float32)\nCNT7 = np.column_stack([full7[c].map(full7[c].value_counts()).values for c in NUMS7]).astype(np.float32)\n\n# Raw view: 24 columns + 6 cents columns\nRAW7 = full7[NUMS7 + FLAGS7].copy()\nfor c in CATS7:\n    RAW7[c] = pd.factorize(full7[c], sort=True)[0].astype(np.int16)\nfor c in FLOATS7:\n    RAW7[f\"cents_{c}\"] = (np.round(full7[c].values * 100) % 100).astype(np.int16)\nRAWV7 = RAW7.values.astype(np.float32)\nCAT_IDX7 = [list(RAW7.columns).index(c) for c in CATS7]\nlog7(f\"Built KMAT7: {KMAT7.shape[1]} keys ({NBASE7} base + {len(JOINT7)} joint), RAWV7: {RAWV7.shape[1]} cols\")\n\n# 2. Cross-Field Pooled Token Encoding (gen_encode) & Fast bincount Target Encoding\nPOOL2 = [\"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\", \"account_balance_usd\"]\nPOOL1 = [\"velocity_score\", \"merchant_risk_score\"]\nGEN7 = TOK7 is not None and STR7 is not None\nif GEN7:\n    dec_fn = lambda c: STR7[c].str.split(\".\").str[1].fillna(\"0\").astype(str)\n    lit_fn = lambda c: TOK7[c].map(lambda t: t[t.index(\".\") - 1] if \".\" in t else t[-1])\n    GROUPS7 = []\n    for mem, fn in [(POOL2, dec_fn), (POOL2, lambda c: dec_fn(c).str[0]), (POOL1, dec_fn), (POOL1, lit_fn)]:\n        v = pd.concat([fn(c) for c in mem], ignore_index=True)\n        GROUPS7.append(pd.factorize(v)[0].astype(np.int32).reshape(len(mem), -1).T.copy())\n    MARKOV7 = [pd.factorize(lit_fn(c) + \"|\" + dec_fn(c))[0].astype(np.int32) for c in POOL2]\n\ndef gen_encode7(i, o, m0=50.0, m1=2000.0, m2=200.0):\n    yi = y7[i].astype(np.float64)\n    prior, cols, field0 = yi.mean(), [], []\n    for g, C in enumerate(GROUPS7):\n        ncat = int(C.max()) + 1\n        s = [np.bincount(C[i, j], weights=yi, minlength=ncat) for j in range(C.shape[1])]\n        n = [np.bincount(C[i, j], minlength=ncat) for j in range(C.shape[1])]\n        pool = (sum(s) + prior * m0) / (sum(n) + m0)\n        for j in range(C.shape[1]):\n            h = ((s[j] + m1 * pool) / (n[j] + m1))[C[o, j]]\n            cols.append(h)\n            if g == 0:\n                field0.append(h)\n    for j, M in enumerate(MARKOV7):\n        ncat = int(M.max()) + 1\n        s, n = np.bincount(M[i], weights=yi, minlength=ncat), np.bincount(M[i], minlength=ncat)\n        cols.append((s[M[o]] + m2 * field0[j]) / (n[M[o]] + m2))\n    return np.column_stack(cols).astype(np.float32)\n\ndef gen_fold7(a, b, inner=5, seed=0):\n    Ga = None\n    for i, o in StratifiedKFold(inner, shuffle=True, random_state=seed).split(np.zeros(len(a)), y7[a]):\n        E = gen_encode7(a[i], a[o])\n        Ga = np.zeros((len(a), E.shape[1]), np.float32) if Ga is None else Ga\n        Ga[o] = E\n    tail = np.concatenate([b, np.arange(NTR7, NTR7 + NTE7)]) if len(b) else np.arange(NTR7, NTR7 + NTE7)\n    E = gen_encode7(a, tail)\n    return Ga, (E[:len(b)] if len(b) else None), E[len(b):]\n\ndef te_rate7(k, t, ncat, prior, smooth):\n    s = np.bincount(k, weights=t, minlength=ncat)\n    n = np.bincount(k, minlength=ncat)\n    return (s + prior * smooth) / (n + smooth)\n\ndef te_fold7(a, b, smooth=20.0, inner=5, seed=0):\n    ya = y7[a].astype(np.float64)\n    Ka, Kt = KMAT7[a], KMAT7[NTR7:]\n    Kb = KMAT7[b] if len(b) else None\n    Ea = np.zeros(Ka.shape, np.float32)\n    Eb = np.zeros(Kb.shape, np.float32) if len(b) else None\n    Et = np.zeros(Kt.shape, np.float32)\n    inner_f = list(StratifiedKFold(inner, shuffle=True, random_state=seed).split(np.zeros(len(a)), ya))\n    for j in range(KMAT7.shape[1]):\n        for i, o in inner_f:\n            Ea[o, j] = te_rate7(Ka[i, j], ya[i], NCAT7[j], ya[i].mean(), smooth)[Ka[o, j]]\n        r = te_rate7(Ka[:, j], ya, NCAT7[j], ya.mean(), smooth)\n        if len(b):\n            Eb[:, j] = r[Kb[:, j]]\n        Et[:, j] = r[Kt[:, j]]\n    return Ea, Eb, Et\n\ndef logit7(p):\n    p = np.clip(p, 1e-6, 1 - 1e-6)\n    return np.log(p / (1 - p))\n\n# 3. GLM Design Matrices (Plain + Count-Aware + Standardized Log-Numerics)\nnum7 = full7[NUMS7].astype(float).copy()\nfor c in (\"amount_usd\", \"account_balance_usd\", \"hours_since_last_txn\"):\n    num7[c] = np.log1p(np.maximum(0.0, num7[c]))\nZNUM7 = StandardScaler().fit_transform(num7).astype(np.float32)\nONEHOT7 = pd.get_dummies(full7[CATS7].astype(str), dtype=np.float32).values\nBASE7 = np.hstack([ZNUM7, full7[FLAGS7].values.astype(np.float32), ONEHOT7])\nLOGC7 = np.log1p(KCNT7)\nBASEC7 = np.hstack([BASE7, (LOGC7 - LOGC7.mean(0)) / (LOGC7.std(0) + 1e-6)])\n\n# Load or initialize Exp 7 checkpoint cache\nEXP7_CACHE_FILE = \"preds_exp7_glmboost.npz\"\nOOF7, FOLDAVG7, REFIT7, PRED7 = {}, {}, {}, {}\nif os.path.exists(EXP7_CACHE_FILE):\n    _c7 = np.load(EXP7_CACHE_FILE)\n    for _k in _c7.files:\n        if _k.startswith(\"oof_\"):\n            OOF7[_k[4:]] = _c7[_k]\n        elif _k.startswith(\"foldavg_\"):\n            FOLDAVG7[_k[8:]] = _c7[_k]\n        elif _k.startswith(\"refit_\"):\n            REFIT7[_k[6:]] = _c7[_k]\n        elif _k.startswith(\"pred_\"):\n            PRED7[_k[5:]] = _c7[_k]\n    log7(f\"Loaded Exp 7 cache with members: {list(OOF7.keys())}\")\n\ndef save_exp7_cache():\n    payload = {}\n    for k in OOF7:\n        payload[f\"oof_{k}\"] = OOF7[k].astype(np.float32)\n        payload[f\"foldavg_{k}\"] = FOLDAVG7[k].astype(np.float32)\n        payload[f\"refit_{k}\"] = REFIT7[k].astype(np.float32)\n        payload[f\"pred_{k}\"] = PRED7[k].astype(np.float32)\n    np.savez_compressed(EXP7_CACHE_FILE, **payload)\n\ndef finish7(name, oof, foldavg, refit):\n    OOF7[name], FOLDAVG7[name], REFIT7[name] = oof, foldavg, refit\n    # Rank average of fold-average and 100%-data full refit\n    PRED7[name] = (rankdata(foldavg) + rankdata(refit)) / (2.0 * NTE7)\n    sp = pd.Series(foldavg).corr(pd.Series(refit), method=\"spearman\")\n    log7(f\"==> {name}: OOF AUC {roc_auc_score(y7, oof):.6f} | foldavg vs refit spearman {sp:.4f}\")\n    save_exp7_cache()\n\n# 4. Run 10-Fold Suite (90%-Data Encodings + Pooled Token GLMs + Residual Boosted GPU XGB & CPU LGB)\nFOLDS10 = list(StratifiedKFold(10, shuffle=True, random_state=42).split(np.zeros(NTR7), y7))\nALL7 = (np.arange(NTR7), np.arange(0, dtype=int))\n\nLGB7_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.04, num_leaves=4, min_child_samples=100,\n    subsample=0.8, subsample_freq=1, colsample_bytree=0.5, reg_lambda=1.0,\n    max_bin=255, force_col_wise=True, verbose=-1, n_jobs=4\n)\nXGB7_PARAMS = dict(\n    n_estimators=8000, learning_rate=0.03, max_depth=2, min_child_weight=5,\n    subsample=0.8, colsample_bytree=0.5, reg_lambda=1.0, max_bin=256,\n    tree_method=\"hist\", device=\"cuda\", eval_metric=\"auc\", early_stopping_rounds=180\n)\n\ndef boost_view7(view, idx, E):\n    if view == \"raw\":\n        return np.hstack([RAWV7[idx], CNT7[idx], KCNT7[idx]])\n    elif view == \"base\":\n        return np.hstack([RAWV7[idx], E[:, :NBASE7], KCNT7[idx, :NBASE7]])\n    return np.hstack([RAWV7[idx], E, KCNT7[idx]])\n\ndef fit_glm_pair(Ea, Eb, Et, a, b, seed=0):\n    if GEN7:\n        Ga, Gb, Gt = gen_fold7(a, b, seed=seed)\n        Ea_g = np.hstack([Ea, Ga])\n        Eb_g = np.hstack([Eb, Gb]) if Eb is not None else None\n        Et_g = np.hstack([Et, Gt])\n    else:\n        Ea_g, Eb_g, Et_g = Ea, Eb, Et\n    sc = StandardScaler().fit(logit7(Ea_g))\n    Za = sc.transform(logit7(Ea_g))\n    Zt = sc.transform(logit7(Et_g))\n    Zb = sc.transform(logit7(Eb_g)) if Eb_g is not None else None\n    out = {}\n    for gname, B in [(\"glm_gen\", BASE7), (\"glm_cnt\", BASEC7)]:\n        Xa = np.hstack([Za, B[a]])\n        Xt = np.hstack([Zt, B[NTR7:]])\n        m = LogisticRegression(C=0.3, max_iter=300, tol=1e-7, solver=\"newton-cholesky\").fit(Xa, y7[a])\n        za = m.decision_function(Xa)\n        zt = m.decision_function(Xt)\n        zb = m.decision_function(np.hstack([Zb, B[b]])) if Zb is not None else None\n        out[gname] = (za, zb, zt)\n    return out\n\ndef boost_fit7(kind, Xa, ya, za, n_trees=None, Xb=None, yb=None, zb=None, seed=42):\n    if kind == \"lgb\":\n        P = {**LGB7_PARAMS, \"random_state\": seed}\n        if n_trees:\n            P[\"n_estimators\"] = n_trees\n            m = lgb.LGBMClassifier(**P)\n            return m.fit(Xa, ya, init_score=za, categorical_feature=CAT_IDX7), n_trees\n        m = lgb.LGBMClassifier(**P)\n        m.fit(Xa, ya, init_score=za, eval_set=[(Xb, yb)], eval_init_score=[zb], eval_metric=\"auc\",\n              categorical_feature=CAT_IDX7, callbacks=[lgb.early_stopping(150, verbose=False)])\n        return m, m.best_iteration_\n    else:\n        P = {**XGB7_PARAMS, \"random_state\": seed}\n        if n_trees:\n            P = {k: v for k, v in P.items() if k != \"early_stopping_rounds\"}\n            P[\"n_estimators\"] = n_trees\n            m = xgb.XGBClassifier(**P)\n            return m.fit(Xa, ya, base_margin=za), n_trees\n        m = xgb.XGBClassifier(**P)\n        m.fit(Xa, ya, base_margin=za, eval_set=[(Xb, yb)], base_margin_eval_set=[zb], verbose=False)\n        return m, m.best_iteration + 1\n\ndef boost_margin7(m, X, z, it=None):\n    if isinstance(m, lgb.LGBMClassifier):\n        return z + m.predict(X, raw_score=True)\n    return m.predict(X, base_margin=z, output_margin=True, iteration_range=(0, it) if it else None)\n\n# --- 4A. 10-Fold Pipeline: Encode once per fold, fit GLMs + GPU XGB boosters + CPU LGB booster ---\nneed_10f = [m for m in [\"glm10_gen\", \"glm10_cnt\", \"gb10_xgb_s0\", \"gb10_cnt_xgb_s0\", \"gb10_lgb_s0\", \"xgb10_te20\"] if m not in OOF7]\nif need_10f:\n    log7(f\"Running 10-Fold GLM + Residual Boosters for: {need_10f}\")\n    oof_d = {m: np.zeros(NTR7) for m in need_10f}\n    pred_d = {m: np.zeros(NTE7) for m in need_10f}\n    its_d = {m: [] for m in need_10f if not m.startswith(\"glm\")}\n    test_idx = np.arange(NTR7, NTR7 + NTE7)\n\n    for f, (a, b) in enumerate(FOLDS10):\n        t_f = time.time()\n        Ea, Eb, Et = te_fold7(a, b, smooth=20.0, inner=5, seed=0)\n        glms = fit_glm_pair(Ea, Eb, Et, a, b, seed=0)\n\n        if \"glm10_gen\" in oof_d:\n            oof_d[\"glm10_gen\"][b] = glms[\"glm_gen\"][1]\n            pred_d[\"glm10_gen\"] += glms[\"glm_gen\"][2] / 10.0\n        if \"glm10_cnt\" in oof_d:\n            oof_d[\"glm10_cnt\"][b] = glms[\"glm_cnt\"][1]\n            pred_d[\"glm10_cnt\"] += glms[\"glm_cnt\"][2] / 10.0\n\n        Xa_j = boost_view7(\"joint\", a, Ea)\n        Xb_j = boost_view7(\"joint\", b, Eb)\n        Xt_j = boost_view7(\"joint\", test_idx, Et)\n\n        if \"gb10_xgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=42)\n            its_d[\"gb10_xgb_s0\"].append(it)\n            oof_d[\"gb10_xgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_xgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"gb10_cnt_xgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_cnt\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its_d[\"gb10_cnt_xgb_s0\"].append(it)\n            oof_d[\"gb10_cnt_xgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_cnt_xgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"gb10_lgb_s0\" in oof_d:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"lgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=42)\n            its_d[\"gb10_lgb_s0\"].append(it)\n            oof_d[\"gb10_lgb_s0\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred_d[\"gb10_lgb_s0\"] += boost_margin7(m, Xt_j, zt, it) / 10.0\n\n        if \"xgb10_te20\" in oof_d:\n            Xa_b = boost_view7(\"base\", a, Ea)\n            Xb_b = boost_view7(\"base\", b, Eb)\n            Xt_b = boost_view7(\"base\", test_idx, Et)\n            P_plain = {**XGB7_PARAMS, \"learning_rate\": 0.03, \"random_state\": 42}\n            m = xgb.XGBClassifier(**P_plain)\n            m.fit(Xa_b, y7[a], eval_set=[(Xb_b, y7[b])], verbose=False)\n            it = m.best_iteration + 1\n            its_d[\"xgb10_te20\"].append(it)\n            oof_d[\"xgb10_te20\"][b] = m.predict(Xb_b, output_margin=True, iteration_range=(0, it))\n            pred_d[\"xgb10_te20\"] += m.predict(Xt_b, output_margin=True, iteration_range=(0, it)) / 10.0\n\n        msg = [f\"10F fold {f} ({time.time()-t_f:.0f}s):\"]\n        for mname in need_10f:\n            msg.append(f\"{mname}={roc_auc_score(y7[b], oof_d[mname][b]):.5f}\")\n        log7(\" | \".join(msg))\n        gc.collect()\n\n    for mname in need_10f:\n        finish7(mname, oof_d[mname], pred_d[mname], pred_d[mname])\n    gc.collect()\n\n# --- 4B. 5-Fold Suite (Different Fold Geometry + Encoding Seed 1 for Diversity) ---\nFOLDS5 = list(StratifiedKFold(5, shuffle=True, random_state=42).split(np.zeros(NTR7), y7))\nneed_5f = [m for m in [\"glm5_cnt\", \"gb5_xgb_s1\", \"gb5_lgb_s1\", \"gb5_raw_xgb\"] if m not in OOF7]\nif need_5f:\n    log7(f\"Running 5-Fold GLM + Residual Boosters (teseed=1) for: {need_5f}\")\n    oof5 = {m: np.zeros(NTR7) for m in need_5f}\n    pred5 = {m: np.zeros(NTE7) for m in need_5f}\n    its5 = {m: [] for m in need_5f if not m.startswith(\"glm\")}\n    test_idx = np.arange(NTR7, NTR7 + NTE7)\n\n    for f, (a, b) in enumerate(FOLDS5):\n        t_f = time.time()\n        Ea, Eb, Et = te_fold7(a, b, smooth=20.0, inner=5, seed=1)\n        glms = fit_glm_pair(Ea, Eb, Et, a, b, seed=1)\n\n        if \"glm5_cnt\" in oof5:\n            oof5[\"glm5_cnt\"][b] = glms[\"glm_cnt\"][1]\n            pred5[\"glm5_cnt\"] += glms[\"glm_cnt\"][2] / 5.0\n\n        Xa_j = boost_view7(\"joint\", a, Ea)\n        Xb_j = boost_view7(\"joint\", b, Eb)\n        Xt_j = boost_view7(\"joint\", test_idx, Et)\n\n        if \"gb5_xgb_s1\" in oof5:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"xgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its5[\"gb5_xgb_s1\"].append(it)\n            oof5[\"gb5_xgb_s1\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred5[\"gb5_xgb_s1\"] += boost_margin7(m, Xt_j, zt, it) / 5.0\n\n        if \"gb5_lgb_s1\" in oof5:\n            za, zb, zt = glms[\"glm_gen\"]\n            m, it = boost_fit7(\"lgb\", Xa_j, y7[a], za, Xb=Xb_j, yb=y7[b], zb=zb, seed=137)\n            its5[\"gb5_lgb_s1\"].append(it)\n            oof5[\"gb5_lgb_s1\"][b] = boost_margin7(m, Xb_j, zb, it)\n            pred5[\"gb5_lgb_s1\"] += boost_margin7(m, Xt_j, zt, it) / 5.0\n\n        if \"gb5_raw_xgb\" in oof5:\n            za, zb, zt = glms[\"glm_cnt\"]\n            Xa_r = boost_view7(\"raw\", a, Ea)\n            Xb_r = boost_view7(\"raw\", b, Eb)\n            Xt_r = boost_view7(\"raw\", test_idx, Et)\n            m, it = boost_fit7(\"xgb\", Xa_r, y7[a], za, Xb=Xb_r, yb=y7[b], zb=zb, seed=42)\n            its5[\"gb5_raw_xgb\"].append(it)\n            oof5[\"gb5_raw_xgb\"][b] = boost_margin7(m, Xb_r, zb, it)\n            pred5[\"gb5_raw_xgb\"] += boost_margin7(m, Xt_r, zt, it) / 5.0\n\n        msg = [f\"5F fold {f} ({time.time()-t_f:.0f}s):\"]\n        for mname in need_5f:\n            msg.append(f\"{mname}={roc_auc_score(y7[b], oof5[mname][b]):.5f}\")\n        log7(\" | \".join(msg))\n        gc.collect()\n\n    for mname in need_5f:\n        finish7(mname, oof5[mname], pred5[mname], pred5[mname])\n    gc.collect()\n\n# ==============================================================================\n# 5. Grand Out-of-Fold Rank Hill-Climbing & Logit Stack (Exp 7 + V6 Models)\n# ==============================================================================\npool_oof = {}\npool_test = {}\nfor k in OOF7:\n    pool_oof[k] = OOF7[k]\n    pool_test[k] = PRED7[k]\n\n# Add our best diverse cached V6 models (10-fold GBDTs, Spline GLM, PLR-ResNet, MLP)\nv6_candidates = [\n    (\"V6_LGB_3L_Dig2_10F\", \"lgb_dig2_10f_oof\", \"lgb_dig2_10f_test\"),\n    (\"V6_Spline_GLM3_10F\", \"glm_dig3_10f_oof\", \"glm_dig3_10f_test\"),\n    (\"V6_LGB_ET_Dig3_10F\", \"lgb_et_10f_oof\", \"lgb_et_10f_test\"),\n    (\"V6_LGB_CleanPairs\", \"lgb_clean_oof\", \"lgb_clean_test\"),\n    (\"V6_LGB_3L_Dig3\", \"lgb_dig3_oof\", \"lgb_dig3_test\"),\n    (\"V6_PLR_WideResNet\", \"nn_dig3_oof\", \"nn_dig3_test\"),\n    (\"V6_PyTorch_MLP\", \"mlp_oof\", \"mlp_test\"),\n]\nfor label, oof_var, te_var in v6_candidates:\n    if oof_var in globals() and np.std(globals()[oof_var]) > 0:\n        pool_oof[label] = globals()[oof_var]\n        pool_test[label] = globals()[te_var]\n\nNAMES_ALL = list(pool_oof.keys())\nprint(\"\\n\" + \"=\"*75)\nprint(\"SINGLE MODEL OOF ROC AUC LEADERBOARD (EXP 7 + CACHED V6)\")\nprint(\"=\"*75)\nsingle_aucs = {n: roc_auc_score(y7, pool_oof[n]) for n in NAMES_ALL}\nfor n in sorted(NAMES_ALL, key=lambda k: single_aucs[k], reverse=True):\n    print(f\"  {n:24s}: {single_aucs[n]:.6f}\")\n\nR_oof = np.column_stack([rankdata(pool_oof[n]) / NTR7 for n in NAMES_ALL]).astype(np.float32)\nR_test = np.column_stack([rankdata(pool_test[n]) / NTE7 for n in NAMES_ALL]).astype(np.float32)\n\ndef fast_auc_hist(yy, s, nbins=25000):\n    s_min, s_max = float(s.min()), float(s.max())\n    if s_max <= s_min:\n        return 0.5\n    b = np.clip(((s - s_min) * ((nbins - 1) / (s_max - s_min))).astype(np.int32), 0, nbins - 1)\n    pos = np.bincount(b, weights=yy, minlength=nbins)\n    tot = np.bincount(b, minlength=nbins)\n    neg = tot - pos\n    cum_neg = np.cumsum(neg)\n    auc_num = np.sum(pos * (cum_neg - 0.5 * neg))\n    return float(auc_num / (pos.sum() * neg.sum()))\n\ndef hill_climb_auc(Rm, yy, iters=100):\n    yy_f = yy.astype(np.float64)\n    w = np.zeros(Rm.shape[1], dtype=np.float64)\n    cur = np.zeros(len(yy), dtype=np.float32)\n    best = 0.0\n    for _ in range(iters):\n        sc = [fast_auc_hist(yy_f, cur + Rm[:, j]) for j in range(Rm.shape[1])]\n        j = int(np.argmax(sc))\n        if sc[j] <= best + 1e-7:\n            break\n        best, cur, w[j] = sc