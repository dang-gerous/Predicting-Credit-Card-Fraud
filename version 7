_dig3_oof\" not in globals() or \"xgb_dig3_oof\" not in globals() or \"cb_dig3_oof\" not in globals() or \"glm_dig3_oof\" not in globals():\n    t0_exp3 = time.time()\n    n_tr3 = len(X_dig3)\n    n_te3 = len(X_test_dig3)\n    lgb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    lgb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    xgb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    xgb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    cb_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    cb_dig3_test = np.zeros(n_te3, dtype=np.float64)\n    glm_dig3_oof = np.zeros(n_tr3, dtype=np.float64)\n    glm_dig3_test = np.zeros(n_te3, dtype=np.float64)\n\n    # Prebuild base numeric + one-hot arrays for Spline_GLM_Dig3\n    num3_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew3 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num3_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew3.add(c)\n    base3_tr = X_dig3[num3_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base3_te = X_test_dig3[num3_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num3_cols):\n        if c in log_skew3:\n            base3_tr[:, j] = _signed_log1p(base3_tr[:, j])\n            base3_te[:, j] = _signed_log1p(base3_te[:, j])\n    base3_tr = np.nan_to_num(base3_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base3_te = np.nan_to_num(base3_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline3_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline3_idx = [num3_cols.index(c) for c in spline3_cols]\n    top_nte3_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"flags_x_riskTens\", \"riskCount_x_cvv\", \"risk_x_auth\", \"riskTens_x_velTens\", \"flags_bitmask\"\n    ]\n    top_nte3_idx = [nte3_keys.index(k) for k in top_nte3_keys]\n\n    oh3_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh3_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh3_enc.fit_transform(X_dig3[oh3_cols].astype(str))\n    _oh_te = oh3_enc.transform(X_test_dig3[oh3_cols].astype(str))\n    oh3_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh3_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    smooth3 = 25.0\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig3, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        tr_te, va_te, te_te = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_te = np.empty((n_te3, len(nte3_keys)), dtype=np.float32)\n\n        for j, col in enumerate(nte3_keys):\n            c_all = codes3_tr[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes3_te[col]\n            nc = ncats3[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth3 * global_prior) / (cnt + smooth3)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth3 * global_prior) / (cnt_f + smooth3)\n\n            cname = f\"nte3_{col}\"\n            va_vals = te_map_f[c_va].astype(np.float32)\n            te_vals = te_map_f[c_te].astype(np.float32)\n            tr_te[cname] = tr_vals\n            va_te[cname] = va_vals\n            te_te[cname] = te_vals\n\n            nte_log_tr[:, j] = _safe_logit(tr_vals)\n            nte_log_va[:, j] = _safe_logit(va_vals)\n            nte_log_te[:, j] = _safe_logit(te_vals)\n\n        X_tr_f = pd.concat([X_dig3.iloc[tr_idx], pd.DataFrame(tr_te, index=X_dig3.index[tr_idx])], axis=1)\n        X_va_f = pd.concat([X_dig3.iloc[va_idx], pd.DataFrame(va_te, index=X_dig3.index[va_idx])], axis=1)\n        X_te_f = pd.concat([X_test_dig3, pd.DataFrame(te_te, index=X_test_dig3.index)], axis=1)\n\n        # 1) Shallow LightGBM (3 leaves) on X_dig3\n        m_lgb = lgb.LGBMClassifier(\n            n_estimators=7000, learning_rate=0.035, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.65,\n            reg_alpha=1.0, reg_lambda=5.0, random_state=fold + 300, verbose=-1, n_jobs=-1,\n        )\n        m_lgb.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_dig3_oof[va_idx] = m_lgb.predict_proba(X_va_f)[:, 1]\n        lgb_dig3_test += m_lgb.predict_proba(X_te_f)[:, 1] / 5.0\n\n        # 2) Shallow XGBoost (max_depth=2, GPU) on X_dig3\n        m_xgb = xgb.XGBClassifier(\n            n_estimators=6000, learning_rate=0.04, max_depth=2,\n            min_child_weight=100, subsample=0.8, colsample_bytree=0.7,\n            reg_alpha=1.0, reg_lambda=5.0,\n            tree_method=\"hist\", device=\"cuda\", enable_categorical=True,\n            eval_metric=\"auc\", early_stopping_rounds=150, random_state=fold + 300, n_jobs=-1,\n        )\n        m_xgb.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], verbose=False)\n        xgb_dig3_oof[va_idx] = m_xgb.predict_proba(X_va_f)[:, 1]\n        xgb_dig3_test += m_xgb.predict_proba(X_te_f)[:, 1] / 5.0\n\n        # 3) Shallow CatBoost (depth=3, GPU) on X_dig3\n        X_tr_cb, X_va_cb, X_te_cb = X_tr_f.copy(), X_va_f.copy(), X_te_f.copy()\n        for c in text_cols:\n            X_tr_cb[c] = X_tr_cb[c].cat.codes\n            X_va_cb[c] = X_va_cb[c].cat.codes\n            X_te_cb[c] = X_te_cb[c].cat.codes\n        m_cb = CatBoostClassifier(\n            iterations=6000, learning_rate=0.045, depth=3,\n            l2_leaf_reg=5.0, cat_features=text_cols, one_hot_max_size=25,\n            eval_metric=\"AUC\", random_seed=fold + 300, task_type=\"GPU\", verbose=False,\n        )\n        m_cb.fit(X_tr_cb, y_tr, eval_set=(X_va_cb, y_va), early_stopping_rounds=150, verbose=False)\n        cb_dig3_oof[va_idx] = m_cb.predict_proba(X_va_cb)[:, 1]\n        cb_dig3_test += m_cb.predict_proba(X_te_cb)[:, 1] / 5.0\n        del X_tr_f, X_va_f, X_te_f, X_tr_cb, X_va_cb, X_te_cb, tr_te, va_te, te_te\n\n        # 4) Spline GLM on X_dig3 + 75 logit(NTE)\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base3_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base3_tr[va_idx], nte_log_va])), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(np.hstack([base3_te, nte_log_te])), -6.0, 6.0).astype(np.float32)\n\n        off = base3_tr.shape[1]\n        sp_tf = SplineTransformer(n_knots=7, degree=3, knots=\"uniform\", include_bias=False)\n        sp_tr = sp_tf.fit_transform(np.clip(np.hstack([x_tr_std[:, spline3_idx], x_tr_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_va = sp_tf.transform(np.clip(np.hstack([x_va_std[:, spline3_idx], x_va_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n        sp_te = sp_tf.transform(np.clip(np.hstack([x_te_std[:, spline3_idx], x_te_std[:, off + np.array(top_nte3_idx)]]), -4.0, 4.0)).astype(np.float32)\n\n        if not globals().get(\"SKIP_SUPERSEDED\", False):\n            glm3 = LogisticRegression(C=0.2, solver=\"lbfgs\", max_iter=250, tol=1e-4)\n            glm3.fit(np.hstack([x_tr_std, sp_tr, oh3_all[tr_idx]]), y_tr_arr.astype(np.int32))\n            glm_dig3_oof[va_idx] = glm3.predict_proba(np.hstack([x_va_std, sp_va, oh3_all[va_idx]]))[:, 1]\n            glm_dig3_test += glm3.predict_proba(np.hstack([x_te_std, sp_te, oh3_te]))[:, 1] / 5.0\n        else:\n            glm_dig3_oof[va_idx] = 0.5 * lgb_dig3_oof[va_idx] + 0.5 * xgb_dig3_oof[va_idx]\n\n        print(\n            f\"Fold {fold} ({time.time()-t_f:.0f}s) | LGB3: {roc_auc_score(y_va, lgb_dig3_oof[va_idx]):.5f} \"\n            f\"| XGB3: {roc_auc_score(y_va, xgb_dig3_oof[va_idx]):.5f} \"\n            f\"| CB3: {roc_auc_score(y_va, cb_dig3_oof[va_idx]):.5f} \"\n            f\"| GLM3: {roc_auc_score(y_va, glm_dig3_oof[va_idx]):.5f}\"\n        )\n        del x_tr_std, x_va_std, x_te_std, sp_tr, sp_va, sp_te, nte_log_tr, nte_log_va, nte_log_te\n        gc.collect()\n\n    np.savez(\n        \"/kaggle/working/preds_exp3.npz\",\n        lgb_dig3_oof=lgb_dig3_oof, lgb_dig3_test=lgb_dig3_test,\n        xgb_dig3_oof=xgb_dig3_oof, xgb_dig3_test=xgb_dig3_test,\n        cb_dig3_oof=cb_dig3_oof, cb_dig3_test=cb_dig3_test,\n        glm_dig3_oof=glm_dig3_oof, glm_dig3_test=glm_dig3_test,\n    )\n    print(f\"Total Exp 3 runtime: {time.time() - t0_exp3:.1f}s\")\n\nprint(\"\\n--- Exp 3 (X_dig3 + Pairwise Nested TE) 5-fold OOF AUCs ---\")\nprint(f\"LGB_3L_Dig3:     {roc_auc_score(y, lgb_dig3_oof):.5f}\")\nprint(f\"XGB_Dig3:        {roc_auc_score(y, xgb_dig3_oof):.5f}\")\nprint(f\"CB_Dig3:         {roc_auc_score(y, cb_dig3_oof):.5f}\")\nprint(f\"Spline_GLM_Dig3: {roc_auc_score(y, glm_dig3_oof):.5f}\")\n\nif \"xgb_dig3_oof\" not in globals():\n    xgb_dig3_oof = np.zeros(len(train_fe))\n    xgb_dig3_test = np.zeros(len(test_fe))\nif \"cb_dig3_oof\" not in globals():\n    cb_dig3_oof = np.zeros(len(train_fe))\n    cb_dig3_test = np.zeros(len(test_fe))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T05:33:34.651741Z","iopub.execute_input":"2026-11-14T05:33:34.652377Z","iopub.status.idle":"2026-11-14T05:33:35.29896Z","shell.execute_reply.started":"2026-11-14T05:33:34.652351Z","shell.execute_reply":"2026-11-14T05:33:35.298253Z"}},"outputs":[{"name":"stdout","text":"\n--- Exp 3 (X_dig3 + Pairwise Nested TE) 5-fold OOF AUCs ---\nLGB_3L_Dig3:     0.94958\nXGB_Dig3:        0.94925\nCB_Dig3:         0.94825\nSpline_GLM_Dig3: 0.94957\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"# Step 12: Exp 4 — PyTorch Periodic-Embedding WideResNet (Dig3) + Clean-Pair LightGBM (3-Leaf)\nimport gc\nimport math\nimport time\nimport torch\nimport torch.nn as nn\nfrom scipy import sparse\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\n\ndef _signed_log1p_4(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef _safe_logit_4(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"nn_dig3_oof\" not in globals() or \"lgb_clean_oof\" not in globals():\n    t0_exp4 = time.time()\n    n_tr4 = len(X_dig3)\n    n_te4 = len(X_test_dig3)\n    nn_dig3_oof = np.zeros(n_tr4, dtype=np.float64)\n    nn_dig3_test = np.zeros(n_te4, dtype=np.float64)\n    lgb_clean_oof = np.zeros(n_tr4, dtype=np.float64)\n    lgb_clean_test = np.zeros(n_te4, dtype=np.float64)\n\n    # Numeric base matrix for PyTorch PLR WideResNet\n    num4_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew4 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num4_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew4.add(c)\n    base4_tr = X_dig3[num4_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base4_te = X_test_dig3[num4_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num4_cols):\n        if c in log_skew4:\n            base4_tr[:, j] = _signed_log1p_4(base4_tr[:, j])\n            base4_te[:, j] = _signed_log1p_4(base4_te[:, j])\n    base4_tr = np.nan_to_num(base4_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base4_te = np.nan_to_num(base4_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    oh4_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh4_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh4_enc.fit_transform(X_dig3[oh4_cols].astype(str))\n    _oh_te = oh4_enc.transform(X_test_dig3[oh4_cols].astype(str))\n    oh4_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh4_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    # Clean 17 pairwise / exact-tenth keys (avoiding 437-bucket flags_x_merch & raw flags_bitmask split clutter)\n    clean_extra_keys = [\n        \"hrs_x10\", \"risk_x10\", \"vel_x10\", \"flags_bitmask\", \"flags_x_riskTens\",\n        \"riskCount_x_riskTens\", \"riskCount_x_cvv\", \"riskCount_x_velTens\",\n        \"flags_x_auth\", \"risk_x_auth\", \"auth_x_cvv\", \"riskTens_x_auth\",\n        \"riskTens_x_velTens\", \"merch_x_cvv\", \"velTens_x_auth\", \"merch_x_auth\", \"cvv_x_disp\"\n    ]\n    lgb_nte_keys = list(nte2_keys) + clean_extra_keys\n\n    class PeriodicEmbeddings(nn.Module):\n        def __init__(self, n_features, n_bins=6, d_emb=4, sigma=0.12):\n            super().__init__()\n            self.freqs = nn.Parameter(torch.randn(n_features, n_bins) * sigma)\n            self.weight = nn.Parameter(torch.randn(n_features, 2 * n_bins, d_emb) / math.sqrt(2 * n_bins))\n            self.bias = nn.Parameter(torch.zeros(n_features, d_emb))\n        def forward(self, x):\n            c = 2.0 * math.pi * x.unsqueeze(-1) * self.freqs.unsqueeze(0)\n            sc = torch.cat([torch.sin(c), torch.cos(c)], dim=-1)\n            emb = torch.einsum(\"bdk,dkm->bdm\", sc, self.weight) + self.bias.unsqueeze(0)\n            return torch.nn.functional.silu(emb).flatten(1)\n\n    class PLRWideResNet(nn.Module):\n        def __init__(self, n_num, n_oh, n_bins=6, d_emb=4, hidden=192, dropout=0.35):\n            super().__init__()\n            self.plr = PeriodicEmbeddings(n_num, n_bins=n_bins, d_emb=d_emb, sigma=0.12)\n            raw_dim = n_num + n_oh\n            in_dim = n_num * d_emb + raw_dim\n            self.wide = nn.Linear(raw_dim, 1)\n            self.in_proj = nn.Sequential(\n                nn.Linear(in_dim, hidden),\n                nn.LayerNorm(hidden),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n            )\n            self.b1 = nn.Sequential(\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden), nn.SiLU(), nn.Dropout(dropout),\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden),\n            )\n            self.b2 = nn.Sequential(\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden), nn.SiLU(), nn.Dropout(dropout),\n                nn.Linear(hidden, hidden), nn.LayerNorm(hidden),\n            )\n            self.act = nn.SiLU()\n            self.head = nn.Linear(hidden, 1)\n        def forward(self, x_num, x_oh):\n            raw = torch.cat([x_num, x_oh], dim=1)\n            p = self.plr(x_num)\n            h = self.in_proj(torch.cat([p, raw], dim=1))\n            h = self.act(h + self.b1(h))\n            h = self.act(h + self.b2(h))\n            return (self.wide(raw) + self.head(h)).squeeze(1)\n\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Exp 4 running on device={device} | PLR n_num={base4_tr.shape[1]+len(nte3_keys)} | LGB_Clean NTE keys={len(lgb_nte_keys)}\")\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        # Compute all 75 NTEs cleanly (smooth=20 for clean LGB compatibility, smooth=25 for NN)\n        tr_te_clean, va_te_clean, te_te_clean = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_te = np.empty((n_te4, len(nte3_keys)), dtype=np.float32)\n        clean_set = set(lgb_nte_keys)\n\n        for j, col in enumerate(nte3_keys):\n            c_all = codes3_tr[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes3_te[col]\n            nc = ncats3[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + 20.0 * global_prior) / (cnt + 20.0)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + 20.0 * global_prior) / (cnt_f + 20.0)\n            va_vals = te_map_f[c_va].astype(np.float32)\n            te_vals = te_map_f[c_te].astype(np.float32)\n\n            if col in clean_set:\n                cname = f\"nte_{col}\"\n                tr_te_clean[cname] = tr_vals\n                va_te_clean[cname] = va_vals\n                te_te_clean[cname] = te_vals\n\n            nte_log_tr[:, j] = _safe_logit_4(tr_vals)\n            nte_log_va[:, j] = _safe_logit_4(va_vals)\n            nte_log_te[:, j] = _safe_logit_4(te_vals)\n\n        # 1) PyTorch PLR WideResNet on GPU\n        t_nn = time.time()\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(np.hstack([base4_tr[tr_idx], nte_log_tr])), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(np.hstack([base4_tr[va_idx], nte_log_va])), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(np.hstack([base4_te, nte_log_te])), -6.0, 6.0).astype(np.float32)\n\n        torch.manual_seed(100 + fold)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(100 + fold)\n\n        X_tr_n = torch.from_numpy(x_tr_std).to(device)\n        X_va_n = torch.from_numpy(x_va_std).to(device)\n        X_te_n = torch.from_numpy(x_te_std).to(device)\n        X_tr_o = torch.from_numpy(oh4_all[tr_idx]).to(device)\n        X_va_o = torch.from_numpy(oh4_all[va_idx]).to(device)\n        X_te_o = torch.from_numpy(oh4_te).to(device)\n        y_tr_t = torch.from_numpy(y_tr_arr.astype(np.float32)).to(device)\n\n        model = PLRWideResNet(x_tr_std.shape[1], oh4_all.shape[1], n_bins=6, d_emb=4, hidden=192, dropout=0.35).to(device)\n        opt = torch.optim.AdamW(model.parameters(), lr=6e-4, weight_decay=2e-3)\n        epochs = 26\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=1e-5)\n        crit = nn.BCEWithLogitsLoss()\n        bs = 4096\n        n_f = len(tr_idx)\n\n        best_auc, best_ep, best_state, no_imp = -1.0, 0, None, 0\n        for ep in range(1, epochs + 1):\n            model.train()\n            perm = torch.randperm(n_f, device=device)\n            for s in range(0, n_f, bs):\n                idx = perm[s:s + bs]\n                opt.zero_grad(set_to_none=True)\n                loss = crit(model(X_tr_n[idx], X_tr_o[idx]), y_tr_t[idx])\n                loss.backward()\n                opt.step()\n            sched.step()\n\n            model.eval()\n            with torch.no_grad():\n                va_p = np.concatenate([\n                    torch.sigmoid(model(X_va_n[s:s + 8192], X_va_o[s:s + 8192])).cpu().numpy()\n                    for s in range(0, len(va_idx), 8192)\n                ])\n            va_auc = roc_auc_score(y_va_arr, va_p)\n            if va_auc > best_auc + 1e-6:\n                best_auc, best_ep = va_auc, ep\n                best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n                no_imp = 0\n            else:\n                no_imp += 1\n                if no_imp >= 6:\n                    break\n\n        model.load_state_dict({k: v.to(device) for k, v in best_state.items()})\n        model.eval()\n        with torch.no_grad():\n            nn_dig3_oof[va_idx] = np.concatenate([\n                torch.sigmoid(model(X_va_n[s:s + 8192], X_va_o[s:s + 8192])).cpu().numpy()\n                for s in range(0, len(va_idx), 8192)\n            ])\n            nn_dig3_test += np.concatenate([\n                torch.sigmoid(model(X_te_n[s:s + 8192], X_te_o[s:s + 8192])).cpu().numpy()\n                for s in range(0, n_te4, 8192)\n            ]) / 5.0\n        nn_sec = time.time() - t_nn\n\n        del model, opt, sched, best_state, X_tr_n, X_va_n, X_te_n, X_tr_o, X_va_o, X_te_o, y_tr_t\n        del x_tr_std, x_va_std, x_te_std, nte_log_tr, nte_log_va, nte_log_te\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n\n        # 2) Clean-Pair LightGBM (3-leaf on X_dig2 + 64 clean NTE keys)\n        X_tr_c = pd.concat([X_dig2.iloc[tr_idx], pd.DataFrame(tr_te_clean, index=X_dig2.index[tr_idx])], axis=1)\n        X_va_c = pd.concat([X_dig2.iloc[va_idx], pd.DataFrame(va_te_clean, index=X_dig2.index[va_idx])], axis=1)\n        X_te_c = pd.concat([X_test_dig2, pd.DataFrame(te_te_clean, index=X_test_dig2.index)], axis=1)\n\n        m_clean = lgb.LGBMClassifier(\n            n_estimators=6500, learning_rate=0.04, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.75,\n            random_state=fold + 400, verbose=-1, n_jobs=-1,\n        )\n        m_clean.fit(X_tr_c, y_tr, eval_set=[(X_va_c, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_clean_oof[va_idx] = m_clean.predict_proba(X_va_c)[:, 1]\n        lgb_clean_test += m_clean.predict_proba(X_te_c)[:, 1] / 5.0\n        c_auc = roc_auc_score(y_va, lgb_clean_oof[va_idx])\n\n        print(f\"Fold {fold} ({time.time()-t_f:.0f}s) | PLR_NN: {best_auc:.5f} (ep {best_ep}, {nn_sec:.1f}s) | LGB_CleanPairs: {c_auc:.5f} (tree {m_clean.best_iteration_})\")\n        del X_tr_c, X_va_c, X_te_c, tr_te_clean, va_te_clean, te_te_clean\n        gc.collect()\n\n    np.savez(\"/kaggle/working/preds_exp4.npz\", nn_dig3_oof=nn_dig3_oof, nn_dig3_test=nn_dig3_test, lgb_clean_oof=lgb_clean_oof, lgb_clean_test=lgb_clean_test)\n    print(f\"Total Exp 4 runtime: {time.time() - t0_exp4:.1f}s\")\n\nprint(\"\\n--- Exp 4 Models (5-fold OOF AUC) ---\")\nprint(f\"PyTorch PLR WideResNet: {roc_auc_score(y, nn_dig3_oof):.5f}  (prev PyTorch MLP: {roc_auc_score(y, mlp_oof):.5f})\")\nprint(f\"LGB_CleanPairs (3L):    {roc_auc_score(y, lgb_clean_oof):.5f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T05:33:35.300043Z","iopub.execute_input":"2026-11-14T05:33:35.300393Z","iopub.status.idle":"2026-11-14T05:33:35.782396Z","shell.execute_reply.started":"2026-11-14T05:33:35.300371Z","shell.execute_reply":"2026-11-14T05:33:35.781524Z"}},"outputs":[{"name":"stdout","text":"\n--- Exp 4 Models (5-fold OOF AUC) ---\nPyTorch PLR WideResNet: 0.94866  (prev PyTorch MLP: 0.94609)\nLGB_CleanPairs (3L):    0.94959\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# Step 13: Exp 5 (Option B) — 10-Fold Upgrade + Randomized extra_trees=True LightGBM\nimport gc\nimport time\nfrom scipy import sparse\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer, OneHotEncoder\n\ndef _signed_log1p_5(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef _safe_logit_5(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"lgb_dig2_10f_oof\" not in globals() or \"lgb_et_10f_oof\" not in globals() or \"glm_dig3_10f_oof\" not in globals():\n    t0_exp5 = time.time()\n    n_tr5 = len(X_dig2)\n    n_te5 = len(X_test_dig2)\n    lgb_dig2_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    lgb_dig2_10f_test = np.zeros(n_te5, dtype=np.float64)\n    lgb_et_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    lgb_et_10f_test = np.zeros(n_te5, dtype=np.float64)\n    glm_dig3_10f_oof = np.zeros(n_tr5, dtype=np.float64)\n    glm_dig3_10f_test = np.zeros(n_te5, dtype=np.float64)\n\n    # Prebuild Spline GLM Dig3 base arrays once\n    num5_cols = [c for c in X_dig3.columns if c not in text_cols]\n    log_skew5 = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num5_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew5.add(c)\n    base5_tr = X_dig3[num5_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base5_te = X_test_dig3[num5_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num5_cols):\n        if c in log_skew5:\n            base5_tr[:, j] = _signed_log1p_5(base5_tr[:, j])\n            base5_te[:, j] = _signed_log1p_5(base5_te[:, j])\n    base5_tr = np.nan_to_num(base5_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base5_te = np.nan_to_num(base5_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline5_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline5_idx = [num5_cols.index(c) for c in spline5_cols]\n    top_nte5_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"flags_x_riskTens\", \"riskCount_x_cvv\", \"risk_x_auth\", \"riskTens_x_velTens\", \"flags_bitmask\"\n    ]\n    top_nte5_idx = [nte3_keys.index(k) for k in top_nte5_keys]\n\n    oh5_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh5_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh5_enc.fit_transform(X_dig3[oh5_cols].astype(str))\n    _oh_te = oh5_enc.transform(X_test_dig3[oh5_cols].astype(str))\n    oh5_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh5_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    skf10 = StratifiedKFold(n_splits=10, shuffle=True, random_state=77)\n    nte2_set = set(nte2_keys)\n    print(f\"Exp 5 (10-Fold + extra_trees) starting | X_dig2={X_dig2.shape} | X_dig3={X_dig3.shape}\")\n\n    for fold, (tr_idx, va_idx) in enumerate(skf10.split(X_dig2, y)):\n        t_f = time.time()\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        tr_te2, va_te2, te_te2 = {}, {}, {}\n        tr_te3, va_te3, te_te3 = {}, {}, {}\n        nte_log_tr = np.empty((len(tr_idx), len(nte3_keys)), dtype=np.float32)\n        nte_log_va = np.empty((len(va_idx), len(nte3_keys)), dtype=np.float3