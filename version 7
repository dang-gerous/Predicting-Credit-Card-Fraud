\n    return out\n\nif \"X_dig2\" not in globals():\n    X_dig2 = add_finer_digits(X_dig)\n    X_test_dig2 = add_finer_digits(X_test_dig)\n\n    # Frequency encoding on key columns (train+test value counts, zero label leakage)\n    n_tr = len(X_dig2)\n    freq_cols = [\n        \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"account_balance_usd_cents\",\n        \"amount_usd_int\", \"hours_since_last_txn_int\", \"distance_from_home_km_int\",\n        \"customer_age\", \"card_age_months\", \"merchant_risk_score_int\", \"velocity_score_int\"\n    ]\n    for col in freq_cols:\n        comb = pd.concat([X_dig2[col], X_test_dig2[col]], ignore_index=True)\n        vc = comb.value_counts()\n        X_dig2[f\"{col}_freq\"] = X_dig2[col].map(vc).astype(np.float32)\n        X_test_dig2[f\"{col}_freq\"] = X_test_dig2[col].map(vc).astype(np.float32)\n\n    # Pre-factorize all discrete & digit keys for ultra-fast np.bincount Nested TE\nnte2_keys = [\n    \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\",\n    \"time_of_day_hour\", \"day_of_week\", \"cvv_retry_count\", \"prior_disputes\",\n    \"customer_age\", \"card_age_months\", \"txn_count_last_24h\",\n    \"amount_usd_cents\", \"amount_usd_tenth\", \"amount_usd_hundredth\", \"amount_usd_ones\", \"amount_usd_tens\", \"amount_usd_int\", \"amount_usd_div10\", \"amount_usd_div100\", \"amount_usd_first_digit\",\n    \"hours_since_last_txn_cents\", \"hours_since_last_txn_ones\", \"hours_since_last_txn_tens\", \"hours_since_last_txn_int\", \"hours_since_last_txn_first_digit\",\n    \"distance_from_home_km_cents\", \"distance_from_home_km_ones\", \"distance_from_home_km_tens\", \"distance_from_home_km_div10\", \"distance_from_home_km_first_digit\",\n    \"account_balance_usd_cents\", \"account_balance_usd_ones\", \"account_balance_usd_tens\", \"account_balance_usd_div10\", \"account_balance_usd_div100\", \"account_balance_usd_first_digit\",\n    \"velocity_score_cents\", \"velocity_score_ones\", \"velocity_score_tens\", \"velocity_score_int\", \"velocity_score_first_digit\",\n    \"merchant_risk_score_cents\", \"merchant_risk_score_ones\", \"merchant_risk_score_tens\", \"merchant_risk_score_int\", \"merchant_risk_score_first_digit\",\n]\n\nn_tr = len(X_dig2)\nif \"codes_tr_dict\" not in globals():\n    codes_tr_dict, codes_te_dict, ncats_dict = {}, {}, {}\n    for col in nte2_keys:\n        comb = pd.concat([X_dig2[col].astype(str), X_test_dig2[col].astype(str)], ignore_index=True)\n        codes, _ = pd.factorize(comb, sort=False)\n        codes_tr_dict[col] = codes[:n_tr]\n        codes_te_dict[col] = codes[n_tr:]\n        ncats_dict[col] = int(codes.max()) + 1\n\ninner_skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nsmooth = 20.0\ny_arr = y.values.astype(np.float64)\n\nif \"lgb_dig2_oof\" not in globals() and not globals().get(\"SKIP_SUPERSEDED\", False):\n    lgb_stump_oof = np.zeros(n_tr)\n    lgb_stump_test = np.zeros(len(X_test_dig2))\n    lgb_dig2_oof = np.zeros(n_tr)\n    lgb_dig2_test = np.zeros(len(X_test_dig2))\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]\n        y_tr_arr = y_arr[tr_idx]\n        global_prior = y_tr_arr.mean()\n\n        tr_te, va_te, te_te = {}, {}, {}\n        inner_splits = list(inner_skf.split(tr_idx, y_tr))\n\n        for col in nte2_keys:\n            c_all_tr = codes_tr_dict[col]\n            c_tr = c_all_tr[tr_idx]\n            c_va = c_all_tr[va_idx]\n            c_te = codes_te_dict[col]\n            nc = ncats_dict[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth * global_prior) / (cnt + smooth)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth * global_prior) / (cnt_f + smooth)\n\n            col_name = f\"nte2_{col}\"\n            tr_te[col_name] = tr_vals\n            va_te[col_name] = te_map_f[c_va].astype(np.float32)\n            te_te[col_name] = te_map_f[c_te].astype(np.float32)\n\n        X_tr_f = pd.concat([X_dig2.iloc[tr_idx], pd.DataFrame(tr_te, index=X_dig2.index[tr_idx])], axis=1)\n        X_va_f = pd.concat([X_dig2.iloc[va_idx], pd.DataFrame(va_te, index=X_dig2.index[va_idx])], axis=1)\n        X_te_f = pd.concat([X_test_dig2, pd.DataFrame(te_te, index=X_test_dig2.index)], axis=1)\n\n        # Model A: 2-leaf decision stumps (pure additive GAM, zero interaction overfitting)\n        m_stump = lgb.LGBMClassifier(\n            n_estimators=8000, learning_rate=0.05, num_leaves=2, max_depth=1,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.8,\n            random_state=fold, verbose=-1, n_jobs=-1,\n        )\n        m_stump.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_stump_oof[va_idx] = m_stump.predict_proba(X_va_f)[:, 1]\n        lgb_stump_test += m_stump.predict_proba(X_te_f)[:, 1] / 5\n\n        # Model B: 3-leaf shallow trees on upgraded features\n        m_dig2 = lgb.LGBMClassifier(\n            n_estimators=6000, learning_rate=0.04, num_leaves=3, max_depth=2,\n            min_child_samples=100, subsample=0.8, subsample_freq=1, colsample_bytree=0.7,\n            random_state=fold + 100, verbose=-1, n_jobs=-1,\n        )\n        m_dig2.fit(X_tr_f, y_tr, eval_set=[(X_va_f, y_va)], eval_metric=\"auc\", callbacks=[lgb.early_stopping(150, verbose=False)])\n        lgb_dig2_oof[va_idx] = m_dig2.predict_proba(X_va_f)[:, 1]\n        lgb_dig2_test += m_dig2.predict_proba(X_te_f)[:, 1] / 5\n\n        print(f\"Fold {fold} | 2-Leaf Stump: {roc_auc_score(y_va, lgb_stump_oof[va_idx]):.5f} (tree {m_stump.best_iteration_}) | 3-Leaf Dig2: {roc_auc_score(y_va, lgb_dig2_oof[va_idx]):.5f} (tree {m_dig2.best_iteration_})\")\n\nif \"lgb_dig2_oof\" not in globals():\n    lgb_stump_oof = np.zeros(len(X_dig2))\n    lgb_stump_test = np.zeros(len(X_test_dig2))\n    lgb_dig2_oof = np.zeros(len(X_dig2))\n    lgb_dig2_test = np.zeros(len(X_test_dig2))\nprint(\"X_dig2 ready:\", X_dig2.shape, \"| nte2_keys:\", len(nte2_keys))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T05:33:34.427662Z","iopub.execute_input":"2026-11-14T05:33:34.427941Z","iopub.status.idle":"2026-11-14T05:33:34.456175Z","shell.execute_reply.started":"2026-11-14T05:33:34.427913Z","shell.execute_reply":"2026-11-14T05:33:34.455359Z"}},"outputs":[{"name":"stdout","text":"X_dig2 ready: (699960, 127) | nte2_keys: 47\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"# Step 10: Option 2 — Spline GLM + PyTorch GPU Residual MLP on X_dig2 + 47-Key Nested TE\nimport gc\nimport time\nimport torch\nimport torch.nn as nn\nfrom scipy import sparse\nfrom sklearn.preprocessing import StandardScaler, SplineTransformer, OneHotEncoder\n\ndef signed_log1p(arr):\n    return np.sign(arr) * np.log1p(np.abs(arr))\n\ndef safe_logit(p, eps=1e-4):\n    p = np.clip(p, eps, 1.0 - eps)\n    return np.log(p / (1.0 - p))\n\nif \"glm_oof\" not in globals() or \"mlp_oof\" not in globals():\n    t0_all = time.time()\n    n_tr = len(X_dig2)\n    n_te = len(X_test_dig2)\n    glm_oof = np.zeros(n_tr, dtype=np.float64)\n    glm_test = np.zeros(n_te, dtype=np.float64)\n    mlp_oof = np.zeros(n_tr, dtype=np.float64)\n    mlp_test = np.zeros(n_te, dtype=np.float64)\n\n    num_cols = [c for c in X_dig2.columns if c not in text_cols]\n    log_skew_cols = set([\n        \"amount_usd\", \"hours_since_last_txn\", \"distance_from_home_km\",\n        \"account_balance_usd\", \"amount_to_balance\", \"balance_after_txn\",\n        \"txn_burst_rate\", \"amount_x_merchant_risk\", \"txn_count_last_24h\"\n    ])\n    for c in num_cols:\n        if c.endswith((\"_int\", \"_div10\", \"_div100\", \"_freq\")):\n            log_skew_cols.add(c)\n\n    # Pre-build signed-log1p numeric base matrices once (float32)\n    base_tr = X_dig2[num_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    base_te = X_test_dig2[num_cols].to_numpy(dtype=np.float32, na_value=0.0).copy()\n    for j, c in enumerate(num_cols):\n        if c in log_skew_cols:\n            base_tr[:, j] = signed_log1p(base_tr[:, j])\n            base_te[:, j] = signed_log1p(base_te[:, j])\n    base_tr = np.nan_to_num(base_tr, nan=0.0, posinf=0.0, neginf=0.0)\n    base_te = np.nan_to_num(base_te, nan=0.0, posinf=0.0, neginf=0.0)\n\n    spline_base_cols = [\n        \"amount_usd_log1p\", \"hours_since_last_txn_log1p\",\n        \"distance_from_home_km_log1p\", \"account_balance_usd_log1p\",\n        \"velocity_score\", \"merchant_risk_score\",\n        \"customer_age\", \"card_age_months\",\n        \"amount_to_balance\", \"balance_after_txn\", \"txn_burst_rate\", \"amount_x_merchant_risk\"\n    ]\n    spline_base_idx = [num_cols.index(c) for c in spline_base_cols]\n\n    oh_cols = list(text_cols) + [\"time_of_day_hour\", \"day_of_week\"]\n    oh_enc = OneHotEncoder(handle_unknown=\"ignore\")\n    _oh_tr = oh_enc.fit_transform(X_dig2[oh_cols].astype(str))\n    _oh_te = oh_enc.transform(X_test_dig2[oh_cols].astype(str))\n    oh_all = (_oh_tr.toarray() if sparse.issparse(_oh_tr) else _oh_tr).astype(np.float32)\n    oh_te = (_oh_te.toarray() if sparse.issparse(_oh_te) else _oh_te).astype(np.float32)\n    del _oh_tr, _oh_te\n\n    emb_cols = [\n        \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\",\n        \"time_of_day_hour\", \"day_of_week\", \"cvv_retry_count\", \"prior_disputes\",\n        \"amount_usd_cents\", \"hours_since_last_txn_cents\", \"account_balance_usd_cents\",\n        \"velocity_score_cents\", \"merchant_risk_score_cents\",\n        \"amount_usd_first_digit\", \"hours_since_last_txn_first_digit\", \"distance_from_home_km_first_digit\"\n    ]\n    emb_ncats = [ncats_dict[c] for c in emb_cols]\n    X_cat_all = np.column_stack([np.clip(codes_tr_dict[c], 0, ncats_dict[c] - 1) for c in emb_cols]).astype(np.int64)\n    X_cat_te = np.column_stack([np.clip(codes_te_dict[c], 0, ncats_dict[c] - 1) for c in emb_cols]).astype(np.int64)\n\n    top_nte_spline_keys = [\n        \"merchant_category\", \"amount_usd_cents\", \"hours_since_last_txn_cents\",\n        \"account_balance_usd_cents\", \"velocity_score_cents\", \"merchant_risk_score_cents\"\n    ]\n    top_nte_idx = [nte2_keys.index(k) for k in top_nte_spline_keys]\n\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Option 2 running on device={device} | base_num={base_tr.shape[1]} | emb={len(emb_cols)} | oh={oh_all.shape[1]}\")\n\n    class ResBlock(nn.Module):\n        def __init__(self, dim, dropout=0.25):\n            super().__init__()\n            self.block = nn.Sequential(\n                nn.BatchNorm1d(dim),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n                nn.Linear(dim, dim),\n                nn.BatchNorm1d(dim),\n                nn.SiLU(),\n                nn.Dropout(dropout),\n                nn.Linear(dim, dim),\n            )\n        def forward(self, x):\n            return x + self.block(x)\n\n    class FraudResNet(nn.Module):\n        def __init__(self, num_dim, card_sizes, hidden=256, dropout=0.25):\n            super().__init__()\n            self.embs = nn.ModuleList([\n                nn.Embedding(nc + 1, min(16, max(4, (nc + 1) // 2))) for nc in card_sizes\n            ])\n            emb_dim = sum(e.embedding_dim for e in self.embs)\n            in_dim = num_dim + emb_dim\n            self.skip = nn.Linear(in_dim, 1)\n            self.in_proj = nn.Sequential(\n                nn.Linear(in_dim, hidden),\n                nn.BatchNorm1d(hidden),\n                nn.SiLU(),\n                nn.Dropout(0.15),\n            )\n            self.res1 = ResBlock(hidden, dropout)\n            self.res2 = ResBlock(hidden, dropout)\n            self.head = nn.Sequential(\n                nn.BatchNorm1d(hidden),\n                nn.SiLU(),\n                nn.Linear(hidden, 1),\n            )\n        def forward(self, x_num, x_cat):\n            e = torch.cat([emb(x_cat[:, i]) for i, emb in enumerate(self.embs)], dim=1)\n            x = torch.cat([x_num, e], dim=1)\n            h = self.res2(self.res1(self.in_proj(x)))\n            return (self.skip(x) + self.head(h)).squeeze(1)\n\n    from sklearn.linear_model import LogisticRegression\n\n    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_dig2, y)):\n        y_tr_arr = y_arr[tr_idx]\n        y_va_arr = y_arr[va_idx]\n        global_prior = y_tr_arr.mean()\n        inner_splits = list(inner_skf.split(tr_idx, y_tr_arr.astype(np.int32)))\n\n        # Leak-free 47 logit(Nested TE) matrices for this fold\n        nte_tr = np.empty((len(tr_idx), len(nte2_keys)), dtype=np.float32)\n        nte_va = np.empty((len(va_idx), len(nte2_keys)), dtype=np.float32)\n        nte_te = np.empty((n_te, len(nte2_keys)), dtype=np.float32)\n\n        for j, col in enumerate(nte2_keys):\n            c_all = codes_tr_dict[col]\n            c_tr = c_all[tr_idx]\n            c_va = c_all[va_idx]\n            c_te = codes_te_dict[col]\n            nc = ncats_dict[col]\n\n            tr_vals = np.full(len(tr_idx), global_prior, dtype=np.float32)\n            for in_tr, in_va in inner_splits:\n                cnt = np.bincount(c_tr[in_tr], minlength=nc)\n                sm = np.bincount(c_tr[in_tr], weights=y_tr_arr[in_tr], minlength=nc)\n                te_map = (sm + smooth * global_prior) / (cnt + smooth)\n                tr_vals[in_va] = te_map[c_tr[in_va]]\n\n            cnt_f = np.bincount(c_tr, minlength=nc)\n            sm_f = np.bincount(c_tr, weights=y_tr_arr, minlength=nc)\n            te_map_f = (sm_f + smooth * global_prior) / (cnt_f + smooth)\n\n            nte_tr[:, j] = safe_logit(tr_vals)\n            nte_va[:, j] = safe_logit(te_map_f[c_va])\n            nte_te[:, j] = safe_logit(te_map_f[c_te])\n\n        # Standardize base_num + logit(NTE) inside the fold\n        raw_tr = np.hstack([base_tr[tr_idx], nte_tr])\n        raw_va = np.hstack([base_tr[va_idx], nte_va])\n        raw_te = np.hstack([base_te, nte_te])\n\n        scaler = StandardScaler()\n        x_tr_std = np.clip(scaler.fit_transform(raw_tr), -6.0, 6.0).astype(np.float32)\n        x_va_std = np.clip(scaler.transform(raw_va), -6.0, 6.0).astype(np.float32)\n        x_te_std = np.clip(scaler.transform(raw_te), -6.0, 6.0).astype(np.float32)\n\n        # --- Model 1: Spline GLM (Logistic Regression with B-splines) ---\n        t_glm = time.time()\n        sp_cols_tr = np.hstack([x_tr_std[:, spline_base_idx], x_tr_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n        sp_cols_va = np.hstack([x_va_std[:, spline_base_idx], x_va_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n        sp_cols_te = np.hstack([x_te_std[:, spline_base_idx], x_te_std[:, base_tr.shape[1] + np.array(top_nte_idx)]])\n\n        spline_tf = SplineTransformer(n_knots=7, degree=3, knots=\"uniform\", include_bias=False)\n        sp_tr = spline_tf.fit_transform(np.clip(sp_cols_tr, -4.0, 4.0)).astype(np.float32)\n        sp_va = spline_tf.transform(np.clip(sp_cols_va, -4.0, 4.0)).astype(np.float32)\n        sp_te = spline_tf.transform(np.clip(sp_cols_te, -4.0, 4.0)).astype(np.float32)\n\n        glm_tr = np.hstack([x_tr_std, sp_tr, oh_all[tr_idx]])\n        glm_va = np.hstack([x_va_std, sp_va, oh_all[va_idx]])\n        glm_te = np.hstack([x_te_std, sp_te, oh_te])\n\n        if not globals().get(\"SKIP_SUPERSEDED\", False):\n            glm = LogisticRegression(C=0.2, solver=\"lbfgs\", max_iter=250, tol=1e-4)\n            glm.fit(glm_tr, y_tr_arr.astype(np.int32))\n            glm_oof[va_idx] = glm.predict_proba(glm_va)[:, 1]\n            glm_test += glm.predict_proba(glm_te)[:, 1] / 5.0\n            glm_auc = roc_auc_score(y_va_arr, glm_oof[va_idx])\n        else:\n            glm_auc = 0.0\n        glm_sec = time.time() - t_glm\n        del sp_tr, sp_va, sp_te, glm_tr, glm_va, glm_te, sp_cols_tr, sp_cols_va, sp_cols_te, raw_tr, raw_va, raw_te\n        gc.collect()\n\n        # --- Model 2: PyTorch GPU Residual MLP ---\n        t_mlp = time.time()\n        torch.manual_seed(42 + fold)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(42 + fold)\n\n        X_tr_num_t = torch.from_numpy(x_tr_std).to(device)\n        X_va_num_t = torch.from_numpy(x_va_std).to(device)\n        X_te_num_t = torch.from_numpy(x_te_std).to(device)\n        X_tr_cat_t = torch.from_numpy(X_cat_all[tr_idx]).to(device)\n        X_va_cat_t = torch.from_numpy(X_cat_all[va_idx]).to(device)\n        X_te_cat_t = torch.from_numpy(X_cat_te).to(device)\n        y_tr_t = torch.from_numpy(y_tr_arr.astype(np.float32)).to(device)\n\n        model = FraudResNet(x_tr_std.shape[1], emb_ncats, hidden=256, dropout=0.25).to(device)\n        opt = torch.optim.AdamW(model.parameters(), lr=2e-3, weight_decay=2e-4)\n        epochs = 22\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=2e-5)\n        crit = nn.BCEWithLogitsLoss()\n        bs = 2048\n        n_f = len(tr_idx)\n\n        best_auc = -1.0\n        best_ep = 0\n        best_state = None\n        no_imp = 0\n\n        for ep in range(1, epochs + 1):\n            model.train()\n            perm = torch.randperm(n_f, device=device)\n            for s in range(0, n_f, bs):\n                idx = perm[s:s + bs]\n                opt.zero_grad(set_to_none=True)\n                logits = model(X_tr_num_t[idx], X_tr_cat_t[idx])\n                loss = crit(logits, y_tr_t[idx])\n                loss.backward()\n                opt.step()\n            sched.s